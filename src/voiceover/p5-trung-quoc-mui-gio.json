  "lines": [
    {
      "id": "01",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.06,
      "text": "Đi từ Lào Cai sang Hà Khẩu, đồng hồ nhảy một tiếng.",
      "voice": "Orus",
      "src": "voiceover/p5-trung-quoc-mui-gio/01.wav",
      "durationInSeconds": 3.257,
      "tempo": 1.1,
      "hash": "14c060edfe7c"
    },
    {
      "id": "02",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.25,
      "text": "Nhưng đi tiếp hơn ba nghìn cây số về phía tây, nó không nhảy thêm phút nào.",
      "voice": "Orus",
      "src": "voiceover/p5-trung-quoc-mui-gio/02.wav",
      "durationInSeconds": 3.908,
      "tempo": 1.1,
      "hash": "14c060edfe7c"
    },
    {
      "id": "03",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.06,
      "text": "Nếu chia theo Mặt Trời, lãnh thổ Trung Quốc trải gần năm múi giờ.",
      "voice": "Orus",
      "src": "voiceover/p5-trung-quoc-mui-gio/03.wav",
      "durationInSeconds": 3.458,
      "tempo": 1.1,
      "hash": "f0d5e1164ae8"
    },
    {
      "id": "04",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.25,
      "text": "Càng đi về tây, mặt trời mọc càng muộn.",
      "voice": "Orus",
      "src": "voiceover/p5-trung-quoc-mui-gio/04.wav",
      "durationInSeconds": 2.252,
      "tempo": 1.1,
      "hash": "f0d5e1164ae8"
    },
    {
      "id": "05",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.06,
      "text": "Vậy mà từ khoảng năm một nghìn chín trăm bốn mươi chín, cả nước dùng chung một chiếc đồng hồ: giờ Bắc Kinh.",
      "voice": "Orus",
      "src": "voiceover/p5-trung-quoc-mui-gio/05.wav",
      "durationInSeconds": 5.223,
      "tempo": 1.1,
      "hash": "0b81d4d08d61"
    },
    {
      "id": "06",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.25,
      "text": "Đây là nước rộng nhất thế giới chỉ dùng một giờ.",
      "voice": "Orus",
      "src": "voiceover/p5-trung-quoc-mui-gio/06.wav",
      "durationInSeconds": 2.416,
      "tempo": 1.1,
      "hash": "0b81d4d08d61"
    },
    {
      "id": "07",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.15,
      "text": "Hệ quả?",
      "voice": "Orus",
      "src": "voiceover/p5-trung-quoc-mui-gio/07.wav",
      "durationInSeconds": 0.716,
      "tempo": 1.1,
      "hash": "e2a37deaeaf4"
    },
    {
      "id": "08",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.12,
      "text": "Mặt trời đi trễ.",
      "voice": "Orus",
      "src": "voiceover/p5-trung-quoc-mui-gio/08.wav",
      "durationInSeconds": 1.193,
      "tempo": 1.1,
      "hash": "e2a37deaeaf4"
    },
    {
      "id": "09",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.06,
      "text": "Mùa đông ở Kashgar, gần mười giờ sáng trời mới sáng.",
      "voice": "Orus",
      "src": "voiceover/p5-trung-quoc-mui-gio/09.wav",
      "durationInSeconds": 3.66,
      "tempo": 1.1,
      "hash": "e2a37deaeaf4"
    },
    {
      "id": "10",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.06,
      "text": "Cùng lúc ấy ở Bắc Kinh, trời đã sáng từ bảy giờ rưỡi.",
      "voice": "Orus",
      "src": "voiceover/p5-trung-quoc-mui-gio/10.wav",
      "durationInSeconds": 2.943,
      "tempo": 1.1,
      "hash": "e2a37deaeaf4"
    },
    {
      "id": "11",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.25,
      "text": "Mùa hè, hơn mười giờ tối trời mới tắt nắng.",
      "voice": "Orus",
      "src": "voiceover/p5-trung-quoc-mui-gio/11.wav",
      "durationInSeconds": 2.767,
      "tempo": 1.1,
      "hash": "e2a37deaeaf4"
    },
    {
      "id": "12",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 0.25,
      "text": "Thử tưởng tượng: báo thức reo lúc bảy giờ, nhìn ra cửa sổ vẫn tưởng nửa đêm.",
      "voice": "Orus",
      "src": "voiceover/p5-trung-quoc-mui-gio/12.wav",
      "durationInSeconds": 4.692,
      "tempo": 1.1,
      "hash": "7af1cc982af5"
    },
    {
      "id": "13",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.06,
      "text": "Nên ở Tân Cương, nhiều người dùng thêm một giờ không chính thức, chậm hơn hai tiếng.",
      "voice": "Orus",
      "src": "voiceover/p5-trung-quoc-mui-gio/13.wav",
      "durationInSeconds": 4.101,
      "tempo": 1.1,
      "hash": "2511140c7e13"
    },
    {
      "id": "14",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.06,
      "text": "Năm một nghìn chín trăm tám mươi sáu, Bắc Kinh còn duyệt cho giờ này dùng trong đời thường, còn quân đội, tàu hoả, máy bay vẫn theo giờ Bắc Kinh.",
      "voice": "Orus",
      "src": "voiceover/p5-trung-quoc-mui-gio/14.wav",
      "durationInSeconds": 7.053,
      "tempo": 1.1,
      "hash": "2511140c7e13"
    },
    {
      "id": "15",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.25,
      "text": "Hẹn nhau tám giờ, nhiều khi phải hỏi lại: tám giờ nào?",
      "voice": "Orus",
      "src": "voiceover/p5-trung-quoc-mui-gio/15.wav",
      "durationInSeconds": 3.149,
      "tempo": 1.1,
      "hash": "2511140c7e13"
    },
    {
      "id": "16",
      "scene": "s7",
      "take": "t07",
      "gapAfter": 0.06,
      "text": "Nhưng chi tiết lạ nhất nằm ở biên giới với Afghanistan, nước dùng múi giờ lẻ nửa tiếng.",
      "voice": "Orus",
      "src": "voiceover/p5-trung-quoc-mui-gio/16.wav",
      "durationInSeconds": 4.97,
      "tempo": 1.1,
      "hash": "27d00e0ac6eb"
    },
    {
      "id": "17",
      "scene": "s7",
      "take": "t07",
      "gapAfter": 0.06,
      "text": "Nếu bước qua được, đồng hồ lệch tới ba tiếng rưỡi.",
      "voice": "Orus",
      "src": "voiceover/p5-trung-quoc-mui-gio/17.wav",
      "durationInSeconds": 2.952,
      "tempo": 1.1,
      "hash": "27d00e0ac6eb"
    },
    {
      "id": "18",
      "scene": "s7",
      "take": "t07",
      "gapAfter": 0.25,
      "text": "Chỉ có điều, ở đó chẳng có cửa khẩu nào để bước qua.",
      "voice": "Orus",
      "src": "voiceover/p5-trung-quoc-mui-gio/18.wav",
      "durationInSeconds": 3.28,
      "tempo": 1.1,
      "hash": "27d00e0ac6eb"
    }
  ]
