{
  "name": "p2-evn-gia-dien",
  "model": "gemini-3.8-flash-tts",
  "totalSeconds": 61.935,
  "lines": [
    {
      "id": "01",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.15,
      "text": "Cuối năm hai nghìn hai mươi tư, công ty mẹ EVN còn lỗ gần bốn mươi lăm nghìn tỷ.",
      "voice": "Orus",
      "src": "voiceover/p2-evn-gia-dien/01.wav",
      "durationInSeconds": 4.299,
      "tempo": 1.1,
      "hash": "eece1bff4a33"
    },
    {
      "id": "02",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.15,
      "text": "Bộ Công Thương đề xuất tính dần khoản lỗ ấy vào giá điện.",
      "voice": "Orus",
      "src": "voiceover/p2-evn-gia-dien/02.wav",
      "durationInSeconds": 2.3,
      "tempo": 1.1,
      "hash": "eece1bff4a33"
    },
    {
      "id": "03",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.15,
      "text": "Vậy mà một năm sau, cả tập đoàn lãi gần năm mươi hai nghìn tỷ.",
      "voice": "Orus",
      "src": "voiceover/p2-evn-gia-dien/03.wav",
      "durationInSeconds": 3.194,
      "tempo": 1.1,
      "hash": "eece1bff4a33"
    },
    {
      "id": "04",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.15,
      "text": "Bí quyết?",
      "voice": "Orus",
      "src": "voiceover/p2-evn-gia-dien/04.wav",
      "durationInSeconds": 0.375,
      "tempo": 1.1,
      "hash": "eece1bff4a33"
    },
    {
      "id": "05",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.6,
      "text": "Trời mưa.",
      "voice": "Orus",
      "src": "voiceover/p2-evn-gia-dien/05.wav",
      "durationInSeconds": 0.506,
      "tempo": 1.1,
      "hash": "eece1bff4a33"
    },
    {
      "id": "06",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.15,
      "text": "Năm hai nghìn hai mươi hai, than nhập khẩu đắt vọt.",
      "voice": "Orus",
      "src": "voiceover/p2-evn-gia-dien/06.wav",
      "durationInSeconds": 2.888,
      "tempo": 1.1,
      "hash": "b9d47839342e"
    },
    {
      "id": "07",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.6,
      "text": "Mỗi số điện từ than tốn gần gấp đôi giá bán ra, nên càng bán càng lỗ.",
      "voice": "Orus",
      "src": "voiceover/p2-evn-gia-dien/07.wav",
      "durationInSeconds": 4.089,
      "tempo": 1.1,
      "hash": "b9d47839342e"
    },
    {
      "id": "08",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.15,
      "text": "Bộ Công Thương cho rằng chi phí hợp lý thì cần được bù.",
      "voice": "Orus",
      "src": "voiceover/p2-evn-gia-dien/08.wav",
      "durationInSeconds": 2.768,
      "tempo": 1.1,
      "hash": "f945948fcfe8"
    },
    {
      "id": "09",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.15,
      "text": "Bộ Tài chính muốn tách: lỗ vì giữ giá cho dân, hay vì kinh doanh.",
      "voice": "Orus",
      "src": "voiceover/p2-evn-gia-dien/09.wav",
      "durationInSeconds": 3.973,
      "tempo": 1.1,
      "hash": "f945948fcfe8"
    },
    {
      "id": "10",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.6,
      "text": "Ông Nguyễn Tiến Thỏa, nguyên Cục trưởng Cục Quản lý giá, nói: làm ăn yếu kém thì tự chịu, giữ giá vì an sinh thì phải có cách bù.",
      "voice": "Orus",
      "src": "voiceover/p2-evn-gia-dien/10.wav",
      "durationInSeconds": 6.808,
      "tempo": 1.1,
      "hash": "f945948fcfe8"
    },
    {
      "id": "11",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.15,
      "text": "Tháng năm năm hai nghìn hai mươi lăm, giá điện tăng bốn phẩy tám phần trăm.",
      "voice": "Orus",
      "src": "voiceover/p2-evn-gia-dien/11.wav",
      "durationInSeconds": 3.775,
      "tempo": 1.1,
      "hash": "4cb058da0084"
    },
    {
      "id": "12",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.15,
      "text": "Rồi mưa nhiều, hồ thủy điện từ Sơn La tới Tây Nguyên đầy ắp.",
      "voice": "Orus",
      "src": "voiceover/p2-evn-gia-dien/12.wav",
      "durationInSeconds": 3.39,
      "tempo": 1.1,
      "hash": "4cb058da0084"
    },
    {
      "id": "13",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.15,
      "text": "Sáu tháng đầu năm, điện từ thủy điện tăng gần một phần tư.",
      "voice": "Orus",
      "src": "voiceover/p2-evn-gia-dien/13.wav",
      "durationInSeconds": 3.111,
      "tempo": 1.1,
      "hash": "4cb058da0084"
    },
    {
      "id": "14",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.15,
      "text": "Đây là nguồn điện rẻ nhất, nên lãi tăng vọt.",
      "voice": "Orus",
      "src": "voiceover/p2-evn-gia-dien/14.wav",
      "durationInSeconds": 2.356,
      "tempo": 1.1,
      "hash": "4cb058da0084"
    },
    {
      "id": "15",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.6,
      "text": "Năm đó, chắc cả EVN đều mong mưa.",
      "voice": "Orus",
      "src": "voiceover/p2-evn-gia-dien/15.wav",
      "durationInSeconds": 2.011,
      "tempo": 1.1,
      "hash": "4cb058da0084"
    },
    {
      "id": "16",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 0.15,
      "text": "Nhưng có một điều ít ai để ý.",
      "voice": "Orus",
      "src": "voiceover/p2-evn-gia-dien/16.wav",
      "durationInSeconds": 1.875,
      "tempo": 1.1,
      "hash": "e0db616e7e52"
    },
    {
      "id": "17",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 0.15,
      "text": "Cả tập đoàn đã hết lỗ, còn công ty mẹ thì chưa.",
      "voice": "Orus",
      "src": "voiceover/p2-evn-gia-dien/17.wav",
      "durationInSeconds": 3.394,
      "tempo": 1.1,
      "hash": "e0db616e7e52"
    },
    {
      "id": "18",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 0.15,
      "text": "Khoản lỗ từng đề xuất tính vào giá điện giờ còn hơn năm nghìn sáu trăm tỷ.",
      "voice": "Orus",
      "src": "voiceover/p2-evn-gia-dien/18.wav",
      "durationInSeconds": 3.746,
      "tempo": 1.1,
      "hash": "e0db616e7e52"
    },
    {
      "id": "19",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 0.15,
      "text": "Theo đề xuất ấy, năm nào nhiều nước thì có thể bù lỗ mà không cần tăng giá.",
      "voice": "Orus",
      "src": "voiceover/p2-evn-gia-dien/19.wav",
      "durationInSeconds": 3.903,
      "tempo": 1.1,
      "hash": "e0db616e7e52"
    },
    {
      "id": "20",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 0.6,
      "text": "Hoá đơn tiền điện, hoá ra cũng phải xem dự báo thời tiết.",
      "voice": "Orus",
      "src": "voiceover/p2-evn-gia-dien/20.wav",
      "durationInSeconds": 3.174,
      "tempo": 1.1,
      "hash": "e0db616e7e52"
    }
  ]
