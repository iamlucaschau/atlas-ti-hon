    },
    {
      "id": "04",
      "scene": "s1",
      "take": "t01b",
      "gapAfter": 0.06,
      "text": "Đức chỉ rộng hơn chừng tám phần trăm.",
      "voice": "Orus",
      "src": "voiceover/p3-dien-tich-viet-nam/04.wav",
      "durationInSeconds": 2.122,
      "tempo": 1.1,
      "hash": "731a5da22bd0"
    },
    {
      "id": "05",
      "scene": "s1",
      "take": "t01b",
      "gapAfter": 0.25,
      "text": "Vậy cái gì đang làm Việt Nam nhỏ đi?",
      "voice": "Orus",
      "src": "voiceover/p3-dien-tich-viet-nam/05.wav",
      "durationInSeconds": 1.899,
      "tempo": 1.1,
      "hash": "731a5da22bd0"
    },
    {
      "id": "06",
      "scene": "s1",
      "take": "t01c",
      "gapAfter": 0.25,
      "text": "Chính tấm bản đồ.",
      "voice": "Orus",
      "src": "voiceover/p3-dien-tich-viet-nam/06.wav",
      "durationInSeconds": 1.256,
      "tempo": 1.1,
      "hash": "569f4a4defa7"
    },
    {
      "id": "07",
      "scene": "s2",
      "take": "t01c",
      "gapAfter": 0.15,
      "text": "Việt Nam rộng khoảng ba trăm ba mươi mốt nghìn ki-lô-mét vuông.",
      "voice": "Orus",
      "src": "voiceover/p3-dien-tich-viet-nam/07.wav",
      "durationInSeconds": 2.904,
      "tempo": 1.1,
      "hash": "569f4a4defa7"
    },
    {
      "id": "08",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.06,
      "text": "Lớn hơn Ý, hơn cả Anh, dù trên bản đồ trông ngược lại.",
      "voice": "Orus",
      "src": "voiceover/p3-dien-tich-viet-nam/08.wav",
      "durationInSeconds": 4.521,
      "tempo": 1.1,
      "hash": "57b72da390ea"
    },
    {
      "id": "09",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.06,
      "text": "Từ Lũng Cú tới Đất Mũi dài một nghìn sáu trăm năm mươi ki-lô-mét.",
      "voice": "Orus",
      "src": "voiceover/p3-dien-tich-viet-nam/09.wav",
      "durationInSeconds": 4.181,
      "tempo": 1.1,
      "hash": "57b72da390ea"
    },
    {
      "id": "10",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.25,
      "text": "Đặt lên châu Âu, quãng ấy kéo từ Đan Mạch xuống tận Napoli.",
      "voice": "Orus",
      "src": "voiceover/p3-dien-tich-viet-nam/10.wav",
      "durationInSeconds": 3.782,
      "tempo": 1.1,
      "hash": "57b72da390ea"
    },
    {
      "id": "11",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.06,
      "text": "Tấm bản đồ ấy ra đời năm một nghìn năm trăm sáu mươi chín.",
      "voice": "Orus",
      "src": "voiceover/p3-dien-tich-viet-nam/11.wav",
      "durationInSeconds": 2.755,
      "tempo": 1.1,
      "hash": "10d507c71412"
    },
    {
      "id": "12",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.06,
      "text": "Gerardus Mercator vẽ nó cho người đi biển.",
      "voice": "Orus",
      "src": "voiceover/p3-dien-tich-viet-nam/12.wav",
      "durationInSeconds": 2.732,
      "tempo": 1.1,
      "hash": "10d507c71412"
    },
    {
      "id": "13",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.06,
      "text": "Cứ giữ một hướng la bàn, trên bản đồ là một đường thẳng.",
      "voice": "Orus",
      "src": "voiceover/p3-dien-tich-viet-nam/13.wav",
      "durationInSeconds": 2.627,
      "tempo": 1.1,
      "hash": "10d507c71412"
    },
    {
      "id": "14",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.25,
      "text": "Cái giá: càng xa xích đạo, đất càng bị phóng to.",
      "voice": "Orus",
      "src": "voiceover/p3-dien-tich-viet-nam/14.wav",
      "durationInSeconds": 3.023,
      "tempo": 1.1,
      "hash": "10d507c71412"
    },
    {
      "id": "15",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.06,
      "text": "Greenland trông to ngang châu Phi.",
      "voice": "Orus",
      "src": "voiceover/p3-dien-tich-viet-nam/15.wav",
      "durationInSeconds": 2.09,
      "tempo": 1.1,
      "hash": "7b8b19e9416a"
    },
    {
      "id": "16",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.25,
      "text": "Thực ra, châu Phi lớn gấp mười bốn lần.",
      "voice": "Orus",
      "src": "voiceover/p3-dien-tich-viet-nam/16.wav",
      "durationInSeconds": 2.743,
      "tempo": 1.1,
      "hash": "7b8b19e9416a"
    },
    {
      "id": "17",
      "scene": "s4",
      "take": "t04g",
      "gapAfter": 0.25,
      "who": "greenland",
      "text": "Do góc chụp thôi mà!",
      "voice": "Puck",
      "src": "voiceover/p3-dien-tich-viet-nam/17.wav",
      "durationInSeconds": 1.576,
      "tempo": 1.1,
      "hash": "55d5028132d3"
    },
    {
      "id": "18",
      "scene": "s4",
      "take": "t05",
      "gapAfter": 0.25,
      "text": "Phần Lan rộng gần bằng Việt Nam, nhưng trên bản đồ trông to gấp năm.",
      "voice": "Orus",
      "src": "voiceover/p3-dien-tich-viet-nam/18.wav",
      "durationInSeconds": 4.076,
      "tempo": 1.1,
      "hash": "3041db647259"
    },
    {
      "id": "19",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 0.06,
      "text": "Năm một nghìn chín trăm bảy mươi ba, sử gia Đức Arno Peters họp báo, tố bản đồ này thiên vị phương Bắc.",
      "voice": "Orus",
      "src": "voiceover/p3-dien-tich-viet-nam/19.wav",
      "durationInSeconds": 6.073,
      "tempo": 1.1,
      "hash": "3041db647259"
    },
    {
      "id": "20",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 0.06,
      "text": "Giới vẽ bản đồ cãi lại: bản đồ của ông méo hình dáng, lại chẳng mới.",
      "voice": "Orus",
      "src": "voiceover/p3-dien-tich-viet-nam/20.wav",
      "durationInSeconds": 4.004,
      "tempo": 1.1,
      "hash": "3041db647259"
    },
    {
      "id": "21",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 0.06,
      "text": "Bản đồ phẳng nào cũng méo.",
      "voice": "Orus",
      "src": "voiceover/p3-dien-tich-viet-nam/21.wav",
      "durationInSeconds": 1.369,
      "tempo": 1.1,
      "hash": "3041db647259"
    },
    {
      "id": "22",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 0.25,
      "text": "Google Maps trên điện thoại bạn vẫn dựa trên Mercator, vì nó giữ đúng hướng.",
      "voice": "Orus",
      "src": "voiceover/p3-dien-tich-viet-nam/22.wav",
      "durationInSeconds": 4.044,
      "tempo": 1.1,
      "hash": "3041db647259"
    },
    {
      "id": "23",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.06,
      "text": "Trớ trêu là, kéo nguyên hình Việt Nam lên châu Âu, trên bản đồ nó to gấp đôi.",
      "voice": "Orus",
      "src": "voiceover/p3-dien-tich-viet-nam/23.wav",
      "durationInSeconds": 5.2,
      "tempo": 1.1,
      "hash": "85bd8551d5ca"
    },
    {
      "id": "24",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.25,
      "text": "Đất nước mình không nhỏ, chỉ là đứng gần xích đạo hơn nước Đức.",
      "voice": "Orus",
      "src": "voiceover/p3-dien-tich-viet-nam/24.wav",
