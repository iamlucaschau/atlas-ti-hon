{
  "name": "i-singapore",
  "model": "gemini-3.8-flash-tts",
  "totalSeconds": 52.811,
  "lines": [
    {
      "id": "01",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.06,
      "text": "Malaysia từng đuổi Singapore ra khỏi đất nước.",
      "voice": "Orus",
      "src": "voiceover/i-singapore/01.wav",
      "durationInSeconds": 2.389,
      "tempo": 1.1,
      "hash": "c3a8924f5fe0"
    },
    {
      "id": "02",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.25,
      "text": "Vậy vì sao hôm nay, Singapore lại giàu gấp hơn bảy lần?",
      "voice": "Orus",
      "src": "voiceover/i-singapore/02.wav",
      "durationInSeconds": 2.674,
      "tempo": 1.1,
      "hash": "c3a8924f5fe0"
    },
    {
      "id": "03",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.06,
      "text": "Năm một nghìn tám trăm mười chín, người Anh trả cho Sultan Hussein năm nghìn đô la Tây Ban Nha mỗi năm, để lập một thương cảng trên hòn đảo nhỏ này.",
      "voice": "Orus",
      "src": "voiceover/i-singapore/03.wav",
      "durationInSeconds": 7.484,
      "tempo": 1.1,
      "hash": "9f19952f1bf4"
    },
    {
      "id": "04",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.25,
      "text": "Vị trí của nó là vàng: ngay cửa eo biển Malacca, tuyến tàu buôn giữa Ấn Độ Dương và Biển Đông.",
      "voice": "Orus",
      "src": "voiceover/i-singapore/04.wav",
      "durationInSeconds": 5.727,
      "tempo": 1.1,
      "hash": "9f19952f1bf4"
    },
    {
      "id": "05",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.06,
      "text": "Năm một nghìn chín trăm sáu mươi ba, Singapore gia nhập Malaysia.",
      "voice": "Orus",
      "src": "voiceover/i-singapore/05.wav",
      "durationInSeconds": 3.154,
      "tempo": 1.1,
      "hash": "11df79f7e63b"
    },
    {
      "id": "06",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.25,
      "text": "Nhưng chưa đầy hai năm, mâu thuẫn chính trị và bạo loạn sắc tộc bùng lên.",
      "voice": "Orus",
      "src": "voiceover/i-singapore/06.wav",
      "durationInSeconds": 3.356,
      "tempo": 1.1,
      "hash": "11df79f7e63b"
    },
    {
      "id": "07",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.06,
      "text": "Ngày chín tháng tám năm một nghìn chín trăm sáu mươi lăm, Quốc hội Malaysia bỏ phiếu một trăm hai mươi sáu trên không, tách Singapore ra.",
      "voice": "Orus",
      "src": "voiceover/i-singapore/07.wav",
      "durationInSeconds": 6.364,
      "tempo": 1.1,
      "hash": "7f6059b54b1e"
    },
    {
      "id": "08",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.25,
      "text": "Lý Quang Diệu bật khóc trên truyền hình.",
      "voice": "Orus",
      "src": "voiceover/i-singapore/08.wav",
      "durationInSeconds": 1.753,
      "tempo": 1.1,
      "hash": "7f6059b54b1e"
    },
    {
      "id": "09",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 0.06,
      "text": "Một hòn đảo chưa đầy sáu trăm cây số vuông.",
      "voice": "Orus",
      "src": "voiceover/i-singapore/09.wav",
      "durationInSeconds": 2.457,
      "tempo": 1.1,
      "hash": "c6176ed2a124"
    },
    {
      "id": "10",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 0.06,
      "text": "Không tài nguyên.",
      "voice": "Orus",
      "src": "voiceover/i-singapore/10.wav",
      "durationInSeconds": 1.047,
      "tempo": 1.1,
      "hash": "c6176ed2a124"
    },
    {
      "id": "11",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 0.25,
      "text": "Đến nước ngọt cũng phải mua từ Malaysia.",
      "voice": "Orus",
      "src": "voiceover/i-singapore/11.wav",
      "durationInSeconds": 2.123,
      "tempo": 1.1,
      "hash": "c6176ed2a124"
    },
    {
      "id": "12",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.06,
      "text": "Nên Singapore dồn hết vào thứ duy nhất họ có: vị trí.",
      "voice": "Orus",
      "src": "voiceover/i-singapore/12.wav",
      "durationInSeconds": 3.011,
      "tempo": 1.1,
      "hash": "ac5f3856819f"
    },
    {
      "id": "13",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.06,
      "text": "Cảng biển, nhà máy, ngân hàng.",
      "voice": "Orus",
      "src": "voiceover/i-singapore/13.wav",
      "durationInSeconds": 2.203,
      "tempo": 1.1,
      "hash": "ac5f3856819f"
    },
    {
      "id": "14",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.25,
      "text": "Họ còn lấn biển, nới rộng hòn đảo thêm khoảng một phần tư.",
      "voice": "Orus",
      "src": "voiceover/i-singapore/14.wav",
      "durationInSeconds": 3.031,
      "tempo": 1.1,
      "hash": "ac5f3856819f"
    },
    {
      "id": "15",
      "scene": "s7",
      "take": "t07",
      "gapAfter": 0.06,
      "text": "Năm hai nghìn hai mươi tư, mỗi người dân Singapore làm ra hơn chín mươi nghìn đô la.",
      "voice": "Orus",
      "src": "voiceover/i-singapore/15.wav",
      "durationInSeconds": 3.993,
      "tempo": 1.1,
      "hash": "302acb57893c"
    },
    {
      "id": "16",
      "scene": "s7",
      "take": "t07",
      "gapAfter": 0.25,
      "text": "Người Malaysia, chưa tới mười hai nghìn.",
      "voice": "Orus",
      "src": "voiceover/i-singapore/16.wav",
      "durationInSeconds": 2.045,
      "tempo": 1.1,
      "hash": "302acb57893c"
    }
  ]
}
