  "lines": [
    {
      "id": "01",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.06,
      "text": "Việt Nam dự kiến chi khoảng sáu mươi bảy tỷ đô, chỉ để mua một ngày.",
      "voice": "Orus",
      "src": "voiceover/p2-duong-sat-cao-toc/01.wav",
      "durationInSeconds": 3.834,
      "tempo": 1,
      "hash": "185c1450be5e"
    },
    {
      "id": "02",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.06,
      "text": "Nghe vô lý?",
      "voice": "Orus",
      "src": "voiceover/p2-duong-sat-cao-toc/02.wav",
      "durationInSeconds": 0.647,
      "tempo": 1,
      "hash": "185c1450be5e"
    },
    {
      "id": "03",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.25,
      "text": "Giả sử hai đoàn tàu cùng rời Hà Nội.",
      "voice": "Orus",
      "src": "voiceover/p2-duong-sat-cao-toc/03.wav",
      "durationInSeconds": 2.087,
      "tempo": 1,
      "hash": "185c1450be5e"
    },
    {
      "id": "04",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.06,
      "text": "Tàu Thống Nhất hôm nay: lên tàu buổi tối, ngủ hai đêm mới tới Sài Gòn.",
      "voice": "Orus",
      "src": "voiceover/p2-duong-sat-cao-toc/04.wav",
      "durationInSeconds": 4.147,
      "tempo": 1,
      "hash": "f9f77454a17a"
    },
    {
      "id": "05",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.06,
      "text": "Tàu cao tốc nhanh nhất dự kiến chỉ mất khoảng năm tiếng rưỡi.",
      "voice": "Orus",
      "src": "voiceover/p2-duong-sat-cao-toc/05.wav",
      "durationInSeconds": 3.144,
      "tempo": 1,
      "hash": "f9f77454a17a"
    },
    {
      "id": "06",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.25,
      "text": "Ăn sáng phở Hà Nội, ăn trưa cơm tấm Sài Gòn.",
      "voice": "Orus",
      "src": "voiceover/p2-duong-sat-cao-toc/06.wav",
      "durationInSeconds": 3.173,
      "tempo": 1,
      "hash": "f9f77454a17a"
    },
    {
      "id": "07",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.06,
      "text": "Nhưng cái giá thì không hề nhẹ.",
      "voice": "Orus",
      "src": "voiceover/p2-duong-sat-cao-toc/07.wav",
      "durationInSeconds": 1.926,
      "tempo": 1,
      "hash": "7f91bd655288"
    },
    {
      "id": "08",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.06,
      "text": "Tuyến dài hơn một nghìn rưỡi cây số.",
      "voice": "Orus",
      "src": "voiceover/p2-duong-sat-cao-toc/08.wav",
      "durationInSeconds": 2.296,
      "tempo": 1,
      "hash": "7f91bd655288"
    },
    {
      "id": "09",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.25,
      "text": "Theo vốn sơ bộ, mỗi mét đường tốn hơn một tỷ đồng.",
      "voice": "Orus",
      "src": "voiceover/p2-duong-sat-cao-toc/09.wav",
      "durationInSeconds": 3.459,
      "tempo": 1,
      "hash": "7f91bd655288"
    },
    {
      "id": "10",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.15,
      "text": "Sao lại đắt thế?",
      "voice": "Orus",
      "src": "voiceover/p2-duong-sat-cao-toc/10.wav",
      "durationInSeconds": 1.059,
      "tempo": 1,
      "hash": "eb8705a786be"
    },
    {
      "id": "11",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.15,
      "text": "Vì toàn cầu.",
      "voice": "Orus",
      "src": "voiceover/p2-duong-sat-cao-toc/11.wav",
      "durationInSeconds": 0.98,
      "tempo": 1,
      "hash": "eb8705a786be"
    },
    {
      "id": "12",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.06,
      "text": "Khoảng sáu mươi phần trăm tuyến dự kiến đi trên cầu.",
      "voice": "Orus",
      "src": "voiceover/p2-duong-sat-cao-toc/12.wav",
      "durationInSeconds": 2.352,
      "tempo": 1,
      "hash": "eb8705a786be"
    },
    {
      "id": "13",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.06,
      "text": "Thêm khoảng mười phần trăm chui trong hầm.",
      "voice": "Orus",
      "src": "voiceover/p2-duong-sat-cao-toc/13.wav",
      "durationInSeconds": 1.966,
      "tempo": 1,
      "hash": "eb8705a786be"
    },
    {
      "id": "14",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.25,
      "text": "Để chạy ba trăm năm mươi cây số một giờ, phần lớn con đường được nhấc hẳn lên khỏi mặt đất.",
      "voice": "Orus",
      "src": "voiceover/p2-duong-sat-cao-toc/14.wav",
      "durationInSeconds": 4.596,
      "tempo": 1,
      "hash": "eb8705a786be"
    },
    {
      "id": "15",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 0.06,
      "text": "Cuối năm hai nghìn hai mươi tư, Quốc hội vẫn bấm nút.",
      "voice": "Orus",
      "src": "voiceover/p2-duong-sat-cao-toc/15.wav",
      "durationInSeconds": 2.939,
      "tempo": 1,
      "hash": "dfdb04e8405c"
    },
    {
      "id": "16",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 0.06,
      "text": "Bốn trăm bốn mươi ba trên bốn trăm năm mươi tư đại biểu tán thành.",
      "voice": "Orus",
      "src": "voiceover/p2-duong-sat-cao-toc/16.wav",
      "durationInSeconds": 3.214,
      "tempo": 1,
      "hash": "dfdb04e8405c"
    },
    {
      "id": "17",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 0.06,
      "text": "Nhưng nhiều chuyên gia vẫn hỏi: bao giờ hoàn vốn?",
      "voice": "Orus",
      "src": "voiceover/p2-duong-sat-cao-toc/17.wav",
      "durationInSeconds": 2.975,
      "tempo": 1,
      "hash": "dfdb04e8405c"
    },
    {
      "id": "18",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 0.25,
      "text": "Chính phủ thừa nhận, bốn năm đầu, doanh thu chỉ đủ bù chi phí vận hành.",
      "voice": "Orus",
      "src": "voiceover/p2-duong-sat-cao-toc/18.wav",
      "durationInSeconds": 4.391,
      "tempo": 1,
      "hash": "dfdb04e8405c"
    },
    {
      "id": "19",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.06,
      "text": "Giờ quay lại hai đoàn tàu.",
      "voice": "Orus",
      "src": "voiceover/p2-duong-sat-cao-toc/19.wav",
      "durationInSeconds": 1.383,
      "tempo": 1,
      "hash": "7371c9312f1a"
    },
    {
      "id": "20",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.25,
      "text": "Khi tàu cao tốc đã tới Thủ Thiêm, tàu Thống Nhất còn chưa tới Vinh.",
      "voice": "Orus",
      "src": "voiceover/p2-duong-sat-cao-toc/20.wav",
      "durationInSeconds": 4.157,
      "tempo": 1,
      "hash": "7371c9312f1a"
    },
    {
      "id": "21",
      "scene": "s7",
      "take": "t07",
      "gapAfter": 0.06,
      "text": "Trớ trêu là, tuyến Thống Nhất được nối liền từ năm một nghìn chín trăm ba mươi sáu.",
      "voice": "Orus",
      "src": "voiceover/p2-duong-sat-cao-toc/21.wav",
      "durationInSeconds": 4.365,
      "tempo": 1,
      "hash": "4bac52db8fc1"
    },
    {
      "id": "22",
      "scene": "s7",
      "take": "t07",
      "gapAfter": 0.06,
      "text": "Chuyến đầu tiên chạy hết tuyến, Toàn quyền Đông Dương cùng gia đình ngồi trên tàu khoảng bốn mươi tiếng.",
      "voice": "Orus",
      "src": "voiceover/p2-duong-sat-cao-toc/22.wav",
      "durationInSeconds": 5.326,
      "tempo": 1,
      "hash": "4bac52db8fc1"
    },
    {
      "id": "23",
      "scene": "s7",
      "take": "t07",
      "gapAfter": 0.3,
      "text": "Chín mươi năm trôi qua.",
      "voice": "Orus",
      "src": "voiceover/p2-duong-sat-cao-toc/23.wav",
      "durationInSeconds": 1.138,
      "tempo": 1,
      "hash": "4bac52db8fc1"
    },
    {
      "id": "24",
      "scene": "s7",
      "take": "t07",
      "gapAfter": 0.25,
      "text": "Tàu chỉ nhanh hơn chưa tới mười tiếng.",
      "voice": "Orus",
      "src": "voiceover/p2-duong-sat-cao-toc/24.wav",
      "durationInSeconds": 1.911,
      "tempo": 1,
      "hash": "4bac52db8fc1"
    }
  ]
