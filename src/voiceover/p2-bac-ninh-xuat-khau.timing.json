{
  "durationInSeconds": 68.46333333333334,
  "loop": true,
  "tail": 0.7,
  "lines": [
    {
      "id": "01",
      "scene": "s1",
      "start": 0.05,
      "end": 4.631,
      "text": "Trước khi gộp tỉnh, Bắc Ninh nhỏ nhất nước, không biển, chưa có sân bay."
    },
    {
      "id": "02",
      "scene": "s1",
      "start": 4.691291666666666,
      "end": 9.190291666666667,
      "text": "Vậy mà năm hai nghìn hai mươi lăm, Bắc Ninh xuất khẩu vượt cả Thành phố Hồ Chí Minh."
    },
    {
      "id": "03",
      "scene": "s1",
      "start": 9.250374999999998,
      "end": 9.820374999999999,
      "text": "Hàng gì?"
    },
    {
      "id": "04",
      "scene": "s1",
      "start": 9.970291666666665,
      "end": 10.552291666666665,
      "text": "Điện thoại."
    },
    {
      "id": "05",
      "scene": "s2",
      "start": 11.151916666666665,
      "end": 14.841916666666664,
      "text": "Năm hai nghìn lẻ tám, Samsung xin xây nhà máy điện thoại ở Yên Phong."
    },
    {
      "id": "06",
      "scene": "s2",
      "start": 14.902333333333331,
      "end": 19.83533333333333,
      "text": "Ông Nguyễn Quang Thanh, cán bộ tỉnh, nói với hãng tin AP: đủ giấy là cấp phép ngay."
    },
    {
      "id": "07",
      "scene": "s3",
      "start": 20.085666666666665,
      "end": 20.655666666666665,
      "text": "Vì đâu?"
    },
    {
      "id": "08",
      "scene": "s3",
      "start": 20.715874999999997,
      "end": 21.166874999999997,
      "text": "Vị trí."
    },
    {
      "id": "09",
      "scene": "s3",
      "start": 21.22645833333333,
      "end": 25.63645833333333,
      "text": "Nội Bài ngay sát bên, cảng Hải Phòng phía đông, biên giới Trung Quốc phía bắc."
    },
    {
      "id": "10",
      "scene": "s4",
      "start": 25.88683333333333,
      "end": 28.780833333333327,
      "text": "Đất em nhỏ thật, nhưng đi đâu cũng gần nha!"
    },
    {
      "id": "11",
      "scene": "s5",
      "start": 29.03129166666666,
      "end": 31.837291666666662,
      "text": "Điện thoại nhẹ mà đắt, chở máy bay là vừa."
    },
    {
      "id": "12",
      "scene": "s6",
      "start": 32.08754166666666,
      "end": 35.82554166666666,
      "text": "Tháng bảy năm hai nghìn hai mươi lăm, Bắc Ninh gộp Bắc Giang, cũng đầy nhà máy."
    },
    {
      "id": "13",
      "scene": "s6",
      "start": 35.88587499999999,
      "end": 38.670874999999995,
      "text": "Nhưng Thành phố Hồ Chí Minh cũng gộp Bình Dương, Bà Rịa Vũng Tàu."
    },
    {
      "id": "14",
      "scene": "s6",
      "start": 38.73112499999999,
      "end": 41.85012499999999,
      "text": "Tính trên địa giới mới, phải tới tháng mười, Bắc Ninh mới vượt."
    },
    {
      "id": "15",
      "scene": "s6",
      "start": 41.90974999999999,
      "end": 45.49174999999999,
      "text": "Cả năm, Bắc Ninh hơn chín mươi ba tỷ đô, nhỉnh hơn chút xíu."
    },
    {
      "id": "16",
      "scene": "s6",
      "start": 45.55145833333332,
      "end": 47.69145833333332,
      "text": "Sát nút như hai xe máy cùng cán vạch."
    },
    {
      "id": "17",
      "scene": "s7",
      "start": 47.94174999999999,
      "end": 50.25274999999999,
      "text": "Tỉnh gọi đây là trung tâm xuất khẩu của cả nước."
    },
    {
      "id": "18",
      "scene": "s7",
      "start": 50.312458333333325,
      "end": 54.96245833333332,
      "text": "Nhưng trong một trăm bảy mươi sáu nhà cung cấp chính của Samsung ở đây, chỉ mười hai là doanh nghiệp Việt."
    },
    {
      "id": "19",
      "scene": "s8",
      "start": 55.212416666666655,
      "end": 57.273416666666655,
      "text": "Còn chuyện thú vị nhất nằm trên bản đồ."
    },
    {
      "id": "20",
      "scene": "s8",
      "start": 57.33374999999999,
      "end": 61.63474999999999,
      "text": "Năm một nghìn chín trăm chín mươi bảy, tỉnh Hà Bắc tách đôi thành Bắc Ninh và Bắc Giang."
    },
    {
      "id": "21",
      "scene": "s8",
      "start": 61.69495833333332,
      "end": 64.55695833333331,
      "text": "Hai mươi tám năm sau, hai nửa về lại một nhà."
    },
    {
      "id": "22",
      "scene": "s8",
      "start": 64.61679166666666,
      "end": 68.21379166666665,
      "text": "Tách ra là tỉnh nhỏ nhất, gộp lại thành nơi xuất khẩu nhiều nhất."
    }
  ]
}
