  "lines": [
    {
      "id": "01",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.06,
      "text": "Trên bản đồ, đường thẳng từ Sài Gòn sang Mỹ lại là đường xa hơn.",
      "voice": "Orus",
      "src": "voiceover/p4-duong-bay-cong/01.wav",
      "durationInSeconds": 3.921,
      "tempo": 1.1,
      "hash": "b6a76fa220ef"
    },
    {
      "id": "02",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.06,
      "text": "Đường nào ngắn hơn?",
      "voice": "Orus",
      "src": "voiceover/p4-duong-bay-cong/02.wav",
      "durationInSeconds": 0.711,
      "tempo": 1.1,
      "hash": "b6a76fa220ef"
    },
    {
      "id": "03",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.06,
      "text": "Đường cong.",
      "voice": "Orus",
      "src": "voiceover/p4-duong-bay-cong/03.wav",
      "durationInSeconds": 0.588,
      "tempo": 1.1,
      "hash": "b6a76fa220ef"
    },
    {
      "id": "04",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.25,
      "text": "Một đường cong vòng lên gần Alaska.",
      "voice": "Orus",
      "src": "voiceover/p4-duong-bay-cong/04.wav",
      "durationInSeconds": 2.142,
      "tempo": 1.1,
      "hash": "b6a76fa220ef"
    },
    {
      "id": "05",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.06,
      "text": "Cuối năm hai nghìn hai mươi mốt, Vietnam Airlines mở chuyến bay thẳng thường lệ đầu tiên từ Việt Nam sang Mỹ.",
      "voice": "Orus",
      "src": "voiceover/p4-duong-bay-cong/05.wav",
      "durationInSeconds": 5.483,
      "tempo": 1.1,
      "hash": "be24e8f0fdb6"
    },
    {
      "id": "06",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.25,
      "text": "Tân Sơn Nhất tới San Francisco, gần mười bốn tiếng, không dừng.",
      "voice": "Orus",
      "src": "voiceover/p4-duong-bay-cong/06.wav",
      "durationInSeconds": 3.818,
      "tempo": 1.1,
      "hash": "be24e8f0fdb6"
    },
    {
      "id": "07",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.06,
      "text": "Lỗi nằm ở tấm bản đồ quen thuộc.",
      "voice": "Orus",
      "src": "voiceover/p4-duong-bay-cong/07.wav",
      "durationInSeconds": 1.962,
      "tempo": 1.1,
      "hash": "0f2b98d5db52"
    },
    {
      "id": "08",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.06,
      "text": "Năm một nghìn năm trăm sáu mươi chín, ông Mercator trải quả địa cầu lên một tờ giấy phẳng, để thuỷ thủ dễ đi biển.",
      "voice": "Orus",
      "src": "voiceover/p4-duong-bay-cong/08.wav",
      "durationInSeconds": 5.841,
      "tempo": 1.1,
      "hash": "0f2b98d5db52"
    },
    {
      "id": "09",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.06,
      "text": "Trên đó, kẻ một đường thẳng là giữ được một hướng la bàn.",
      "voice": "Orus",
      "src": "voiceover/p4-duong-bay-cong/09.wav",
      "durationInSeconds": 3.048,
      "tempo": 1.1,
      "hash": "0f2b98d5db52"
    },
    {
      "id": "10",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.06,
      "text": "Rất tiện.",
      "voice": "Orus",
      "src": "voiceover/p4-duong-bay-cong/10.wav",
      "durationInSeconds": 0.767,
      "tempo": 1.1,
      "hash": "0f2b98d5db52"
    },
    {
      "id": "11",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.25,
      "text": "Nhưng không phải đường ngắn nhất.",
      "voice": "Orus",
      "src": "voiceover/p4-duong-bay-cong/11.wav",
      "durationInSeconds": 1.121,
      "tempo": 1.1,
      "hash": "0f2b98d5db52"
    },
    {
      "id": "12",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.06,
      "text": "Đi theo đường thẳng trên bản đồ, quãng đường khoảng mười ba nghìn bốn trăm cây số.",
      "voice": "Orus",
      "src": "voiceover/p4-duong-bay-cong/12.wav",
      "durationInSeconds": 3.841,
      "tempo": 1.1,
      "hash": "39446e933a68"
    },
    {
      "id": "13",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.06,
      "text": "Đường ngắn nhất thì đi ngang Nhật Bản, vòng lên gần quần đảo Aleut của Alaska, chỉ khoảng mười hai nghìn sáu trăm.",
      "voice": "Orus",
      "src": "voiceover/p4-duong-bay-cong/13.wav",
      "durationInSeconds": 5.631,
      "tempo": 1.1,
      "hash": "39446e933a68"
    },
    {
      "id": "14",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.06,
      "text": "Chênh khoảng tám trăm năm mươi cây số.",
      "voice": "Orus",
      "src": "voiceover/p4-duong-bay-cong/14.wav",
      "durationInSeconds": 1.727,
      "tempo": 1.1,
      "hash": "39446e933a68"
    },
    {
      "id": "15",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.06,
      "text": "Tức gần thêm một tiếng ngồi ghế máy bay.",
      "voice": "Orus",
      "src": "voiceover/p4-duong-bay-cong/15.wav",
      "durationInSeconds": 1.832,
      "tempo": 1.1,
      "hash": "39446e933a68"
    },
    {
      "id": "16",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.25,
      "text": "Không ai muốn thế.",
      "voice": "Orus",
      "src": "voiceover/p4-duong-bay-cong/16.wav",
      "durationInSeconds": 1.015,
      "tempo": 1.1,
      "hash": "39446e933a68"
    },
    {
      "id": "17",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 0.06,
      "text": "Cuộn bản đồ lại thành quả địa cầu, đường cong ấy hoá ra thẳng nhất.",
      "voice": "Orus",
      "src": "voiceover/p4-duong-bay-cong/17.wav",
      "durationInSeconds": 3.503,
      "tempo": 1.1,
      "hash": "f5024f6c9c0f"
    },
    {
      "id": "18",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 0.25,
      "text": "Chuyến bay thật cũng đi qua Nhật Bản, vòng lên phía bắc, còn lại tuỳ gió và vùng trời mỗi ngày.",
      "voice": "Orus",
      "src": "voiceover/p4-duong-bay-cong/18.wav",
      "durationInSeconds": 5.277,
      "tempo": 1.1,
      "hash": "f5024f6c9c0f"
    },
    {
      "id": "19",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.06,
      "text": "Nhưng chi tiết lạ nhất là, cũng tấm bản đồ ấy làm Greenland trông to gần bằng châu Phi.",
      "voice": "Orus",
      "src": "voiceover/p4-duong-bay-cong/19.wav",
      "durationInSeconds": 5.018,
      "tempo": 1.1,
      "hash": "f339474bd4ae"
    },
    {
      "id": "20",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.06,
      "text": "Thật ra, châu Phi lớn gấp khoảng mười bốn lần.",
      "voice": "Orus",
      "src": "voiceover/p4-duong-bay-cong/20.wav",
      "durationInSeconds": 2.67,
      "tempo": 1.1,
      "hash": "f339474bd4ae"
    },
    {
      "id": "21",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.25,
      "text": "Trên một quả cầu, đường thẳng nhất luôn là một đường cong.",
      "voice": "Orus",
      "src": "voiceover/p4-duong-bay-cong/21.wav",
      "durationInSeconds": 3.179,
      "tempo": 1.1,
      "hash": "f339474bd4ae"
    }
  ]
