{
  "durationInSeconds": 65.52883333333334,
  "loop": true,
  "tail": 0.7,
  "lines": [
    {
      "id": "01",
      "scene": "s1",
      "start": 0.05,
      "end": 3.1959999999999997,
      "text": "Campuchia đang chi hơn một tỷ đô để đào một con kênh ra biển."
    },
    {
      "id": "02",
      "scene": "s1",
      "start": 3.255958333333333,
      "end": 6.250958333333333,
      "text": "Nước cho con kênh ấy lấy từ một dòng sông mà người miền Tây nào cũng biết."
    },
    {
      "id": "03",
      "scene": "s2",
      "start": 6.500958333333333,
      "end": 7.382958333333333,
      "text": "Vì sao phải đào?"
    },
    {
      "id": "04",
      "scene": "s2",
      "start": 7.53325,
      "end": 8.440249999999999,
      "text": "Đường ra biển."
    },
    {
      "id": "05",
      "scene": "s2",
      "start": 8.500416666666666,
      "end": 13.768416666666667,
      "text": "Theo chính phủ Campuchia, khoảng một phần ba hàng hoá của họ phải xuôi Mê Kông qua Việt Nam rồi mới ra biển."
    },
    {
      "id": "06",
      "scene": "s2",
      "start": 13.828791666666666,
      "end": 17.069791666666667,
      "text": "Kênh mới dài một trăm tám mươi cây số, cắt thẳng xuống biển Kep."
    },
    {
      "id": "07",
      "scene": "s2",
      "start": 17.130041666666667,
      "end": 19.715041666666668,
      "text": "Mục tiêu là hạ tỉ lệ ấy còn khoảng một phần mười."
    },
    {
      "id": "08",
      "scene": "s3",
      "start": 19.965125,
      "end": 24.184125,
      "text": "Ngày khởi công, Thủ tướng Hun Manet tuyên bố: kênh sẽ được xây bằng mọi giá."
    },
    {
      "id": "09",
      "scene": "s4",
      "start": 24.434208333333334,
      "end": 26.282208333333333,
      "text": "Kênh bắt đầu từ sông Bassac."
    },
    {
      "id": "10",
      "scene": "s4",
      "start": 26.34241666666667,
      "end": 30.59941666666667,
      "text": "Phía Campuchia nói kênh chỉ lấy nước sông này, và hạ lưu gần như không bị ảnh hưởng."
    },
    {
      "id": "11",
      "scene": "s4",
      "start": 30.659000000000002,
      "end": 32.68,
      "text": "Còn chảy qua biên giới, sông Bassac đổi tên."
    },
    {
      "id": "12",
      "scene": "s4",
      "start": 32.879875000000006,
      "end": 33.885875000000006,
      "text": "Thành sông Hậu."
    },
    {
      "id": "13",
      "scene": "s4",
      "start": 33.94633333333334,
      "end": 38.293333333333344,
      "text": "Việt Nam vì thế đề nghị chia sẻ thông tin, đánh giá kỹ tác động lên nguồn nước miền Tây."
    },
    {
      "id": "14",
      "scene": "s5",
      "start": 38.543625000000006,
      "end": 40.802625000000006,
      "text": "Tháng tư năm nay, đoạn dài nhất bắt đầu thi công."
    },
    {
      "id": "15",
      "scene": "s5",
      "start": 40.86295833333334,
      "end": 44.482958333333336,
      "text": "Phía Campuchia nói kênh xong khoảng năm hai nghìn hai mươi tám, hai mươi chín."
    },
    {
      "id": "16",
      "scene": "s5",
      "start": 44.54320833333334,
      "end": 48.90220833333334,
      "text": "Còn báo chí độc lập ghi nhận: đầu năm nay, trang tiến độ chính thức vẫn báo số không."
    },
    {
      "id": "17",
      "scene": "s6",
      "start": 49.15220833333334,
      "end": 50.233208333333344,
      "text": "Và cú ngược đời?"
    },
    {
      "id": "18",
      "scene": "s6",
      "start": 50.38354166666667,
      "end": 51.001541666666675,
      "text": "Độ sâu."
    },
    {
      "id": "19",
      "scene": "s6",
      "start": 51.201750000000004,
      "end": 54.61975,
      "text": "Kênh chỉ sâu chừng năm mét rưỡi, vừa cho sà lan và tàu nhỏ."
    },
    {
      "id": "20",
      "scene": "s6",
      "start": 54.679625,
      "end": 57.876625000000004,
      "text": "Còn cảng Cái Mép đón được tàu container hai trăm nghìn tấn."
    },
    {
      "id": "21",
      "scene": "s6",
      "start": 57.936625,
      "end": 60.425625,
      "text": "Lùa tàu ấy vào kênh thì như lùa voi qua ngõ hẻm."
    },
    {
      "id": "22",
      "scene": "s6",
      "start": 60.485375,
      "end": 65.278375,
      "text": "Nên nhiều nhà phân tích cho rằng, kênh mở thêm một cửa ra biển, nhưng chưa thay được cánh cửa cũ."
    }
  ]
}
