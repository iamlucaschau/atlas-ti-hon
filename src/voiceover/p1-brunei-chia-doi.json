{
  "name": "p1-brunei-chia-doi",
  "model": "gemini-3.8-flash-tts",
  "totalSeconds": 71.525,
  "lines": [
    {
      "id": "01",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.06,
      "text": "Brunei từng làm chủ gần cả đảo Borneo.",
      "voice": "Orus",
      "src": "voiceover/p1-brunei-chia-doi/01.wav",
      "durationInSeconds": 2.396,
      "tempo": 1.1,
      "hash": "55dbda21218d"
    },
    {
      "id": "02",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.25,
      "text": "Hôm nay, nó nhỏ hơn cả Thành phố Hồ Chí Minh, và còn bị cắt làm đôi.",
      "voice": "Orus",
      "src": "voiceover/p1-brunei-chia-doi/02.wav",
      "durationInSeconds": 3.851,
      "tempo": 1.1,
      "hash": "55dbda21218d"
    },
    {
      "id": "03",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.06,
      "text": "Thế kỷ mười sáu, vua Brunei kiểm soát gần hết bờ biển của đảo.",
      "voice": "Orus",
      "src": "voiceover/p1-brunei-chia-doi/03.wav",
      "durationInSeconds": 3.362,
      "tempo": 1.1,
      "hash": "7a099cad72cb"
    },
    {
      "id": "04",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.25,
      "text": "Nhưng rồi người châu Âu tới.",
      "voice": "Orus",
      "src": "voiceover/p1-brunei-chia-doi/04.wav",
      "durationInSeconds": 1.605,
      "tempo": 1.1,
      "hash": "7a099cad72cb"
    },
    {
      "id": "05",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.06,
      "text": "Năm một nghìn tám trăm bốn mươi mốt, một người Anh tên James Brooke được trao vùng Sarawak.",
      "voice": "Orus",
      "src": "voiceover/p1-brunei-chia-doi/05.wav",
      "durationInSeconds": 4.817,
      "tempo": 1.1,
      "hash": "972d43f865d2"
    },
    {
      "id": "06",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.06,
      "text": "Rồi nhà Brooke cứ thế nới dần, từng mảng một.",
      "voice": "Orus",
      "src": "voiceover/p1-brunei-chia-doi/06.wav",
      "durationInSeconds": 2.639,
      "tempo": 1.1,
      "hash": "972d43f865d2"
    },
    {
      "id": "07",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.25,
      "text": "Phía bắc thì rơi vào tay một công ty Anh.",
      "voice": "Orus",
      "src": "voiceover/p1-brunei-chia-doi/07.wav",
      "durationInSeconds": 1.852,
      "tempo": 1.1,
      "hash": "972d43f865d2"
    },
    {
      "id": "08",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.06,
      "text": "Năm một nghìn tám trăm chín mươi, Rajah Charles Brooke lấy luôn vùng Limbang nằm ngay giữa.",
      "voice": "Orus",
      "src": "voiceover/p1-brunei-chia-doi/08.wav",
      "durationInSeconds": 5.328,
      "tempo": 1.1,
      "hash": "36280a61088b"
    },
    {
      "id": "09",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.25,
      "text": "Brunei bị cắt làm đôi.",
      "voice": "Orus",
      "src": "voiceover/p1-brunei-chia-doi/09.wav",
      "durationInSeconds": 1.485,
      "tempo": 1.1,
      "hash": "36280a61088b"
    },
    {
      "id": "10",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 0.06,
      "text": "Đất thì co lại, nhưng dưới chân lại có thứ khác.",
      "voice": "Orus",
      "src": "voiceover/p1-brunei-chia-doi/10.wav",
      "durationInSeconds": 2.622,
      "tempo": 1.1,
      "hash": "dbb54adecd8a"
    },
    {
      "id": "11",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 0.25,
      "text": "Năm một nghìn chín trăm hai mươi chín, Brunei tìm thấy dầu.",
      "voice": "Orus",
      "src": "voiceover/p1-brunei-chia-doi/11.wav",
      "durationInSeconds": 3.471,
      "tempo": 1.1,
      "hash": "dbb54adecd8a"
    },
    {
      "id": "12",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.06,
      "text": "Rồi người ta tính lập ra nước Malaysia, và mời Brunei về chung nhà.",
      "voice": "Orus",
      "src": "voiceover/p1-brunei-chia-doi/12.wav",
      "durationInSeconds": 4.053,
      "tempo": 1.1,
      "hash": "f83215f3f0de"
    },
    {
      "id": "13",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.15,
      "text": "Brunei có vào không?",
      "voice": "Orus",
      "src": "voiceover/p1-brunei-chia-doi/13.wav",
      "durationInSeconds": 1.138,
      "tempo": 1.1,
      "hash": "f83215f3f0de"
    },
    {
      "id": "14",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.3,
      "text": "Không.",
      "voice": "Orus",
      "src": "voiceover/p1-brunei-chia-doi/14.wav",
      "durationInSeconds": 0.325,
      "tempo": 1.1,
      "hash": "f83215f3f0de"
    },
    {
      "id": "15",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.06,
      "text": "Vì dầu.",
      "voice": "Orus",
      "src": "voiceover/p1-brunei-chia-doi/15.wav",
      "durationInSeconds": 0.735,
      "tempo": 1.1,
      "hash": "f83215f3f0de"
    },
    {
      "id": "16",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.06,
      "text": "Kuala Lumpur muốn sau mười năm, tiền dầu phải nộp về ngân sách chung.",
      "voice": "Orus",
      "src": "voiceover/p1-brunei-chia-doi/16.wav",
      "durationInSeconds": 3.878,
      "tempo": 1.1,
      "hash": "f83215f3f0de"
    },
    {
      "id": "17",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.06,
      "text": "Brunei muốn giữ cho riêng mình.",
      "voice": "Orus",
      "src": "voiceover/p1-brunei-chia-doi/17.wav",
      "durationInSeconds": 1.417,
      "tempo": 1.1,
      "hash": "f83215f3f0de"
    },
    {
      "id": "18",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.25,
      "text": "Năm một nghìn chín trăm sáu mươi ba, ở Luân Đôn, Sultan Brunei ngồi ngay bàn đàm phán, nhưng không đặt bút.",
      "voice": "Orus",
      "src": "voiceover/p1-brunei-chia-doi/18.wav",
      "durationInSeconds": 5.604,
      "tempo": 1.1,
      "hash": "f83215f3f0de"
    },
    {
      "id": "19",
      "scene": "s7",
      "take": "t07",
      "gapAfter": 0.06,
      "text": "Hôm nay, mỗi người Brunei làm ra gấp hơn hai lần rưỡi người Malaysia.",
      "voice": "Orus",
      "src": "voiceover/p1-brunei-chia-doi/19.wav",
      "durationInSeconds": 4.022,
      "tempo": 1.1,
      "hash": "06e60dd53191"
    },
    {
      "id": "20",
      "scene": "s7",
      "take": "t07",
      "gapAfter": 0.25,
      "text": "Chỉ phiền là muốn lái xe sang nửa kia đất nước, phải qua bốn trạm xuất nhập cảnh.",
      "voice": "Orus",
      "src": "voiceover/p1-brunei-chia-doi/20.wav",
      "durationInSeconds": 5.125,
      "tempo": 1.1,
      "hash": "06e60dd53191"
    },
    {
      "id": "21",
      "scene": "s8",
      "take": "t08",
      "gapAfter": 0.06,
      "text": "Năm hai nghìn hai mươi, Brunei mở một cây cầu vượt biển nối hai nửa, không phải đi qua Malaysia.",
      "voice": "Orus",
      "src": "voiceover/p1-brunei-chia-doi/21.wav",
      "durationInSeconds": 5.393,
      "tempo": 1.1,
      "hash": "bcca2c4b84bd"
    },
    {
      "id": "22",
      "scene": "s8",
      "take": "t08",
      "gapAfter": 0.06,
      "text": "Cây cầu mở cửa ngày mười bảy tháng ba.",
      "voice": "Orus",
      "src": "voiceover/p1-brunei-chia-doi/22.wav",
      "durationInSeconds": 1.721,
      "tempo": 1.1,
      "hash": "bcca2c4b84bd"
    },
    {
      "id": "23",
      "scene": "s8",
      "take": "t08",
      "gapAfter": 0.25,
      "text": "Đúng một trăm ba mươi năm, tính tới từng ngày, sau khi Brunei bị cắt làm đôi.",
      "voice": "Orus",
      "src": "voiceover/p1-brunei-chia-doi/23.wav",
      "durationInSeconds": 4.686,
      "tempo": 1.1,
      "hash": "bcca2c4b84bd"
    }
  ]
}
