  "lines": [
    {
      "id": "01",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.06,
      "text": "Có một chỗ, từ biển sang tới biên giới Lào chưa đầy năm mươi cây số.",
      "voice": "Orus",
      "src": "voiceover/p5-cho-hep-nhat/01.wav",
      "durationInSeconds": 4.192,
      "tempo": 1.1,
      "hash": "1d097cf27249"
    },
    {
      "id": "02",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.06,
      "text": "Ở đâu?",
      "voice": "Orus",
      "src": "voiceover/p5-cho-hep-nhat/02.wav",
      "durationInSeconds": 0.383,
      "tempo": 1.1,
      "hash": "1d097cf27249"
    },
    {
      "id": "03",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.25,
      "text": "Quảng Bình.",
      "voice": "Orus",
      "src": "voiceover/p5-cho-hep-nhat/03.wav",
      "durationInSeconds": 0.864,
      "tempo": 1.1,
      "hash": "1d097cf27249"
    },
    {
      "id": "04",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.06,
      "text": "Hình dung thế này: chưa đầy năm mươi cây số, gần bằng một đường chạy marathon.",
      "voice": "Orus",
      "src": "voiceover/p5-cho-hep-nhat/04.wav",
      "durationInSeconds": 4.142,
      "tempo": 1.1,
      "hash": "47d466abf9db"
    },
    {
      "id": "05",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.25,
      "text": "Sáng tắm biển, trưa đã chạm biên giới Lào, nếu đôi chân chịu nổi.",
      "voice": "Orus",
      "src": "voiceover/p5-cho-hep-nhat/05.wav",
      "durationInSeconds": 3.604,
      "tempo": 1.1,
      "hash": "47d466abf9db"
    },
    {
      "id": "06",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.06,
      "text": "Trong khi từ bắc vào nam, đất liền Việt Nam dài khoảng một nghìn sáu trăm năm mươi cây số.",
      "voice": "Orus",
      "src": "voiceover/p5-cho-hep-nhat/06.wav",
      "durationInSeconds": 4.605,
      "tempo": 1.1,
      "hash": "4ad9c56683c6"
    },
    {
      "id": "07",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.25,
      "text": "Dài gấp hơn ba mươi lần chỗ hẹp nhất.",
      "voice": "Orus",
      "src": "voiceover/p5-cho-hep-nhat/07.wav",
      "durationInSeconds": 1.993,
      "tempo": 1.1,
      "hash": "4ad9c56683c6"
    },
    {
      "id": "08",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.06,
      "text": "Thứ gì bóp eo đất này lại?",
      "voice": "Orus",
      "src": "voiceover/p5-cho-hep-nhat/08.wav",
      "durationInSeconds": 1.612,
      "tempo": 1.1,
      "hash": "b6a175f80140"
    },
    {
      "id": "09",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.06,
      "text": "Dãy Trường Sơn.",
      "voice": "Orus",
      "src": "voiceover/p5-cho-hep-nhat/09.wav",
      "durationInSeconds": 0.944,
      "tempo": 1.1,
      "hash": "b6a175f80140"
    },
    {
      "id": "10",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.06,
      "text": "Ở đây, núi chạy sát xuống gần biển, và biên giới nằm ngay trên dãy núi.",
      "voice": "Orus",
      "src": "voiceover/p5-cho-hep-nhat/10.wav",
      "durationInSeconds": 4.18,
      "tempo": 1.1,
      "hash": "b6a175f80140"
    },
    {
      "id": "11",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.25,
      "text": "Đất dốc từ tây sang đông, khoảng tám mươi lăm phần trăm là đồi núi.",
      "voice": "Orus",
      "src": "voiceover/p5-cho-hep-nhat/11.wav",
      "durationInSeconds": 3.889,
      "tempo": 1.1,
      "hash": "b6a175f80140"
    },
    {
      "id": "12",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 0.06,
      "text": "Hệ quả?",
      "voice": "Orus",
      "src": "voiceover/p5-cho-hep-nhat/12.wav",
      "durationInSeconds": 0.776,
      "tempo": 1.1,
      "hash": "ff54b8bc003a"
    },
    {
      "id": "13",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 0.06,
      "text": "Mọi con đường Bắc Nam đều phải chen qua đây.",
      "voice": "Orus",
      "src": "voiceover/p5-cho-hep-nhat/13.wav",
      "durationInSeconds": 2.237,
      "tempo": 1.1,
      "hash": "ff54b8bc003a"
    },
    {
      "id": "14",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 0.06,
      "text": "Quốc lộ, đường sắt, đường Hồ Chí Minh, cùng một cái eo.",
      "voice": "Orus",
      "src": "voiceover/p5-cho-hep-nhat/14.wav",
      "durationInSeconds": 3.432,
      "tempo": 1.1,
      "hash": "ff54b8bc003a"
    },
    {
      "id": "15",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 0.25,
      "text": "Thời chiến, cái eo ấy bị ném bom ác liệt.",
      "voice": "Orus",
      "src": "voiceover/p5-cho-hep-nhat/15.wav",
      "durationInSeconds": 2.571,
      "tempo": 1.1,
      "hash": "ff54b8bc003a"
    },
    {
      "id": "16",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.06,
      "text": "Đường đo ấy chạm biển gần Đồng Hới, cửa sông Nhật Lệ.",
      "voice": "Orus",
      "src": "voiceover/p5-cho-hep-nhat/16.wav",
      "durationInSeconds": 2.918,
      "tempo": 1.1,
      "hash": "15eac55609e7"
    },
    {
      "id": "17",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.06,
      "text": "Ở bến đò bên sông, có một bà mẹ sáu mươi tuổi vẫn chèo đò.",
      "voice": "Orus",
      "src": "voiceover/p5-cho-hep-nhat/17.wav",
      "durationInSeconds": 3.27,
      "tempo": 1.1,
      "hash": "15eac55609e7"
    },
    {
      "id": "18",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.06,
      "text": "Mẹ Suốt đưa bộ đội, thương binh, vũ khí qua sông, ngay giữa những trận bom.",
      "voice": "Orus",
      "src": "voiceover/p5-cho-hep-nhat/18.wav",
      "durationInSeconds": 4.293,
      "tempo": 1.1,
      "hash": "15eac55609e7"
    },
    {
      "id": "19",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.25,
      "text": "Năm một nghìn chín trăm sáu mươi lăm, nhà thơ Tố Hữu gặp mẹ, rồi viết một bài thơ mang tên mẹ.",
      "voice": "Orus",
      "src": "voiceover/p5-cho-hep-nhat/19.wav",
      "durationInSeconds": 5.052,
      "tempo": 1.1,
      "hash": "15eac55609e7"
    },
    {
      "id": "20",
      "scene": "s7",
      "take": "t07",
      "gapAfter": 0.06,
      "text": "Nhưng từ tháng bảy năm hai nghìn hai mươi lăm, tỉnh Quảng Bình không còn trên bản đồ hành chính.",
      "voice": "Orus",
      "src": "voiceover/p5-cho-hep-nhat/20.wav",
      "durationInSeconds": 4.237,
      "tempo": 1.1,
      "hash": "dc106ac0df74"
    },
    {
      "id": "21",
      "scene": "s7",
      "take": "t07",
      "gapAfter": 0.06,
      "text": "Quảng Bình nhập với Quảng Trị, tỉnh mới mang tên Quảng Trị.",
      "voice": "Orus",
      "src": "voiceover/p5-cho-hep-nhat/21.wav",
      "durationInSeconds": 3.077,
      "tempo": 1.1,
      "hash": "dc106ac0df74"
    },
    {
      "id": "22",
      "scene": "s7",
      "take": "t07",
      "gapAfter": 0.06,
      "text": "Oái oăm ở chỗ, tỉnh lỵ mới lại đặt ở Đồng Hới.",
      "voice": "Orus",
      "src": "voiceover/p5-cho-hep-nhat/22.wav",
      "durationInSeconds": 2.867,
      "tempo": 1.1,
      "hash": "dc106ac0df74"
    },
    {
      "id": "23",
      "scene": "s7",
      "take": "t07",
      "gapAfter": 0.25,
      "text": "Tên tỉnh có thể đổi, còn Việt Nam vẫn thắt lại ở đúng chỗ ấy.",
      "voice": "Orus",
      "src": "voiceover/p5-cho-hep-nhat/23.wav",
      "durationInSeconds": 3.533,
      "tempo": 1.1,
      "hash": "dc106ac0df74"
    }
  ]
