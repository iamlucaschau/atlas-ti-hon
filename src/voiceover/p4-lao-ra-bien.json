  "lines": [
    {
      "id": "01",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.06,
      "text": "Mười một nước Đông Nam Á, chỉ một nước không có biển.",
      "voice": "Orus",
      "src": "voiceover/p4-lao-ra-bien/01.wav",
      "durationInSeconds": 2.641,
      "tempo": 1.1,
      "hash": "0f20bbe4b735"
    },
    {
      "id": "02",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.06,
      "text": "Nước nào?",
      "voice": "Orus",
      "src": "voiceover/p4-lao-ra-bien/02.wav",
      "durationInSeconds": 0.505,
      "tempo": 1.1,
      "hash": "0f20bbe4b735"
    },
    {
      "id": "03",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.06,
      "text": "Lào.",
      "voice": "Orus",
      "src": "voiceover/p4-lao-ra-bien/03.wav",
      "durationInSeconds": 0.474,
      "tempo": 1.1,
      "hash": "0f20bbe4b735"
    },
    {
      "id": "04",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.06,
      "text": "Vậy hàng của Lào ra biển bằng cách nào?",
      "voice": "Orus",
      "src": "voiceover/p4-lao-ra-bien/04.wav",
      "durationInSeconds": 1.979,
      "tempo": 1.1,
      "hash": "0f20bbe4b735"
    },
    {
      "id": "05",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.25,
      "text": "Đi nhờ.",
      "voice": "Orus",
      "src": "voiceover/p4-lao-ra-bien/05.wav",
      "durationInSeconds": 0.569,
      "tempo": 1.1,
      "hash": "0f20bbe4b735"
    },
    {
      "id": "06",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.06,
      "text": "Lào giáp năm nước, bốn bề là đất liền.",
      "voice": "Orus",
      "src": "voiceover/p4-lao-ra-bien/06.wav",
      "durationInSeconds": 2.779,
      "tempo": 1.1,
      "hash": "df5041988aa7"
    },
    {
      "id": "07",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.25,
      "text": "Phía tây là sông Mê Kông, phía đông là dãy Trường Sơn.",
      "voice": "Orus",
      "src": "voiceover/p4-lao-ra-bien/07.wav",
      "durationInSeconds": 3.209,
      "tempo": 1.1,
      "hash": "df5041988aa7"
    },
    {
      "id": "08",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.06,
      "text": "Đi về phía tây, qua Thái Lan.",
      "voice": "Orus",
      "src": "voiceover/p4-lao-ra-bien/08.wav",
      "durationInSeconds": 1.726,
      "tempo": 1.1,
      "hash": "ad9ea4013cb7"
    },
    {
      "id": "09",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.06,
      "text": "Từ Savannakhet tới cảng Laem Chabang, hơn bảy trăm cây số.",
      "voice": "Orus",
      "src": "voiceover/p4-lao-ra-bien/09.wav",
      "durationInSeconds": 3.44,
      "tempo": 1.1,
      "hash": "ad9ea4013cb7"
    },
    {
      "id": "10",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.06,
      "text": "Từ cuối năm hai nghìn hai mươi mốt, Lào có thêm đường sắt lên Trung Quốc.",
      "voice": "Orus",
      "src": "voiceover/p4-lao-ra-bien/10.wav",
      "durationInSeconds": 3.403,
      "tempo": 1.1,
      "hash": "ad9ea4013cb7"
    },
    {
      "id": "11",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.25,
      "text": "Hơn một nghìn cây số đường ray, mà vẫn chưa thấy biển.",
      "voice": "Orus",
      "src": "voiceover/p4-lao-ra-bien/11.wav",
      "durationInSeconds": 2.873,
      "tempo": 1.1,
      "hash": "ad9ea4013cb7"
    },
    {
      "id": "12",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.06,
      "text": "Phía đông, sau dãy Trường Sơn, biển gần hơn hẳn.",
      "voice": "Orus",
      "src": "voiceover/p4-lao-ra-bien/12.wav",
      "durationInSeconds": 3.491,
      "tempo": 1.1,
      "hash": "699693b6ff3b"
    },
    {
      "id": "13",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.06,
      "text": "Từ Viêng Chăn tới cảng Vũng Áng ở Hà Tĩnh, đường chim bay chỉ khoảng bốn trăm cây số.",
      "voice": "Orus",
      "src": "voiceover/p4-lao-ra-bien/13.wav",
      "durationInSeconds": 4.842,
      "tempo": 1.1,
      "hash": "699693b6ff3b"
    },
    {
      "id": "14",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.25,
      "text": "Qua cửa khẩu, đi thêm hơn một trăm cây số là tới cảng.",
      "voice": "Orus",
      "src": "voiceover/p4-lao-ra-bien/14.wav",
      "durationInSeconds": 2.705,
      "tempo": 1.1,
      "hash": "699693b6ff3b"
    },
    {
      "id": "15",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 0.06,
      "text": "Năm hai nghìn hai mươi tư, kali và quặng sắt của Lào nối đuôi nhau ra đây.",
      "voice": "Orus",
      "src": "voiceover/p4-lao-ra-bien/15.wav",
      "durationInSeconds": 3.502,
      "tempo": 1.1,
      "hash": "8b036928e70a"
    },
    {
      "id": "16",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 0.06,
      "text": "Cả cảng thông qua hơn năm triệu tấn hàng.",
      "voice": "Orus",
      "src": "voiceover/p4-lao-ra-bien/16.wav",
      "durationInSeconds": 2.172,
      "tempo": 1.1,
      "hash": "8b036928e70a"
    },
    {
      "id": "17",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 0.25,
      "text": "Khoảng một phần ba là hàng của Lào.",
      "voice": "Orus",
      "src": "voiceover/p4-lao-ra-bien/17.wav",
      "durationInSeconds": 1.528,
      "tempo": 1.1,
      "hash": "8b036928e70a"
    },
    {
      "id": "18",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.06,
      "text": "Và cú ngược đời?",
      "voice": "Orus",
      "src": "voiceover/p4-lao-ra-bien/18.wav",
      "durationInSeconds": 0.995,
      "tempo": 1.1,
      "hash": "797a24f41da1"
    },
    {
      "id": "19",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.06,
      "text": "Chủ cảng.",
      "voice": "Orus",
      "src": "voiceover/p4-lao-ra-bien/19.wav",
      "durationInSeconds": 0.695,
      "tempo": 1.1,
      "hash": "797a24f41da1"
    },
    {
      "id": "20",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.06,
      "text": "Phía Lào nắm sáu mươi phần trăm công ty khai thác cảng.",
      "voice": "Orus",
      "src": "voiceover/p4-lao-ra-bien/20.wav",
      "durationInSeconds": 2.112,
      "tempo": 1.1,
      "hash": "797a24f41da1"
    },
    {
      "id": "21",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.25,
      "text": "Tháng tư năm hai nghìn hai mươi lăm, Tổng Bí thư, Chủ tịch nước Lào Thongloun Sisoulith tới tận Vũng Áng, dự khánh thành một bến mới.",
      "voice": "Orus",
      "src": "voiceover/p4-lao-ra-bien/21.wav",
      "durationInSeconds": 6.888,
      "tempo": 1.1,
      "hash": "797a24f41da1"
    },
    {
      "id": "22",
      "scene": "s7",
      "take": "t07",
      "gapAfter": 0.06,
      "text": "Và Lào còn muốn đi xa hơn.",
      "voice": "Orus",
      "src": "voiceover/p4-lao-ra-bien/22.wav",
      "durationInSeconds": 1.538,
      "tempo": 1.1,
      "hash": "3efa8247818e"
    },
    {
      "id": "23",
      "scene": "s7",
      "take": "t07",
      "gapAfter": 0.06,
      "text": "Một tuyến đường sắt hơn năm trăm năm mươi cây số đang được tính, nối thẳng Viêng Chăn ra Vũng Áng.",
      "voice": "Orus",
      "src": "voiceover/p4-lao-ra-bien/23.wav",
      "durationInSeconds": 4.96,
      "tempo": 1.1,
      "hash": "3efa8247818e"
    },
    {
      "id": "24",
      "scene": "s7",
      "take": "t07",
      "gapAfter": 0.06,
      "text": "Tuyến này còn đang nghiên cứu, chưa xây.",
      "voice": "Orus",
      "src": "voiceover/p4-lao-ra-bien/24.wav",
      "durationInSeconds": 1.753,
      "tempo": 1.1,
      "hash": "3efa8247818e"
    },
    {
      "id": "25",
      "scene": "s7",
      "take": "t07",
      "gapAfter": 0.25,
      "text": "Không có biển, Lào đi tìm biển, và tìm thấy một cửa ở Hà Tĩnh.",
      "voice": "Orus",
      "src": "voiceover/p4-lao-ra-bien/25.wav",
      "durationInSeconds": 3.869,
      "tempo": 1.1,
      "hash": "3efa8247818e"
    }
  ]
