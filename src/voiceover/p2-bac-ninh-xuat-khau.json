      "src": "voiceover/p2-bac-ninh-xuat-khau/17.wav",
      "durationInSeconds": 2.311,
      "tempo": 1.1,
      "hash": "8d4f081bd681"
    },
    {
      "id": "18",
      "scene": "s7",
      "take": "t07",
      "gapAfter": 0.25,
      "text": "Nhưng trong một trăm bảy mươi sáu nhà cung cấp chính của Samsung ở đây, chỉ mười hai là doanh nghiệp Việt.",
      "voice": "Orus",
      "src": "voiceover/p2-bac-ninh-xuat-khau/18.wav",
      "durationInSeconds": 4.65,
      "tempo": 1.1,
      "hash": "8d4f081bd681"
    },
    {
      "id": "19",
      "scene": "s8",
      "take": "t08",
      "gapAfter": 0.06,
      "text": "Còn chuyện thú vị nhất nằm trên bản đồ.",
      "voice": "Orus",
      "src": "voiceover/p2-bac-ninh-xuat-khau/19.wav",
      "durationInSeconds": 2.061,
      "tempo": 1.1,
      "hash": "e4196f324f87"
    },
    {
      "id": "20",
      "scene": "s8",
      "take": "t08",
      "gapAfter": 0.06,
      "text": "Năm một nghìn chín trăm chín mươi bảy, tỉnh Hà Bắc tách đôi thành Bắc Ninh và Bắc Giang.",
      "voice": "Orus",
      "src": "voiceover/p2-bac-ninh-xuat-khau/20.wav",
      "durationInSeconds": 4.301,
      "tempo": 1.1,
      "hash": "e4196f324f87"
    },
    {
      "id": "21",
      "scene": "s8",
      "take": "t08",
      "gapAfter": 0.06,
      "text": "Hai mươi tám năm sau, hai nửa về lại một nhà.",
