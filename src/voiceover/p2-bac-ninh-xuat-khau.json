      "durationInSeconds": 2.862,
      "tempo": 1.1,
      "hash": "e4196f324f87"
    },
    {
      "id": "22",
      "scene": "s8",
      "take": "t08",
      "gapAfter": 0.25,
      "text": "Tách ra là tỉnh nhỏ nhất, gộp lại thành nơi xuất khẩu nhiều nhất.",
