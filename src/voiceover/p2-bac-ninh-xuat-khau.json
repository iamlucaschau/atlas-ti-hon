    {
      "id": "01",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.06,
      "text": "Trước khi gộp tỉnh, Bắc Ninh nhỏ nhất nước, không biển, chưa có sân bay.",
      "voice": "Orus",
      "src": "voiceover/p2-bac-ninh-xuat-khau/01.wav",
      "durationInSeconds": 4.581,
      "tempo": 1.1,
      "hash": "eb18f1604b99"
    },
    {
      "id": "02",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.06,
      "text": "Vậy mà năm hai nghìn hai mươi lăm, Bắc Ninh xuất khẩu vượt cả Thành phố Hồ Chí Minh.",
      "voice": "Orus",
      "src": "voiceover/p2-bac-ninh-xuat-khau/02.wav",
      "durationInSeconds": 4.499,
      "tempo": 1.1,
      "hash": "eb18f1604b99"
    },
    {
      "id": "03",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.15,
      "text": "Hàng gì?",
      "voice": "Orus",
      "src": "voiceover/p2-bac-ninh-xuat-khau/03.wav",
      "durationInSeconds": 0.57,
      "tempo": 1.1,
      "hash": "eb18f1604b99"
    },
    {
      "id": "04",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.6,
      "text": "Điện thoại.",
      "voice": "Orus",
      "src": "voiceover/p2-bac-ninh-xuat-khau/04.wav",
      "durationInSeconds": 0.582,
      "tempo": 1.1,
      "hash": "eb18f1604b99"
    },
    {
      "id": "05",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.06,
      "text": "Năm hai nghìn lẻ tám, Samsung xin xây nhà máy điện thoại ở Yên Phong.",
      "voice": "Orus",
      "src": "voiceover/p2-bac-ninh-xuat-khau/05.wav",
      "durationInSeconds": 3.69,
      "tempo": 1.1,
      "hash": "c7d9357ceefd"
    },
    {
      "id": "06",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.25,
      "text": "Ông Nguyễn Quang Thanh, cán bộ tỉnh, nói với hãng tin AP: đủ giấy là cấp phép ngay.",
      "voice": "Orus",
      "src": "voiceover/p2-bac-ninh-xuat-khau/06.wav",
      "durationInSeconds": 4.933,
      "tempo": 1.1,
      "hash": "c7d9357ceefd"
    },
    {
      "id": "07",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.06,
      "text": "Vì đâu?",
      "voice": "Orus",
      "src": "voiceover/p2-bac-ninh-xuat-khau/07.wav",
      "durationInSeconds": 0.57,
      "tempo": 1.1,
      "hash": "20b3dbd5545c"
    },
    {
      "id": "08",
      "scene": "s3",
      "take": "t03a",
      "gapAfter": 0.06,
      "text": "Vị trí.",
      "voice": "Orus",
      "src": "voiceover/p2-bac-ninh-xuat-khau/08.wav",
      "durationInSeconds": 0.451,
      "tempo": 1.1,
      "hash": "1b1d06a551a8"
    },
    {
      "id": "09",
      "scene": "s3",
      "take": "t03b",
      "gapAfter": 0.25,
      "text": "Nội Bài ngay sát bên, cảng Hải Phòng phía đông, biên giới Trung Quốc phía bắc.",
      "voice": "Orus",
      "src": "voiceover/p2-bac-ninh-xuat-khau/09.wav",
      "durationInSeconds": 4.41,
      "tempo": 1.1,
      "hash": "e0cf0633c519"
    },
    {
      "id": "10",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.25,
      "who": "bacninh",
      "text": "Đất em nhỏ thật, nhưng đi đâu cũng gần nha!",
      "voice": "Aoede",
      "src": "voiceover/p2-bac-ninh-xuat-khau/10.wav",
      "durationInSeconds": 2.894,
      "tempo": 1.1,
      "hash": "f1539d1abb12"
    },
    {
      "id": "11",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 0.25,
      "text": "Điện thoại nhẹ mà đắt, chở máy bay là vừa.",
      "voice": "Orus",
      "src": "voiceover/p2-bac-ninh-xuat-khau/11.wav",
      "durationInSeconds": 2.806,
      "tempo": 1.1,
      "hash": "de7d97956784"
    },
    {
      "id": "12",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.06,
      "text": "Tháng bảy năm hai nghìn hai mươi lăm, Bắc Ninh gộp Bắc Giang, cũng đầy nhà máy.",
      "voice": "Orus",
      "src": "voiceover/p2-bac-ninh-xuat-khau/12.wav",
      "durationInSeconds": 3.738,
      "tempo": 1.1,
      "hash": "e3ad4a02b867"
    },
    {
      "id": "13",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.06,
      "text": "Nhưng Thành phố Hồ Chí Minh cũng gộp Bình Dương, Bà Rịa Vũng Tàu.",
      "voice": "Orus",
      "src": "voiceover/p2-bac-ninh-xuat-khau/13.wav",
      "durationInSeconds": 2.785,
      "tempo": 1.1,
      "hash": "e3ad4a02b867"
    },
    {
      "id": "14",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.06,
      "text": "Tính trên địa giới mới, phải tới tháng mười, Bắc Ninh mới vượt.",
      "voice": "Orus",
      "src": "voiceover/p2-bac-ninh-xuat-khau/14.wav",
      "durationInSeconds": 3.119,
      "tempo": 1.1,
      "hash": "e3ad4a02b867"
    },
    {
      "id": "15",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.06,
      "text": "Cả năm, Bắc Ninh hơn chín mươi ba tỷ đô, nhỉnh hơn chút xíu.",
      "voice": "Orus",
      "src": "voiceover/p2-bac-ninh-xuat-khau/15.wav",
      "durationInSeconds": 3.582,
      "tempo": 1.1,
      "hash": "e3ad4a02b867"
    },
    {
      "id": "16",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.25,
      "text": "Sát nút như hai xe máy cùng cán vạch.",
      "voice": "Orus",
      "src": "voiceover/p2-bac-ninh-xuat-khau/16.wav",
      "durationInSeconds": 2.14,
      "tempo": 1.1,
      "hash": "e3ad4a02b867"
    },
    {
      "id": "17",
      "scene": "s7",
      "take": "t07",
      "gapAfter": 0.06,
      "text": "Tỉnh gọi đây là trung tâm xuất khẩu của cả nước.",
