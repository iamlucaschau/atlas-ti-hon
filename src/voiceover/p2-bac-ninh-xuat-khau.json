{
  "name": "p2-bac-ninh-xuat-khau",
  "model": "gemini-3.8-flash-tts",
  "totalSeconds": 66.122,
  "lines": [
    {
      "id": "01",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.15,
      "text": "Năm hai nghìn hai mươi lăm, nơi xuất khẩu nhiều nhất Việt Nam không phải TP.HCM, mà là Bắc Ninh.",
      "voice": "Orus",
      "src": "voiceover/p2-bac-ninh-xuat-khau/01.wav",
      "durationInSeconds": 6.174,
      "tempo": 1.1,
      "hash": "99d6abfbd8ea"
    },
    {
      "id": "02",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.15,
      "text": "Hơn chín mươi ba tỷ đô.",
      "voice": "Orus",
      "src": "voiceover/p2-bac-ninh-xuat-khau/02.wav",
      "durationInSeconds": 1.678,
      "tempo": 1.1,
      "hash": "99d6abfbd8ea"
    },
    {
      "id": "03",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.15,
      "text": "Hàng gì?",
      "voice": "Orus",
      "src": "voiceover/p2-bac-ninh-xuat-khau/03.wav",
      "durationInSeconds": 0.478,
      "tempo": 1.1,
      "hash": "99d6abfbd8ea"
    },
    {
      "id": "04",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.6,
      "text": "Điện thoại.",
      "voice": "Orus",
      "src": "voiceover/p2-bac-ninh-xuat-khau/04.wav",
      "durationInSeconds": 0.764,
      "tempo": 1.1,
      "hash": "99d6abfbd8ea"
    },
    {
      "id": "05",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.15,
      "text": "Năm hai nghìn lẻ tám, ông Nguyễn Quang Thanh, Sở Kế hoạch và Đầu tư Bắc Ninh, nói: Samsung chỉ còn thiếu vài giấy tờ, đủ giấy là cấp phép ngay.",
      "voice": "Orus",
      "src": "voiceover/p2-bac-ninh-xuat-khau/05.wav",
      "durationInSeconds": 8.189,
      "tempo": 1.1,
      "hash": "a7a04da919ce"
    },
    {
      "id": "06",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.6,
      "text": "Dự án đầu tiên vào Yên Phong, sáu trăm bảy mươi triệu đô.",
      "voice": "Orus",
      "src": "voiceover/p2-bac-ninh-xuat-khau/06.wav",
      "durationInSeconds": 2.878,
      "tempo": 1.1,
      "hash": "a7a04da919ce"
    },
    {
      "id": "07",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.15,
      "text": "Chọn Bắc Ninh vì đâu?",
      "voice": "Orus",
      "src": "voiceover/p2-bac-ninh-xuat-khau/07.wav",
      "durationInSeconds": 1.029,
      "tempo": 1.1,
      "hash": "36f2fcb43052"
    },
    {
      "id": "08",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.15,
      "text": "Sân bay.",
      "voice": "Orus",
      "src": "voiceover/p2-bac-ninh-xuat-khau/08.wav",
      "durationInSeconds": 0.65,
      "tempo": 1.1,
      "hash": "36f2fcb43052"
    },
    {
      "id": "09",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.15,
      "text": "Từ Yên Phong tới Nội Bài, đường chim bay chưa tới hai mươi cây số.",
      "voice": "Orus",
      "src": "voiceover/p2-bac-ninh-xuat-khau/09.wav",
      "durationInSeconds": 3.185,
      "tempo": 1.1,
      "hash": "36f2fcb43052"
    },
    {
      "id": "10",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.6,
      "text": "Có lúc, riêng Samsung chiếm hơn một phần ba hàng hoá qua sân bay này.",
      "voice": "Orus",
      "src": "voiceover/p2-bac-ninh-xuat-khau/10.wav",
      "durationInSeconds": 3.217,
      "tempo": 1.1,
      "hash": "36f2fcb43052"
    },
    {
      "id": "11",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.15,
      "text": "Năm hai nghìn hai mươi lăm, Bắc Ninh nhập thêm Bắc Giang, cũng đầy nhà máy.",
      "voice": "Orus",
      "src": "voiceover/p2-bac-ninh-xuat-khau/11.wav",
      "durationInSeconds": 4.169,
      "tempo": 1.1,
      "hash": "015c41b4b542"
    },
    {
      "id": "12",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.15,
      "text": "TP.HCM thì nhập Bình Dương và Bà Rịa Vũng Tàu.",
      "voice": "Orus",
      "src": "voiceover/p2-bac-ninh-xuat-khau/12.wav",
      "durationInSeconds": 2.516,
      "tempo": 1.1,
      "hash": "015c41b4b542"
    },
    {
      "id": "13",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.15,
      "text": "Năm trước đó, TP.HCM mới vẫn dẫn khá xa.",
      "voice": "Orus",
      "src": "voiceover/p2-bac-ninh-xuat-khau/13.wav",
      "durationInSeconds": 2.922,
      "tempo": 1.1,
      "hash": "015c41b4b542"
    },
    {
      "id": "14",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.15,
      "text": "Phải tới tháng mười, Bắc Ninh mới vượt, hơn chừng một trăm triệu đô.",
      "voice": "Orus",
      "src": "voiceover/p2-bac-ninh-xuat-khau/14.wav",
      "durationInSeconds": 3.314,
      "tempo": 1.1,
      "hash": "015c41b4b542"
    },
    {
      "id": "15",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.6,
      "text": "Sát nút như hai xe máy cùng cán vạch.",
      "voice": "Orus",
      "src": "voiceover/p2-bac-ninh-xuat-khau/15.wav",
      "durationInSeconds": 1.83,
      "tempo": 1.1,
      "hash": "015c41b4b542"
    },
    {
      "id": "16",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 0.15,
      "text": "Tỉnh gọi đây là trung tâm xuất khẩu lớn của cả nước.",
      "voice": "Orus",
      "src": "voiceover/p2-bac-ninh-xuat-khau/16.wav",
      "durationInSeconds": 2.271,
      "tempo": 1.1,
      "hash": "1a4650ee984a"
    },
    {
      "id": "17",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 0.6,
      "text": "Nhưng trong một trăm bảy mươi sáu nhà cung cấp chính của Samsung ở đây, chỉ mười hai là doanh nghiệp Việt.",
      "voice": "Orus",
      "src": "voiceover/p2-bac-ninh-xuat-khau/17.wav",
      "durationInSeconds": 4.895,
      "tempo": 1.1,
      "hash": "1a4650ee984a"
    },
    {
      "id": "18",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.15,
      "text": "Oái oăm ở chỗ: chín tháng năm nay, Bắc Ninh nhập về còn nhiều hơn xuất.",
      "voice": "Orus",
      "src": "voiceover/p2-bac-ninh-xuat-khau/18.wav",
      "durationInSeconds": 4.305,
      "tempo": 1.1,
      "hash": "4798761e8123"
    },
    {
      "id": "19",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.15,
      "text": "Riêng điện thoại và linh kiện: nhập gần năm mươi bảy tỷ, xuất hơn năm mươi lăm.",
      "voice": "Orus",
      "src": "voiceover/p2-bac-ninh-xuat-khau/19.wav",
      "durationInSeconds": 3.896,
      "tempo": 1.1,
      "hash": "4798761e8123"
    },
    {
      "id": "20",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.15,
      "text": "Tỉnh giải thích: nhà máy đang nhập máy móc, linh kiện để mở rộng.",
      "voice": "Orus",
      "src": "voiceover/p2-bac-ninh-xuat-khau/20.wav",
      "durationInSeconds": 3.185,
      "tempo": 1.1,
      "hash": "4798761e8123"
    },
    {
      "id": "21",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.6,
      "text": "Đứng đầu rồi, cuộc đua tiếp theo là giữ lại nhiều hơn trong mỗi chiếc điện thoại.",
      "voice": "Orus",
      "src": "voiceover/p2-bac-ninh-xuat-khau/21.wav",
      "durationInSeconds": 4.577,
      "tempo": 1.1,
      "hash": "4798761e8123"
    }
  ]
}
