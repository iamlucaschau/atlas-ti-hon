    {
      "id": "01",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.06,
      "text": "Phú Quốc cách bờ Campuchia chừng mười cây số.",
      "voice": "Orus",
      "src": "voiceover/p1-phu-quoc-brevie/01.wav",
      "durationInSeconds": 2.75,
      "tempo": 1.1,
      "hash": "bef6a9a23cde"
    },
    {
      "id": "02",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.06,
      "text": "Còn về tới Hà Tiên thì xa gấp bốn lần.",
      "voice": "Orus",
      "src": "voiceover/p1-phu-quoc-brevie/02.wav",
      "durationInSeconds": 2.235,
      "tempo": 1.1,
      "hash": "bef6a9a23cde"
    },
    {
      "id": "03",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.06,
      "text": "Vậy sao đảo lại thuộc Việt Nam?",
      "voice": "Orus",
      "src": "voiceover/p1-phu-quoc-brevie/03.wav",
      "durationInSeconds": 1.374,
      "tempo": 1.1,
      "hash": "bef6a9a23cde"
    },
    {
      "id": "04",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.06,
      "text": "Câu trả lời?",
      "voice": "Orus",
      "src": "voiceover/p1-phu-quoc-brevie/04.wav",
      "durationInSeconds": 0.597,
      "tempo": 1.1,
      "hash": "bef6a9a23cde"
    },
    {
      "id": "05",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.25,
      "text": "Một đường kẻ.",
      "voice": "Orus",
      "src": "voiceover/p1-phu-quoc-brevie/05.wav",
      "durationInSeconds": 0.821,
      "tempo": 1.1,
      "hash": "bef6a9a23cde"
    },
    {
      "id": "06",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.06,
      "text": "Đầu thế kỷ mười tám, Mạc Cửu cai quản vùng Hà Tiên, gồm cả đảo Phú Quốc.",
      "voice": "Orus",
      "src": "voiceover/p1-phu-quoc-brevie/06.wav",
      "durationInSeconds": 4.791,
      "tempo": 1.1,
      "hash": "355fee38bee6"
    },
    {
      "id": "07",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.25,
      "text": "Năm một nghìn bảy trăm lẻ tám, ông đưa cả vùng đất này về với chúa Nguyễn.",
      "voice": "Orus",
      "src": "voiceover/p1-phu-quoc-brevie/07.wav",
      "durationInSeconds": 3.867,
      "tempo": 1.1,
      "hash": "355fee38bee6"
    },
    {
      "id": "08",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.06,
      "text": "Năm một nghìn tám trăm sáu mươi bảy, Pháp chiếm Hà Tiên, Phú Quốc thành một phần của Nam Kỳ.",
      "voice": "Orus",
      "src": "voiceover/p1-phu-quoc-brevie/08.wav",
      "durationInSeconds": 4.976,
      "tempo": 1.1,
      "hash": "7198be74cd31"
    },
    {
      "id": "09",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.06,
      "text": "Campuchia bên cạnh cũng nằm dưới quyền Pháp.",
      "voice": "Orus",
      "src": "voiceover/p1-phu-quoc-brevie/09.wav",
      "durationInSeconds": 2.284,
      "tempo": 1.1,
      "hash": "7198be74cd31"
    },
    {
      "id": "10",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.25,
      "text": "Vậy đảo ngoài khơi giao cho bên nào?",
      "voice": "Orus",
      "src": "voiceover/p1-phu-quoc-brevie/10.wav",
      "durationInSeconds": 2.474,
      "tempo": 1.1,
      "hash": "7198be74cd31"
    },
    {
      "id": "11",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.06,
      "text": "Năm một nghìn chín trăm ba mươi chín, Toàn quyền Đông Dương Jules Brévié gửi đi một lá thư.",
      "voice": "Orus",
      "src": "voiceover/p1-phu-quoc-brevie/11.wav",
      "durationInSeconds": 4.756,
      "tempo": 1.1,
      "hash": "e40662cfb880"
    },
    {
      "id": "12",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.06,
      "text": "Ông kẻ một đường thẳng trên biển.",
      "voice": "Orus",
      "src": "voiceover/p1-phu-quoc-brevie/12.wav",
      "durationInSeconds": 1.649,
      "tempo": 1.1,
      "hash": "e40662cfb880"
    },
    {
      "id": "13",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.06,
      "text": "Đảo phía bắc đường giao Campuchia, đảo phía nam giao Nam Kỳ.",
      "voice": "Orus",
      "src": "voiceover/p1-phu-quoc-brevie/13.wav",
      "durationInSeconds": 3.136,
      "tempo": 1.1,
      "hash": "e40662cfb880"
    },
    {
      "id": "14",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.06,
      "text": "Tới gần Phú Quốc, đường kẻ bẻ cong, vòng qua mũi bắc đảo, chừa đúng ba cây số.",
      "voice": "Orus",
      "src": "voiceover/p1-phu-quoc-brevie/14.wav",
      "durationInSeconds": 4.459,
      "tempo": 1.1,
      "hash": "e40662cfb880"
    },
    {
      "id": "15",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.06,
      "text": "Một nét bút vòng nhẹ, cả hòn đảo nằm trọn phía nam.",
      "voice": "Orus",
      "src": "voiceover/p1-phu-quoc-brevie/15.wav",
      "durationInSeconds": 2.712,
      "tempo": 1.1,
      "hash": "e40662cfb880"
    },
    {
      "id": "16",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.25,
      "text": "Ông còn ghi rõ: đường này chỉ để quản lý hành chính và cảnh sát.",
      "voice": "Orus",
      "src": "voiceover/p1-phu-quoc-brevie/16.wav",
      "durationInSeconds": 3.093,
      "tempo": 1.1,
      "hash": "e40662cfb880"
    },
    {
      "id": "17",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 0.06,
      "text": "Năm một nghìn chín trăm tám mươi hai, Việt Nam và Campuchia ký hiệp định vùng nước lịch sử.",
      "voice": "Orus",
      "src": "voiceover/p1-phu-quoc-brevie/17.wav",
      "durationInSeconds": 4.478,
      "tempo": 1.1,
      "hash": "532f35d98348"
    },
    {
      "id": "18",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 0.06,
      "text": "Hai nước dùng đúng đường kẻ ấy để chia đảo, vùng nước quanh đó thì cùng tuần tra.",
      "voice": "Orus",
      "src": "voiceover/p1-phu-quoc-brevie/18.wav",
      "durationInSeconds": 4.258,
      "tempo": 1.1,
      "hash": "532f35d98348"
    },
    {
      "id": "19",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 0.25,
      "text": "Từ năm hai nghìn hai mươi lăm, Phú Quốc là một đặc khu của Việt Nam.",
      "voice": "Orus",
      "src": "voiceover/p1-phu-quoc-brevie/19.wav",
      "durationInSeconds": 3.999,
      "tempo": 1.1,
      "hash": "532f35d98348"
    },
    {
      "id": "20",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.06,
      "text": "Nhưng chi tiết lạ nhất là: đường kẻ ấy chia được đảo, mà đường biên trên biển ở đây đến nay vẫn chưa được vạch.",
      "voice": "Orus",
      "src": "voiceover/p1-phu-quoc-brevie/20.wav",
      "durationInSeconds": 6.415,
      "tempo": 1.1,
      "hash": "6eb3021e441c"
    },
    {
      "id": "21",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.25,
      "text": "Một nét bút đã giữ hòn đảo lại, còn mặt biển quanh nó vẫn đang chờ một đường kẻ mới.",
      "voice": "Orus",
      "src": "voiceover/p1-phu-quoc-brevie/21.wav",
      "durationInSeconds": 4.658,
      "tempo": 1.1,
      "hash": "6eb3021e441c"
    }
  ]
