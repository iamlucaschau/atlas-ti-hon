{
  "name": "p1-thuy-si-linh-thue",
  "model": "gemini-3.8-flash-tts",
  "totalSeconds": 64.713,
  "lines": [
    {
      "id": "01",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.15,
      "text": "Không biển, gần như không tài nguyên, phần lớn là núi.",
      "voice": "Orus",
      "src": "voiceover/p1-thuy-si-linh-thue/01.wav",
      "durationInSeconds": 3.178,
      "tempo": 1.1,
      "hash": "f88ef3b20f8f"
    },
    {
      "id": "02",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.15,
      "text": "Thế mà nay, người Thụy Sĩ làm ra gấp khoảng hai mươi hai lần người Việt Nam.",
      "voice": "Orus",
      "src": "voiceover/p1-thuy-si-linh-thue/02.wav",
      "durationInSeconds": 3.549,
      "tempo": 1.1,
      "hash": "f88ef3b20f8f"
    },
    {
      "id": "03",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.15,
      "text": "Thứ họ đưa ra nước ngoài nhiều nhất là gì?",
      "voice": "Orus",
      "src": "voiceover/p1-thuy-si-linh-thue/03.wav",
      "durationInSeconds": 1.685,
      "tempo": 1.1,
      "hash": "f88ef3b20f8f"
    },
    {
      "id": "04",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.6,
      "text": "Lính.",
      "voice": "Orus",
      "src": "voiceover/p1-thuy-si-linh-thue/04.wav",
      "durationInSeconds": 0.391,
      "tempo": 1.1,
      "hash": "f88ef3b20f8f"
    },
    {
      "id": "05",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.15,
      "text": "Suốt mấy trăm năm, các bang cho vua chúa châu Âu thuê lính.",
      "voice": "Orus",
      "src": "voiceover/p1-thuy-si-linh-thue/05.wav",
      "durationInSeconds": 3.282,
      "tempo": 1.1,
      "hash": "efb36be0d459"
    },
    {
      "id": "06",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.15,
      "text": "Ước tính một triệu rưỡi người đã đi.",
      "voice": "Orus",
      "src": "voiceover/p1-thuy-si-linh-thue/06.wav",
      "durationInSeconds": 1.963,
      "tempo": 1.1,
      "hash": "efb36be0d459"
    },
    {
      "id": "07",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.15,
      "text": "Người Pháp có câu: không tiền, không lính Thụy Sĩ.",
      "voice": "Orus",
      "src": "voiceover/p1-thuy-si-linh-thue/07.wav",
      "durationInSeconds": 2.998,
      "tempo": 1.1,
      "hash": "efb36be0d459"
    },
    {
      "id": "08",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.15,
      "text": "Nghe như khẩu hiệu tuyển dụng.",
      "voice": "Orus",
      "src": "voiceover/p1-thuy-si-linh-thue/08.wav",
      "durationInSeconds": 1.442,
      "tempo": 1.1,
      "hash": "efb36be0d459"
    },
    {
      "id": "09",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.6,
      "text": "Theo một sử gia, máu phiêu lưu và chiến lợi phẩm hút người hơn cả cái đói.",
      "voice": "Orus",
      "src": "voiceover/p1-thuy-si-linh-thue/09.wav",
      "durationInSeconds": 3.881,
      "tempo": 1.1,
      "hash": "efb36be0d459"
    },
    {
      "id": "10",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.15,
      "text": "Năm một nghìn năm trăm linh sáu, Kaspar von Silenen dẫn lính Thụy Sĩ vào Rome gác cho Giáo hoàng.",
      "voice": "Orus",
      "src": "voiceover/p1-thuy-si-linh-thue/10.wav",
      "durationInSeconds": 5.67,
      "tempo": 1.1,
      "hash": "4c5ce8e3fb06"
    },
    {
      "id": "11",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.06,
      "text": "Chín năm sau, thua ở Marignano, thường được coi là khởi đầu trung lập.",
      "voice": "Orus",
      "src": "voiceover/p1-thuy-si-linh-thue/11.wav",
      "durationInSeconds": 3.879,
      "tempo": 1.1,
      "hash": "4c5ce8e3fb06"
    },
    {
      "id": "12",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.06,
      "text": "Mục sư Zwingli giảng rằng tiền lính làm hư người.",
      "voice": "Orus",
      "src": "voiceover/p1-thuy-si-linh-thue/12.wav",
      "durationInSeconds": 2.768,
      "tempo": 1.1,
      "hash": "4c5ce8e3fb06"
    },
    {
      "id": "13",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.06,
      "text": "Zürich cấm mộ lính, các bang khác nổi giận.",
      "voice": "Orus",
      "src": "voiceover/p1-thuy-si-linh-thue/13.wav",
      "durationInSeconds": 2.324,
      "tempo": 1.1,
      "hash": "4c5ce8e3fb06"
    },
    {
      "id": "14",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.25,
      "text": "Năm một nghìn tám trăm mười lăm, châu Âu công nhận Thụy Sĩ trung lập.",
      "voice": "Orus",
      "src": "voiceover/p1-thuy-si-linh-thue/14.wav",
      "durationInSeconds": 2.808,
      "tempo": 1.1,
      "hash": "4c5ce8e3fb06"
    },
    {
      "id": "15",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.06,
      "text": "Vậy họ giàu lên nhờ đâu?",
      "voice": "Orus",
      "src": "voiceover/p1-thuy-si-linh-thue/15.wav",
      "durationInSeconds": 1.336,
      "tempo": 1.1,
      "hash": "9fbbb630218f"
    },
    {
      "id": "16",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.06,
      "text": "Tay nghề.",
      "voice": "Orus",
      "src": "voiceover/p1-thuy-si-linh-thue/16.wav",
      "durationInSeconds": 0.836,
      "tempo": 1.1,
      "hash": "9fbbb630218f"
    },
    {
      "id": "17",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.06,
      "text": "Ngân hàng chỉ là một phần.",
      "voice": "Orus",
      "src": "voiceover/p1-thuy-si-linh-thue/17.wav",
      "durationInSeconds": 1.047,
      "tempo": 1.1,
      "hash": "9fbbb630218f"
    },
    {
      "id": "18",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.06,
      "text": "Ở Genève, luật cấm đeo trang sức đẩy thợ kim hoàn sang làm đồng hồ.",
      "voice": "Orus",
      "src": "voiceover/p1-thuy-si-linh-thue/18.wav",
      "durationInSeconds": 3.576,
      "tempo": 1.1,
      "hash": "9fbbb630218f"
    },
    {
      "id": "19",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.06,
      "text": "Rồi thợ giỏi từ Pháp chạy nạn sang.",
      "voice": "Orus",
      "src": "voiceover/p1-thuy-si-linh-thue/19.wav",
      "durationInSeconds": 1.859,
      "tempo": 1.1,
      "hash": "9fbbb630218f"
    },
    {
      "id": "20",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.06,
      "text": "Nước trung lập ấy còn là nơi ra đời Hội Chữ thập đỏ.",
      "voice": "Orus",
      "src": "voiceover/p1-thuy-si-linh-thue/20.wav",
      "durationInSeconds": 2.41,
      "tempo": 1.1,
      "hash": "9fbbb630218f"
    },
    {
      "id": "21",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.25,
      "text": "Từ cho thuê lính, họ chuyển sang bán đồng hồ, máy chính xác, thuốc men.",
      "voice": "Orus",
      "src": "voiceover/p1-thuy-si-linh-thue/21.wav",
      "durationInSeconds": 3.831,
      "tempo": 1.1,
      "hash": "9fbbb630218f"
    },
    {
      "id": "22",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 0.06,
      "text": "Còn lính Thụy Sĩ thì sao?",
      "voice": "Orus",
      "src": "voiceover/p1-thuy-si-linh-thue/22.wav",
      "durationInSeconds": 1.472,
      "tempo": 1.1,
      "hash": "810c5db11852"
    },
    {
      "id": "23",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 0.06,
      "text": "Vẫn còn.",
      "voice": "Orus",
      "src": "voiceover/p1-thuy-si-linh-thue/23.wav",
      "durationInSeconds": 0.398,
      "tempo": 1.1,
      "hash": "810c5db11852"
    },
    {
      "id": "24",
      "scene": "s5",
      "take": "t06",
      "gapAfter": 0.06,
      "text": "Đội cận vệ năm ấy vẫn gác cho Giáo hoàng tới hôm nay.",
      "voice": "Orus",
      "src": "voiceover/p1-thuy-si-linh-thue/24.wav",
      "durationInSeconds": 3.007,
      "tempo": 1.1,
      "hash": "6c9937810374"
    },
    {
      "id": "25",
      "scene": "s5",
      "take": "t06",
      "gapAfter": 0.25,
      "text": "Từng cho cả châu Âu thuê lính, nay chỉ còn một đội, gác nước nhỏ nhất thế giới.",
      "voice": "Orus",
      "src": "voiceover/p1-thuy-si-linh-thue/25.wav",
      "durationInSeconds": 5.123,
      "tempo": 1.1,
      "hash": "6c9937810374"
    }
  ]
