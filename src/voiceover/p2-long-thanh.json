      "durationInSeconds": 1.773,
      "tempo": 1.1,
      "hash": "51d291c5d3cb"
    },
    {
      "id": "16",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 0.06,
      "text": "Long Thành rộng năm nghìn héc-ta.",
