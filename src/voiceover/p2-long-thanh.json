      "durationInSeconds": 3.058,
      "tempo": 1.1,
      "hash": "51d291c5d3cb"
    },
    {
      "id": "14",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.06,
      "text": "Bốn trăm hai mươi tám trên bốn trăm sáu mươi mốt phiếu.",
