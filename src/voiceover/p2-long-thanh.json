      "durationInSeconds": 1.781,
      "tempo": 1.1,
      "hash": "51d291c5d3cb"
    },
    {
      "id": "13",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.06,
      "text": "Năm hai nghìn không trăm mười lăm, Quốc hội chọn xây mới.",
