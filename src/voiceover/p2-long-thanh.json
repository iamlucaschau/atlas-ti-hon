      "durationInSeconds": 2.391,
      "tempo": 1.1,
      "hash": "51d291c5d3cb"
    },
    {
      "id": "15",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.25,
      "text": "Cuộc bỏ phiếu cất cánh khá êm.",
