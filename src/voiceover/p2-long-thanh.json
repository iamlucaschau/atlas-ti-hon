      "durationInSeconds": 2.057,
      "tempo": 1.1,
      "hash": "5bbe22178410"
    },
    {
      "id": "22",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.25,
      "text": "Giai đoạn đầu, hãng dự kiến chuyển bốn đường bay, có Bắc Kinh.",
