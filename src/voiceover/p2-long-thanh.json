      "src": "voiceover/p2-long-thanh/22.wav",
      "durationInSeconds": 3.119,
      "tempo": 1.1,
      "hash": "5bbe22178410"
    },
    {
      "id": "23",
      "scene": "s7",
      "take": "t07",
      "gapAfter": 0.25,
      "text": "Chiều mười lăm tháng mười hai năm ngoái, cơ trưởng Trần Tuấn Hưng đáp chiếc máy bay đầu tiên xuống Long Thành.",
