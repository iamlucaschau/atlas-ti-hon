  "lines": [
    {
      "id": "01",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.06,
      "text": "Cuối năm nay, chuyến Vietnam Airlines từ Sài Gòn đi Bắc Kinh dự kiến cất cánh ở Đồng Nai.",
      "voice": "Orus",
      "src": "voiceover/p2-long-thanh/01.wav",
      "durationInSeconds": 4.75,
      "tempo": 1.1,
      "hash": "8265c0d915b1"
    },
    {
      "id": "02",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.06,
      "text": "Ai bắt bạn đi xa bốn mươi cây số?",
      "voice": "Orus",
      "src": "voiceover/p2-long-thanh/02.wav",
      "durationInSeconds": 1.797,
      "tempo": 1.1,
      "hash": "8265c0d915b1"
    },
    {
      "id": "03",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.25,
      "text": "Một khoản nợ.",
      "voice": "Orus",
      "src": "voiceover/p2-long-thanh/03.wav",
      "durationInSeconds": 0.761,
      "tempo": 1.1,
      "hash": "8265c0d915b1"
    },
    {
      "id": "04",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.06,
      "text": "Giai đoạn đầu của Long Thành tốn gần một trăm mười nghìn tỷ, một phần là tiền vay.",
      "voice": "Orus",
      "src": "voiceover/p2-long-thanh/04.wav",
      "durationInSeconds": 4.117,
      "tempo": 1.1,
      "hash": "1b63c1951307"
    },
    {
      "id": "05",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.06,
      "text": "Muốn trả nợ thì cần khách.",
      "voice": "Orus",
      "src": "voiceover/p2-long-thanh/05.wav",
      "durationInSeconds": 1.297,
      "tempo": 1.1,
      "hash": "1b63c1951307"
    },
    {
      "id": "06",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.25,
      "text": "Mà khách đang ở Tân Sơn Nhất: năm ngoái, hơn bốn mươi hai triệu lượt.",
      "voice": "Orus",
      "src": "voiceover/p2-long-thanh/06.wav",
      "durationInSeconds": 3.842,
      "tempo": 1.1,
      "hash": "1b63c1951307"
    },
    {
      "id": "07",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.06,
      "text": "Sao không mở rộng luôn Tân Sơn Nhất?",
      "voice": "Orus",
      "src": "voiceover/p2-long-thanh/07.wav",
      "durationInSeconds": 1.485,
      "tempo": 1.1,
      "hash": "c95bba061721"
    },
    {
      "id": "08",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.06,
      "text": "Hết chỗ.",
      "voice": "Orus",
      "src": "voiceover/p2-long-thanh/08.wav",
      "durationInSeconds": 0.263,
      "tempo": 1.1,
      "hash": "c95bba061721"
    },
    {
      "id": "09",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.06,
      "text": "Sân bay nằm lọt giữa phố, lại dùng chung với quân đội.",
      "voice": "Orus",
      "src": "voiceover/p2-long-thanh/09.wav",
      "durationInSeconds": 3.39,
      "tempo": 1.1,
      "hash": "c95bba061721"
    },
    {
      "id": "10",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.25,
      "text": "Thêm một đường băng là phải giải toả nhà dân.",
      "voice": "Orus",
      "src": "voiceover/p2-long-thanh/10.wav",
      "durationInSeconds": 2.069,
      "tempo": 1.1,
      "hash": "c95bba061721"
    },
    {
      "id": "11",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.06,
      "text": "Phe mở rộng muốn lấy sân golf ngay trong sân bay.",
      "voice": "Orus",
      "src": "voiceover/p2-long-thanh/11.wav",
      "durationInSeconds": 2.587,
      "tempo": 1.1,
      "hash": "51d291c5d3cb"
    },
    {
      "id": "12",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.06,
      "text": "Phe kia bảo phải ra chỗ rộng.",
