  "lines": [
    {
      "id": "01",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.15,
      "text": "Đầu những năm một nghìn chín trăm chín mươi, một người đi rừng ở Phong Nha trú mưa dưới vách đá.",
      "voice": "Orus",
      "src": "voiceover/p5-son-doong/01.wav",
      "durationInSeconds": 4.622,
      "tempo": 1.1,
      "hash": "eac853e2da6b"
    },
    {
      "id": "02",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.15,
      "text": "Từ một cửa hang bên cạnh, gió lạnh và mây thổi ra.",
      "voice": "Orus",
      "src": "voiceover/p5-son-doong/02.wav",
      "durationInSeconds": 2.98,
      "tempo": 1.1,
      "hash": "eac853e2da6b"
    },
    {
      "id": "03",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.15,
      "text": "Không có dây, ông không dám xuống.",
      "voice": "Orus",
      "src": "voiceover/p5-son-doong/03.wav",
      "durationInSeconds": 1.845,
      "tempo": 1.1,
      "hash": "eac853e2da6b"
    },
    {
      "id": "04",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.15,
      "text": "Rồi ông không tìm lại được nó nữa.",
      "voice": "Orus",
      "src": "voiceover/p5-son-doong/04.wav",
      "durationInSeconds": 2.002,
      "tempo": 1.1,
      "hash": "eac853e2da6b"
    },
    {
      "id": "05",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.15,
      "text": "Cái hang ấy là gì?",
      "voice": "Orus",
      "src": "voiceover/p5-son-doong/05.wav",
      "durationInSeconds": 1.129,
      "tempo": 1.1,
      "hash": "eac853e2da6b"
    },
    {
      "id": "06",
      "scene": "s1",
      "take": "t01b",
      "gapAfter": 0.15,
      "text": "Sơn Đoòng.",
      "voice": "Orus",
      "src": "voiceover/p5-son-doong/06.wav",
      "durationInSeconds": 0.653,
      "tempo": 1.1,
      "hash": "ecdbced9ba50"
    },
    {
      "id": "07",
      "scene": "s1",
      "take": "t01b",
      "gapAfter": 0.6,
      "text": "Lối hang lớn nhất thế giới.",
      "voice": "Orus",
      "src": "voiceover/p5-son-doong/07.wav",
      "durationInSeconds": 1.488,
      "tempo": 1.1,
      "hash": "ecdbced9ba50"
    },
    {
      "id": "08",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.15,
      "text": "Người đi rừng tên là Hồ Khanh.",
      "voice": "Orus",
      "src": "voiceover/p5-son-doong/08.wav",
      "durationInSeconds": 1.486,
      "tempo": 1.1,
      "hash": "47fa42455f84"
    },
    {
      "id": "09",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.15,
      "text": "Mười tám năm sau, ông mới tìm lại được cửa hang.",
      "voice": "Orus",
      "src": "voiceover/p5-son-doong/09.wav",
      "durationInSeconds": 2.484,
      "tempo": 1.1,
      "hash": "47fa42455f84"
    },
    {
      "id": "10",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.15,
      "text": "Năm hai nghìn không trăm linh chín, ông dẫn đoàn thám hiểm Anh của Howard Limbert xuống.",
      "voice": "Orus",
      "src": "voiceover/p5-son-doong/10.wav",
      "durationInSeconds": 4.201,
      "tempo": 1.1,
      "hash": "47fa42455f84"
    },
    {
      "id": "11",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.15,
      "text": "Đo bằng laser xong, cả đoàn mới biết mình đang đứng ở đâu.",
      "voice": "Orus",
      "src": "voiceover/p5-son-doong/11.wav",
      "durationInSeconds": 2.942,
      "tempo": 1.1,
      "hash": "47fa42455f84"
    },
    {
      "id": "12",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.15,
      "text": "Có đoạn cao gần hai trăm mét, đủ chứa cả một dãy nhà chọc trời.",
      "voice": "Orus",
      "src": "voiceover/p5-son-doong/12.wav",
      "durationInSeconds": 3.697,
      "tempo": 1.1,
      "hash": "47fa42455f84"
    },
    {
      "id": "13",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.6,
      "text": "Chỉ có điều, không có thang máy.",
      "voice": "Orus",
      "src": "voiceover/p5-son-doong/13.wav",
      "durationInSeconds": 1.72,
      "tempo": 1.1,
      "hash": "47fa42455f84"
    },
    {
      "id": "14",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.15,
      "text": "Vì sao nó khổng lồ như vậy?",
      "voice": "Orus",
      "src": "voiceover/p5-son-doong/14.wav",
      "durationInSeconds": 1.919,
      "tempo": 1.1,
      "hash": "14e101fe42a7"
    },
    {
      "id": "15",
      "scene": "s3",
      "take": "t03b",
      "gapAfter": 0.15,
      "text": "Nước.",
      "voice": "Orus",
      "src": "voiceover/p5-son-doong/15.wav",
      "durationInSeconds": 0.781,
      "tempo": 1.1,
      "hash": "dbe2b9ae3a43"
    },
    {
      "id": "16",
      "scene": "s3",
      "take": "t03b",
      "gapAfter": 0.15,
      "text": "Khối đá vôi ở đây có từ khoảng bốn trăm triệu năm.",
      "voice": "Orus",
      "src": "voiceover/p5-son-doong/16.wav",
      "durationInSeconds": 2.907,
      "tempo": 1.1,
      "hash": "dbe2b9ae3a43"
    },
    {
      "id": "17",
      "scene": "s3",
      "take": "t03b",
      "gapAfter": 0.15,
      "text": "Một dòng sông ngầm len theo vết nứt, khoét dần suốt vài triệu năm.",
      "voice": "Orus",
      "src": "voiceover/p5-son-doong/17.wav",
      "durationInSeconds": 3.994,
      "tempo": 1.1,
      "hash": "dbe2b9ae3a43"
    },
    {
      "id": "18",
      "scene": "s3",
      "take": "t03b",
      "gapAfter": 0.6,
      "text": "Chỗ đá yếu, trần sụp xuống, ánh sáng lọt vào, rừng mọc ngay trong hang.",
      "voice": "Orus",
      "src": "voiceover/p5-son-doong/18.wav",
      "durationInSeconds": 5.353,
      "tempo": 1.1,
      "hash": "dbe2b9ae3a43"
    },
    {
      "id": "19",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.15,
      "text": "Năm hai nghìn không trăm mười bảy, Thủ tướng đồng ý chủ trương làm cáp treo tới hang Én gần đó, để đón thêm khách.",
      "voice": "Orus",
      "src": "voiceover/p5-son-doong/19.wav",
      "durationInSeconds": 5.774,
      "tempo": 1.1,
      "hash": "e98696ae5c65"
    },
    {
      "id": "20",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.15,
      "text": "UNESCO đề nghị hủy mọi kế hoạch cáp treo vào Sơn Đoòng.",
      "voice": "Orus",
      "src": "voiceover/p5-son-doong/20.wav",
      "durationInSeconds": 3.338,
      "tempo": 1.1,
      "hash": "e98696ae5c65"
    },
    {
      "id": "21",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.15,
      "text": "Muốn tự vào xem?",
      "voice": "Orus",
      "src": "voiceover/p5-son-doong/21.wav",
      "durationInSeconds": 1.066,
      "tempo": 1.1,
      "hash": "e98696ae5c65"
    },
    {
      "id": "22",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.6,
      "text": "Mỗi năm chỉ khoảng một nghìn người được đi.",
      "voice": "Orus",
      "src": "voiceover/p5-son-doong/22.wav",
      "durationInSeconds": 1.937,
      "tempo": 1.1,
      "hash": "e98696ae5c65"
    },
    {
      "id": "23",
      "scene": "s5",
      "take": "t05b",
      "gapAfter": 0.15,
      "text": "Còn làn mây thổi ra năm ấy?",
      "voice": "Orus",
      "src": "voiceover/p5-son-doong/23.wav",
      "durationInSeconds": 1.571,
      "tempo": 1.1,
      "hash": "0f4732ab497c"
    },
    {
      "id": "24",
      "scene": "s5",
      "take": "t05b",
      "gapAfter": 0.15,
      "text": "Hang lớn đến mức tự sinh ra mây.",
      "voice": "Orus",
      "src": "voiceover/p5-son-doong/24.wav",
      "durationInSeconds": 1.927,
      "tempo": 1.1,
      "hash": "0f4732ab497c"
    },
    {
      "id": "25",
      "scene": "s5",
      "take": "t05b",
      "gapAfter": 0.6,
      "text": "Mười tám năm để tìm lại một cửa hang, và bên trong là cả một bầu trời.",
      "voice": "Orus",
      "src": "voiceover/p5-son-doong/25.wav",
