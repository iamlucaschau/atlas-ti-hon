{
  "name": "p2-dien-hat-nhan",
  "model": "gemini-3.8-flash-tts",
  "totalSeconds": 71.76,
  "lines": [
    {
      "id": "01",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.06,
      "text": "Năm hai nghìn không trăm mười sáu, Việt Nam dừng điện hạt nhân vì tiền.",
      "voice": "Orus",
      "src": "voiceover/p2-dien-hat-nhan/01.wav",
      "durationInSeconds": 3.57,
      "tempo": 1.13,
      "hash": "9f939c9c4c6c"
    },
    {
      "id": "02",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.06,
      "text": "Tám năm sau, làm lại, vì điện.",
      "voice": "Orus",
      "src": "voiceover/p2-dien-hat-nhan/02.wav",
      "durationInSeconds": 2.388,
      "tempo": 1.13,
      "hash": "9f939c9c4c6c"
    },
    {
      "id": "03",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.25,
      "text": "Tám năm ấy đã đổi điều gì?",
      "voice": "Orus",
      "src": "voiceover/p2-dien-hat-nhan/03.wav",
      "durationInSeconds": 1.642,
      "tempo": 1.13,
      "hash": "9f939c9c4c6c"
    },
    {
      "id": "04",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.06,
      "text": "Nhìn hai điểm trên bản đồ.",
      "voice": "Orus",
      "src": "voiceover/p2-dien-hat-nhan/04.wav",
      "durationInSeconds": 1.486,
      "tempo": 1.13,
      "hash": "00383426a056"
    },
    {
      "id": "05",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.06,
      "text": "Ở Ninh Thuận, hai khu đất đã được chọn cho hai nhà máy.",
      "voice": "Orus",
      "src": "voiceover/p2-dien-hat-nhan/05.wav",
      "durationInSeconds": 2.962,
      "tempo": 1.13,
      "hash": "00383426a056"
    },
    {
      "id": "06",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.25,
      "text": "Cách hơn nghìn cây số về phía bắc, là Hà Nội.",
      "voice": "Orus",
      "src": "voiceover/p2-dien-hat-nhan/06.wav",
      "durationInSeconds": 2.517,
      "tempo": 1.13,
      "hash": "00383426a056"
    },
    {
      "id": "07",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.06,
      "text": "Lần đầu, cái giá ước khoảng hai trăm nghìn tỷ đồng.",
      "voice": "Orus",
      "src": "voiceover/p2-dien-hat-nhan/07.wav",
      "durationInSeconds": 2.889,
      "tempo": 1.13,
      "hash": "9f105b718844"
    },
    {
      "id": "08",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.06,
      "text": "Kế toán nào đọc cũng phải đếm số không hai lần.",
      "voice": "Orus",
      "src": "voiceover/p2-dien-hat-nhan/08.wav",
      "durationInSeconds": 2.388,
      "tempo": 1.13,
      "hash": "9f105b718844"
    },
    {
      "id": "09",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.06,
      "text": "Năm dừng dự án, Bộ trưởng Mai Tiến Dũng đứng trước báo chí: không phải vì công nghệ, mà vì kinh tế.",
      "voice": "Orus",
      "src": "voiceover/p2-dien-hat-nhan/09.wav",
      "durationInSeconds": 5.417,
      "tempo": 1.13,
      "hash": "9f105b718844"
    },
    {
      "id": "10",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.25,
      "text": "Gió, mặt trời đã rẻ hơn, và tiền cần cho hạ tầng.",
      "voice": "Orus",
      "src": "voiceover/p2-dien-hat-nhan/10.wav",
      "durationInSeconds": 3.771,
      "tempo": 1.13,
      "hash": "9f105b718844"
    },
    {
      "id": "11",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.06,
      "text": "Điều gì kéo dự án quay lại?",
      "voice": "Orus",
      "src": "voiceover/p2-dien-hat-nhan/11.wav",
      "durationInSeconds": 1.455,
      "tempo": 1.13,
      "hash": "897ba8d1330b"
    },
    {
      "id": "12",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.06,
      "text": "Cơn khát điện.",
      "voice": "Orus",
      "src": "voiceover/p2-dien-hat-nhan/12.wav",
      "durationInSeconds": 0.858,
      "tempo": 1.13,
      "hash": "897ba8d1330b"
    },
    {
      "id": "13",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.06,
      "text": "Mùa hè năm hai nghìn hai mươi ba, miền Bắc cắt điện luân phiên.",
      "voice": "Orus",
      "src": "voiceover/p2-dien-hat-nhan/13.wav",
      "durationInSeconds": 3.509,
      "tempo": 1.13,
      "hash": "897ba8d1330b"
    },
    {
      "id": "14",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.25,
      "text": "Ngân hàng Thế giới ước thiệt hại khoảng một tỷ bốn trăm triệu đô, chỉ trong hai tháng.",
      "voice": "Orus",
      "src": "voiceover/p2-dien-hat-nhan/14.wav",
      "durationInSeconds": 4.236,
      "tempo": 1.13,
      "hash": "897ba8d1330b"
    },
    {
      "id": "15",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 0.06,
      "text": "Lúc căng nhất, miền Bắc ước thiếu hơn bốn nghìn mê-ga-oát.",
      "voice": "Orus",
      "src": "voiceover/p2-dien-hat-nhan/15.wav",
      "durationInSeconds": 3.3,
      "tempo": 1.13,
      "hash": "f1c51b84b991"
    },
    {
      "id": "16",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 0.06,
      "text": "Hai nhà máy Ninh Thuận, theo quy hoạch: bốn đến sáu nghìn tư mê-ga-oát.",
      "voice": "Orus",
      "src": "voiceover/p2-dien-hat-nhan/16.wav",
      "durationInSeconds": 3.875,
      "tempo": 1.13,
      "hash": "f1c51b84b991"
    },
    {
      "id": "17",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 0.25,
      "text": "Ngang cỡ cái lỗ ấy.",
      "voice": "Orus",
      "src": "voiceover/p2-dien-hat-nhan/17.wav",
      "durationInSeconds": 1.075,
      "tempo": 1.13,
      "hash": "f1c51b84b991"
    },
    {
      "id": "18",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.06,
      "text": "Phe ủng hộ nói: đó là an ninh năng lượng, lại ít khói than.",
      "voice": "Orus",
      "src": "voiceover/p2-dien-hat-nhan/18.wav",
      "durationInSeconds": 3.375,
      "tempo": 1.13,
      "hash": "2589fa57f0f0"
    },
    {
      "id": "19",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.06,
      "text": "Phe lo ngại hỏi: tiền đâu, công nghệ của ai, an toàn ra sao?",
      "voice": "Orus",
      "src": "voiceover/p2-dien-hat-nhan/19.wav",
      "durationInSeconds": 3.709,
      "tempo": 1.13,
      "hash": "2589fa57f0f0"
    },
    {
      "id": "20",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.06,
      "text": "Và ván cược vẫn còn mở.",
      "voice": "Orus",
      "src": "voiceover/p2-dien-hat-nhan/20.wav",
      "durationInSeconds": 1.352,
      "tempo": 1.13,
      "hash": "2589fa57f0f0"
    },
    {
      "id": "21",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.06,
      "text": "Nhật đã rút khỏi nhà máy thứ hai.",
      "voice": "Orus",
      "src": "voiceover/p2-dien-hat-nhan/21.wav",
      "durationInSeconds": 1.464,
      "tempo": 1.13,
      "hash": "2589fa57f0f0"
    },
    {
      "id": "22",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.06,
      "text": "Nga ký nhà máy thứ nhất.",
      "voice": "Orus",
      "src": "voiceover/p2-dien-hat-nhan/22.wav",
      "durationInSeconds": 1.121,
      "tempo": 1.13,
      "hash": "2589fa57f0f0"
    },
    {
      "id": "23",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.25,
      "text": "Giá mới vẫn đang thẩm định.",
      "voice": "Orus",
      "src": "voiceover/p2-dien-hat-nhan/23.wav",
      "durationInSeconds": 1.225,
      "tempo": 1.13,
      "hash": "2589fa57f0f0"
    },
    {
      "id": "24",
      "scene": "s7",
      "take": "t07",
      "gapAfter": 0.06,
      "text": "Trớ trêu là, đúng mùa hè cắt điện ấy, Ninh Thuận vừa huỷ lệnh thu hồi đất cho điện hạt nhân.",
      "voice": "Orus",
      "src": "voiceover/p2-dien-hat-nhan/24.wav",
      "durationInSeconds": 5.081,
      "tempo": 1.13,
      "hash": "916c538054a3"
    },
    {
      "id": "25",
      "scene": "s7",
      "take": "t07",
      "gapAfter": 0.06,
      "text": "Hơn nghìn hộ dân, sau mười ba năm, mới được sửa nhà.",
      "voice": "Orus",
      "src": "voiceover/p2-dien-hat-nhan/25.wav",
      "durationInSeconds": 3.292,
      "tempo": 1.13,
      "hash": "916c538054a3"
    },
    {
      "id": "26",
      "scene": "s7",
      "take": "t07",
      "gapAfter": 0.25,
      "text": "Mười sáu tháng sau, dự án quay lại, và họ lại chuẩn bị rời đi.",
      "voice": "Orus",
      "src": "voiceover/p2-dien-hat-nhan/26.wav",
      "durationInSeconds": 3.803,
      "tempo": 1.13,
      "hash": "916c538054a3"
    }
  ]
}
