      "src": "voiceover/p4-mekong-voi-nuoc/22.wav",
      "durationInSeconds": 2.812,
      "tempo": 1.1,
      "hash": "3a11815d7834"
    },
    {
      "id": "23",
      "scene": "s7",
      "take": "t07",
      "gapAfter": 0.15,
      "text": "Gần bằng sức chứa cả mười một hồ Trung Quốc.",
      "voice": "Orus",
      "src": "voiceover/p4-mekong-voi-nuoc/23.wav",
      "durationInSeconds": 2.373,
      "tempo": 1.1,
      "hash": "3a11815d7834"
    },
    {
      "id": "24",
      "scene": "s7",
      "take": "t07",
      "gapAfter": 0.6,
      "text": "Vòi nước lớn nhất của Mekong không nằm sau con đập nào, mà ở một con sông biết chảy ngược.",
