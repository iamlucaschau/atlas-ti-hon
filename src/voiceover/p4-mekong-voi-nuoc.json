  "lines": [
    {
      "id": "01",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.15,
      "text": "Trước khi về tới miền Tây, sông Mekong chảy qua sáu nước.",
      "voice": "Orus",
      "src": "voiceover/p4-mekong-voi-nuoc/01.wav",
      "durationInSeconds": 3.019,
      "tempo": 1.1,
      "hash": "ccb323866e9e"
    },
    {
      "id": "02",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.15,
      "text": "Đoạn đầu ở Trung Quốc đã có mười một con đập.",
      "voice": "Orus",
      "src": "voiceover/p4-mekong-voi-nuoc/02.wav",
      "durationInSeconds": 2.367,
      "tempo": 1.1,
      "hash": "ccb323866e9e"
    },
    {
      "id": "03",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.15,
      "text": "Vậy ai giữ vòi nước?",
      "voice": "Orus",
      "src": "voiceover/p4-mekong-voi-nuoc/03.wav",
      "durationInSeconds": 1.439,
      "tempo": 1.1,
      "hash": "ccb323866e9e"
    },
    {
      "id": "04",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.6,
      "text": "Không chỉ một nước.",
      "voice": "Orus",
      "src": "voiceover/p4-mekong-voi-nuoc/04.wav",
      "durationInSeconds": 1.16,
      "tempo": 1.1,
      "hash": "ccb323866e9e"
    },
    {
      "id": "05",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.15,
      "text": "Riêng đập Tiểu Loan cao gần bằng tháp Eiffel.",
      "voice": "Orus",
      "src": "voiceover/p4-mekong-voi-nuoc/05.wav",
      "durationInSeconds": 2.544,
      "tempo": 1.1,
      "hash": "f132fe073b3a"
    },
    {
      "id": "06",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.15,
      "text": "Đứng dưới chân mà ngước lên chắc mỏi cổ.",
      "voice": "Orus",
      "src": "voiceover/p4-mekong-voi-nuoc/06.wav",
      "durationInSeconds": 2.149,
      "tempo": 1.1,
      "hash": "f132fe073b3a"
    },
    {
      "id": "07",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.6,
      "text": "Cả mười một hồ chứa được khoảng bốn mươi hai tỷ khối nước.",
      "voice": "Orus",
      "src": "voiceover/p4-mekong-voi-nuoc/07.wav",
      "durationInSeconds": 2.717,
      "tempo": 1.1,
      "hash": "f132fe073b3a"
    },
    {
      "id": "08",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.15,
      "text": "Nhưng nước Mekong đến từ đâu?",
      "voice": "Orus",
      "src": "voiceover/p4-mekong-voi-nuoc/08.wav",
      "durationInSeconds": 1.602,
      "tempo": 1.1,
      "hash": "dd927f0d532c"
    },
    {
      "id": "09",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.15,
      "text": "Từ mưa.",
      "voice": "Orus",
      "src": "voiceover/p4-mekong-voi-nuoc/09.wav",
      "durationInSeconds": 0.554,
      "tempo": 1.1,
      "hash": "dd927f0d532c"
    },
    {
      "id": "10",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.15,
      "text": "Phần Trung Quốc chỉ góp chưa tới một phần năm.",
      "voice": "Orus",
      "src": "voiceover/p4-mekong-voi-nuoc/10.wav",
      "durationInSeconds": 1.994,
      "tempo": 1.1,
      "hash": "dd927f0d532c"
    },
    {
      "id": "11",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.6,
      "text": "Riêng mưa ở Lào đã góp hơn một phần ba.",
      "voice": "Orus",
      "src": "voiceover/p4-mekong-voi-nuoc/11.wav",
      "durationInSeconds": 1.908,
      "tempo": 1.1,
      "hash": "dd927f0d532c"
    },
    {
      "id": "12",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.15,
      "text": "Năm hai nghìn mười chín, hạ lưu hạn nặng.",
      "voice": "Orus",
      "src": "voiceover/p4-mekong-voi-nuoc/12.wav",
      "durationInSeconds": 2.244,
      "tempo": 1.1,
      "hash": "5847f2721a0a"
    },
    {
      "id": "13",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.15,
      "text": "Nhà nghiên cứu Mỹ Alan Basist dùng ảnh vệ tinh soi các hồ thượng nguồn.",
      "voice": "Orus",
      "src": "voiceover/p4-mekong-voi-nuoc/13.wav",
      "durationInSeconds": 3.461,
      "tempo": 1.1,
      "hash": "5847f2721a0a"
    },
    {
      "id": "14",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.15,
      "text": "Ông cho rằng đập đã giữ nước lại, làm hạn thêm nặng.",
      "voice": "Orus",
      "src": "voiceover/p4-mekong-voi-nuoc/14.wav",
      "durationInSeconds": 2.607,
      "tempo": 1.1,
      "hash": "5847f2721a0a"
    },
    {
      "id": "15",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.15,
      "text": "Trung Quốc và Ủy hội sông Mekong phản bác: hạn do trời ít mưa.",
      "voice": "Orus",
      "src": "voiceover/p4-mekong-voi-nuoc/15.wav",
      "durationInSeconds": 3.469,
      "tempo": 1.1,
      "hash": "5847f2721a0a"
    },
    {
      "id": "16",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.6,
      "text": "Số đo cũng cho thấy, mùa khô hồ chứa xả thêm nước.",
      "voice": "Orus",
      "src": "voiceover/p4-mekong-voi-nuoc/16.wav",
      "durationInSeconds": 2.937,
      "tempo": 1.1,
      "hash": "5847f2721a0a"
    },
    {
      "id": "17",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 0.15,
      "text": "Có điều, nước giữ lại còn xả ra được, phù sa thì nằm lại dưới đáy hồ.",
      "voice": "Orus",
      "src": "voiceover/p4-mekong-voi-nuoc/17.wav",
      "durationInSeconds": 4.743,
      "tempo": 1.1,
      "hash": "6a6c49c15aa8"
    },
    {
      "id": "18",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 0.6,
      "text": "Lào cũng đã có hai đập trên dòng chính.",
      "voice": "Orus",
      "src": "voiceover/p4-mekong-voi-nuoc/18.wav",
      "durationInSeconds": 2.138,
      "tempo": 1.1,
      "hash": "6a6c49c15aa8"
    },
    {
      "id": "19",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.6,
      "who": "mientay",
      "text": "Nước thì về, mà đất bồi thì thiếu, tụi tui đói phù sa đó nghen!",
      "voice": "Puck",
      "src": "voiceover/p4-mekong-voi-nuoc/19.wav",
      "durationInSeconds": 4.709,
      "tempo": 1.1,
      "hash": "87979a4dd8d7"
    },
    {
      "id": "20",
      "scene": "s7",
      "take": "t07",
      "gapAfter": 0.15,
      "text": "Nhưng cái vòi lớn nhất lại do chính dòng sông tự mở.",
      "voice": "Orus",
      "src": "voiceover/p4-mekong-voi-nuoc/20.wav",
      "durationInSeconds": 2.903,
      "tempo": 1.1,
      "hash": "3a11815d7834"
    },
    {
      "id": "21",
      "scene": "s7",
      "take": "t07",
      "gapAfter": 0.15,
      "text": "Mùa mưa, nước Mekong dâng lên, đẩy một con sông ở Campuchia chảy ngược vào Biển Hồ.",
      "voice": "Orus",
      "src": "voiceover/p4-mekong-voi-nuoc/21.wav",
      "durationInSeconds": 4.77,
      "tempo": 1.1,
      "hash": "3a11815d7834"
    },
    {
      "id": "22",
      "scene": "s7",
      "take": "t07",
      "gapAfter": 0.15,
      "text": "Mùa khô, hồ nhả ra chừng bốn mươi tỷ khối.",
