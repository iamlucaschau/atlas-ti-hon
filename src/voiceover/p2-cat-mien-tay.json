{
  "name": "p2-cat-mien-tay",
  "model": "gemini-3.8-flash-tts",
  "totalSeconds": 65.228,
  "lines": [
    {
      "id": "01",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.06,
      "text": "Miền Tây là xứ của sông nước và phù sa.",
      "voice": "Orus",
      "src": "voiceover/p2-cat-mien-tay/01.wav",
      "durationInSeconds": 2.111,
      "tempo": 1.1,
      "hash": "4124cbb21ad7"
    },
    {
      "id": "02",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.25,
      "text": "Vậy mà làm cao tốc ở đây, lại thiếu cát.",
      "voice": "Orus",
      "src": "voiceover/p2-cat-mien-tay/02.wav",
      "durationInSeconds": 2.368,
      "tempo": 1.1,
      "hash": "4124cbb21ad7"
    },
    {
      "id": "03",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.06,
      "text": "Vùng này còn khoảng bảy trăm cây số cao tốc phải làm.",
      "voice": "Orus",
      "src": "voiceover/p2-cat-mien-tay/03.wav",
      "durationInSeconds": 2.487,
      "tempo": 1.1,
      "hash": "69475546ffa4"
    },
    {
      "id": "04",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.06,
      "text": "Nếu đắp nền kiểu cũ, cần hơn một trăm triệu khối cát.",
      "voice": "Orus",
      "src": "voiceover/p2-cat-mien-tay/04.wav",
      "durationInSeconds": 3.252,
      "tempo": 1.1,
      "hash": "69475546ffa4"
    },
    {
      "id": "05",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.15,
      "text": "Sao lại thiếu?",
      "voice": "Orus",
      "src": "voiceover/p2-cat-mien-tay/05.wav",
      "durationInSeconds": 0.733,
      "tempo": 1.1,
      "hash": "69475546ffa4"
    },
    {
      "id": "06",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.25,
      "text": "Ba lý do.",
      "voice": "Orus",
      "src": "voiceover/p2-cat-mien-tay/06.wav",
      "durationInSeconds": 0.663,
      "tempo": 1.1,
      "hash": "69475546ffa4"
    },
    {
      "id": "07",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.06,
      "text": "Một, đất dưới chân quá mềm.",
      "voice": "Orus",
      "src": "voiceover/p2-cat-mien-tay/07.wav",
      "durationInSeconds": 1.996,
      "tempo": 1.1,
      "hash": "5a7f2ef1ce17"
    },
    {
      "id": "08",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.25,
      "text": "Muốn đường không lún, phải đắp cát thật dày, rồi chất thêm cát lên cho nền lún trước.",
      "voice": "Orus",
      "src": "voiceover/p2-cat-mien-tay/08.wav",
      "durationInSeconds": 4.722,
      "tempo": 1.1,
      "hash": "5a7f2ef1ce17"
    },
    {
      "id": "09",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.06,
      "text": "Hai, cát đủ chuẩn đắp đường chỉ còn ở vài khúc sông thượng nguồn.",
      "voice": "Orus",
      "src": "voiceover/p2-cat-mien-tay/09.wav",
      "durationInSeconds": 3.476,
      "tempo": 1.1,
      "hash": "c506e9d5e163"
    },
    {
      "id": "10",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.25,
      "text": "Các đập trên dòng Mekong lại giữ bớt phù sa ở phía trên.",
      "voice": "Orus",
      "src": "voiceover/p2-cat-mien-tay/10.wav",
      "durationInSeconds": 3.086,
      "tempo": 1.1,
      "hash": "c506e9d5e163"
    },
    {
      "id": "11",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 0.06,
      "text": "Ba, sông bồi không kịp.",
      "voice": "Orus",
      "src": "voiceover/p2-cat-mien-tay/11.wav",
      "durationInSeconds": 1.575,
      "tempo": 1.1,
      "hash": "b7fef99a2cc8"
    },
    {
      "id": "12",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 0.06,
      "text": "Các nhà khoa học từng thả máy dò xuống đáy sông Mekong, và thấy những hố hút cát sâu hơn tám mét.",
      "voice": "Orus",
      "src": "voiceover/p2-cat-mien-tay/12.wav",
      "durationInSeconds": 4.646,
      "tempo": 1.1,
      "hash": "b7fef99a2cc8"
    },
    {
      "id": "13",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 0.06,
      "text": "Họ tính ra, cát bị hút lên nhanh gấp năm đến chín lần lượng sông bồi lại.",
      "voice": "Orus",
      "src": "voiceover/p2-cat-mien-tay/13.wav",
      "durationInSeconds": 4.12,
      "tempo": 1.1,
      "hash": "b7fef99a2cc8"
    },
    {
      "id": "14",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 0.25,
      "text": "Như rút sổ tiết kiệm nhanh hơn hẳn tiền gửi vào.",
      "voice": "Orus",
      "src": "voiceover/p2-cat-mien-tay/14.wav",
      "durationInSeconds": 2.389,
      "tempo": 1.1,
      "hash": "b7fef99a2cc8"
    },
    {
      "id": "15",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.15,
      "text": "Vậy còn cát biển?",
      "voice": "Orus",
      "src": "voiceover/p2-cat-mien-tay/15.wav",
      "durationInSeconds": 1.046,
      "tempo": 1.1,
      "hash": "6548dbc38235"
    },
    {
      "id": "16",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.06,
      "text": "Có dùng rồi.",
      "voice": "Orus",
      "src": "voiceover/p2-cat-mien-tay/16.wav",
      "durationInSeconds": 0.772,
      "tempo": 1.1,
      "hash": "6548dbc38235"
    },
    {
      "id": "17",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.25,
      "text": "Nhưng cát biển mặn, phải rửa trước khi đắp.",
      "voice": "Orus",
      "src": "voiceover/p2-cat-mien-tay/17.wav",
      "durationInSeconds": 2.047,
      "tempo": 1.1,
      "hash": "6548dbc38235"
    },
    {
      "id": "18",
      "scene": "s7",
      "take": "t07",
      "gapAfter": 0.06,
      "text": "Nên giờ có lối khác: đưa cao tốc lên cầu cạn, bớt hẳn cát.",
      "voice": "Orus",
      "src": "voiceover/p2-cat-mien-tay/18.wav",
      "durationInSeconds": 3.363,
      "tempo": 1.1,
      "hash": "c169c82f9ef4"
    },
    {
      "id": "19",
      "scene": "s7",
      "take": "t07",
      "gapAfter": 0.06,
      "text": "Một bên tính lúc xây: cầu cạn đắt gấp một phẩy sáu đến một phẩy bảy lần.",
      "voice": "Orus",
      "src": "voiceover/p2-cat-mien-tay/19.wav",
      "durationInSeconds": 4.218,
      "tempo": 1.1,
      "hash": "c169c82f9ef4"
    },
    {
      "id": "20",
      "scene": "s7",
      "take": "t07",
      "gapAfter": 0.25,
      "text": "Bên kia tính cả vòng đời: chỉ đắt hơn khoảng mười đến mười bốn phần trăm, lại ít lún.",
      "voice": "Orus",
      "src": "voiceover/p2-cat-mien-tay/20.wav",
      "durationInSeconds": 5.15,
      "tempo": 1.1,
      "hash": "c169c82f9ef4"
    },
    {
      "id": "21",
      "scene": "s8",
      "take": "t08",
      "gapAfter": 0.06,
      "text": "Trớ trêu là, chính lớp cát dưới lòng sông cũng đang đỡ lấy bờ sông.",
      "voice": "Orus",
      "src": "voiceover/p2-cat-mien-tay/21.wav",
      "durationInSeconds": 3.853,
      "tempo": 1.1,
      "hash": "8b450ae9ea8f"
    },
    {
      "id": "22",
      "scene": "s8",
      "take": "t08",
      "gapAfter": 0.06,
      "text": "Lòng sông chỉ cần tụt khoảng hai mét, nhiều đoạn bờ Mekong đã có thể sụp.",
      "voice": "Orus",
      "src": "voiceover/p2-cat-mien-tay/22.wav",
      "durationInSeconds": 3.931,
      "tempo": 1.1,
      "hash": "8b450ae9ea8f"
    },
    {
      "id": "23",
      "scene": "s8",
      "take": "t08",
      "gapAfter": 0.25,
      "text": "Con đường cần cát để đứng vững, và đồng bằng cũng vậy.",
      "voice": "Orus",
      "src": "voiceover/p2-cat-mien-tay/23.wav",
      "durationInSeconds": 3.224,
      "tempo": 1.1,
      "hash": "8b450ae9ea8f"
    }
  ]
}
