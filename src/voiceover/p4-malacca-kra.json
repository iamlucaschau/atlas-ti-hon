{
  "name": "p4-malacca-kra",
  "model": "gemini-3.8-flash-tts",
  "totalSeconds": 67.381,
  "lines": [
    {
      "id": "01",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.06,
      "text": "Gần một phần ba lượng dầu chở bằng đường biển của thế giới phải chen qua một eo biển.",
      "voice": "Orus",
      "src": "voiceover/p4-malacca-kra/01.wav",
      "durationInSeconds": 3.824,
      "tempo": 1.1,
      "hash": "3bfc589bbfdf"
    },
    {
      "id": "02",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.25,
      "text": "Ngay phía trên có một lối tắt, mà hơn ba trăm năm nay chưa ai đào.",
      "voice": "Orus",
      "src": "voiceover/p4-malacca-kra/02.wav",
      "durationInSeconds": 3.831,
      "tempo": 1.1,
      "hash": "3bfc589bbfdf"
    },
    {
      "id": "03",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.06,
      "text": "Hình dung một con tàu dầu đi từ Trung Đông sang Đông Á.",
      "voice": "Orus",
      "src": "voiceover/p4-malacca-kra/03.wav",
      "durationInSeconds": 2.832,
      "tempo": 1.1,
      "hash": "e25e16ecf8fe"
    },
    {
      "id": "04",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.25,
      "text": "Muốn vào Biển Đông, nó phải vòng xuống tận eo Malacca.",
      "voice": "Orus",
      "src": "voiceover/p4-malacca-kra/04.wav",
      "durationInSeconds": 2.73,
      "tempo": 1.1,
      "hash": "e25e16ecf8fe"
    },
    {
      "id": "05",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.06,
      "text": "Năm ngoái, hơn một trăm nghìn lượt tàu chen qua đây.",
      "voice": "Orus",
      "src": "voiceover/p4-malacca-kra/05.wav",
      "durationInSeconds": 2.548,
      "tempo": 1.1,
      "hash": "020e541893fc"
    },
    {
      "id": "06",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.06,
      "text": "Chỗ hẹp nhất, gần Singapore, chỉ rộng khoảng hai, ba cây số.",
      "voice": "Orus",
      "src": "voiceover/p4-malacca-kra/06.wav",
      "durationInSeconds": 3.481,
      "tempo": 1.1,
      "hash": "020e541893fc"
    },
    {
      "id": "07",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.25,
      "text": "Kẹt xe giờ cao điểm, nhưng là trên biển.",
      "voice": "Orus",
      "src": "voiceover/p4-malacca-kra/07.wav",
      "durationInSeconds": 2.978,
      "tempo": 1.1,
      "hash": "020e541893fc"
    },
    {
      "id": "08",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.06,
      "text": "Trong khi đó, eo đất Kra của Thái Lan chỉ rộng hơn bốn mươi cây số.",
      "voice": "Orus",
      "src": "voiceover/p4-malacca-kra/08.wav",
      "durationInSeconds": 3.476,
      "tempo": 1.1,
      "hash": "b3f11ddadb2e"
    },
    {
      "id": "09",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.25,
      "text": "Đào một con kênh ở đây, tàu khỏi phải vòng qua Singapore.",
      "voice": "Orus",
      "src": "voiceover/p4-malacca-kra/09.wav",
      "durationInSeconds": 2.756,
      "tempo": 1.1,
      "hash": "b3f11ddadb2e"
    },
    {
      "id": "10",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 0.06,
      "text": "Ý tưởng này có từ thời vua Narai, thế kỷ mười bảy.",
      "voice": "Orus",
      "src": "voiceover/p4-malacca-kra/10.wav",
      "durationInSeconds": 2.774,
      "tempo": 1.1,
      "hash": "dc8904384b0c"
    },
    {
      "id": "11",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 0.06,
      "text": "Năm một nghìn tám trăm tám mươi ba, một đoàn kỹ sư Pháp nhân danh công ty kênh Suez tới tận nơi đo đạc.",
      "voice": "Orus",
      "src": "voiceover/p4-malacca-kra/11.wav",
      "durationInSeconds": 5.532,
      "tempo": 1.1,
      "hash": "dc8904384b0c"
    },
    {
      "id": "12",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 0.25,
      "text": "Nhưng Xiêm không cấp phép cho nước phương Tây nào.",
      "voice": "Orus",
      "src": "voiceover/p4-malacca-kra/12.wav",
      "durationInSeconds": 2.137,
      "tempo": 1.1,
      "hash": "dc8904384b0c"
    },
    {
      "id": "13",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.06,
      "text": "Vậy sao tới giờ vẫn chưa đào?",
      "voice": "Orus",
      "src": "voiceover/p4-malacca-kra/13.wav",
      "durationInSeconds": 1.456,
      "tempo": 1.1,
      "hash": "e2124c5de4e0"
    },
    {
      "id": "14",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.06,
      "text": "Vì khó có lời.",
      "voice": "Orus",
      "src": "voiceover/p4-malacca-kra/14.wav",
      "durationInSeconds": 1.087,
      "tempo": 1.1,
      "hash": "e2124c5de4e0"
    },
    {
      "id": "15",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.06,
      "text": "Tốn hàng chục tỷ đô.",
      "voice": "Orus",
      "src": "voiceover/p4-malacca-kra/15.wav",
      "durationInSeconds": 1.156,
      "tempo": 1.1,
      "hash": "e2124c5de4e0"
    },
    {
      "id": "16",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.25,
      "text": "Mà tàu chỉ về sớm được một đến ba ngày.",
      "voice": "Orus",
      "src": "voiceover/p4-malacca-kra/16.wav",
      "durationInSeconds": 2.214,
      "tempo": 1.1,
      "hash": "e2124c5de4e0"
    },
    {
      "id": "17",
      "scene": "s7",
      "take": "t07",
      "gapAfter": 0.06,
      "text": "Năm hai nghìn hai mươi ba, Thái Lan đổi cách: không đào kênh, mà nối hai cảng bằng đường sắt.",
      "voice": "Orus",
      "src": "voiceover/p4-malacca-kra/17.wav",
      "durationInSeconds": 5.478,
      "tempo": 1.1,
      "hash": "971381a4e7f6"
    },
    {
      "id": "18",
      "scene": "s7",
      "take": "t07",
      "gapAfter": 0.06,
      "text": "Chính phủ nói dự án đáng đầu tư.",
      "voice": "Orus",
      "src": "voiceover/p4-malacca-kra/18.wav",
      "durationInSeconds": 1.898,
      "tempo": 1.1,
      "hash": "971381a4e7f6"
    },
    {
      "id": "19",
      "scene": "s7",
      "take": "t07",
      "gapAfter": 0.25,
      "text": "Người dân Chumphon, Ranong thì xuống đường phản đối, lo mất biển, mất vườn sầu riêng.",
      "voice": "Orus",
      "src": "voiceover/p4-malacca-kra/19.wav",
      "durationInSeconds": 4.977,
      "tempo": 1.1,
      "hash": "971381a4e7f6"
    },
    {
      "id": "20",
      "scene": "s8",
      "take": "t08",
      "gapAfter": 0.06,
      "text": "Nhưng lý do thật có lẽ nằm ở đây: phần lớn tàu vẫn phải ghé Singapore.",
      "voice": "Orus",
      "src": "voiceover/p4-malacca-kra/20.wav",
      "durationInSeconds": 4.551,
      "tempo": 1.1,
      "hash": "a1fa2a0d41ea"
    },
    {
      "id": "21",
      "scene": "s8",
      "take": "t08",
      "gapAfter": 0.06,
      "text": "Để giao hàng, lấy nhiên liệu, sửa chữa.",
      "voice": "Orus",
      "src": "voiceover/p4-malacca-kra/21.wav",
      "durationInSeconds": 2.432,
      "tempo": 1.1,
      "hash": "a1fa2a0d41ea"
    },
    {
      "id": "22",
      "scene": "s8",
      "take": "t08",
      "gapAfter": 0.25,
      "text": "Lối tắt có ngắn mấy, đường vẫn dẫn về Singapore.",
      "voice": "Orus",
      "src": "voiceover/p4-malacca-kra/22.wav",
      "durationInSeconds": 3.233,
      "tempo": 1.1,
      "hash": "a1fa2a0d41ea"
    }
  ]
}
