  "lines": [
    {
      "id": "01",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.06,
      "text": "Năm tỉnh Tây Nguyên vốn không có một mét bờ biển nào.",
      "voice": "Orus",
      "src": "voiceover/p1-tay-nguyen-co-bien/01.wav",
      "durationInSeconds": 2.786,
      "tempo": 1.1,
      "hash": "482349a941ec"
    },
    {
      "id": "02",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.06,
      "text": "Giờ, tỉnh nào cũng có biển.",
      "voice": "Orus",
      "src": "voiceover/p1-tay-nguyen-co-bien/02.wav",
      "durationInSeconds": 1.61,
      "tempo": 1.1,
      "hash": "482349a941ec"
    },
    {
      "id": "03",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.06,
      "text": "Sao lại thế?",
      "voice": "Orus",
      "src": "voiceover/p1-tay-nguyen-co-bien/03.wav",
      "durationInSeconds": 0.819,
      "tempo": 1.1,
      "hash": "482349a941ec"
    },
    {
      "id": "04",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.25,
      "text": "Vì gộp tỉnh.",
      "voice": "Orus",
      "src": "voiceover/p1-tay-nguyen-co-bien/04.wav",
      "durationInSeconds": 0.872,
      "tempo": 1.1,
      "hash": "482349a941ec"
    },
    {
      "id": "05",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.06,
      "text": "Giữa năm hai nghìn hai mươi lăm, Việt Nam vẽ lại bản đồ hành chính.",
      "voice": "Orus",
      "src": "voiceover/p1-tay-nguyen-co-bien/05.wav",
      "durationInSeconds": 3.241,
      "tempo": 1.1,
      "hash": "ccf808d279c2"
    },
    {
      "id": "06",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.06,
      "text": "Cả nước có sáu mươi ba tỉnh thành.",
      "voice": "Orus",
      "src": "voiceover/p1-tay-nguyen-co-bien/06.wav",
      "durationInSeconds": 1.692,
      "tempo": 1.1,
      "hash": "ccf808d279c2"
    },
    {
      "id": "07",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.25,
      "text": "Gộp lại, còn ba mươi tư.",
      "voice": "Orus",
      "src": "voiceover/p1-tay-nguyen-co-bien/07.wav",
      "durationInSeconds": 1.651,
      "tempo": 1.1,
      "hash": "ccf808d279c2"
    },
    {
      "id": "08",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.06,
      "text": "Kon Tum nhập vào Quảng Ngãi.",
      "voice": "Orus",
      "src": "voiceover/p1-tay-nguyen-co-bien/08.wav",
      "durationInSeconds": 1.594,
      "tempo": 1.1,
      "hash": "850ab67a72f6"
    },
    {
      "id": "09",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.06,
      "text": "Gia Lai cặp với Bình Định.",
      "voice": "Orus",
      "src": "voiceover/p1-tay-nguyen-co-bien/09.wav",
      "durationInSeconds": 1.442,
      "tempo": 1.1,
      "hash": "850ab67a72f6"
    },
    {
      "id": "10",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.06,
      "text": "Đắk Lắk ghép với Phú Yên.",
      "voice": "Orus",
      "src": "voiceover/p1-tay-nguyen-co-bien/10.wav",
      "durationInSeconds": 1.506,
      "tempo": 1.1,
      "hash": "850ab67a72f6"
    },
    {
      "id": "11",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.06,
      "text": "Còn Lâm Đồng nhận thêm Đắk Nông và Bình Thuận.",
      "voice": "Orus",
      "src": "voiceover/p1-tay-nguyen-co-bien/11.wav",
      "durationInSeconds": 2.576,
      "tempo": 1.1,
      "hash": "850ab67a72f6"
    },
    {
      "id": "12",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.25,
      "text": "Tỉnh nào cũng được một khúc bờ biển.",
      "voice": "Orus",
      "src": "voiceover/p1-tay-nguyen-co-bien/12.wav",
      "durationInSeconds": 1.884,
      "tempo": 1.1,
      "hash": "850ab67a72f6"
    },
    {
      "id": "13",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.06,
      "text": "Không phải tình cờ.",
      "voice": "Orus",
      "src": "voiceover/p1-tay-nguyen-co-bien/13.wav",
      "durationInSeconds": 0.902,
      "tempo": 1.1,
      "hash": "8adb71d69799"
    },
    {
      "id": "14",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.06,
      "text": "Đề án của Chính phủ ghi rõ: ưu tiên ghép tỉnh miền núi với tỉnh có biển.",
      "voice": "Orus",
      "src": "voiceover/p1-tay-nguyen-co-bien/14.wav",
      "durationInSeconds": 4.056,
      "tempo": 1.1,
      "hash": "8adb71d69799"
    },
    {
      "id": "15",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.06,
      "text": "Ông Huỳnh Thành, cựu đại biểu Quốc hội của Gia Lai, từng ví von.",
      "voice": "Orus",
      "src": "voiceover/p1-tay-nguyen-co-bien/15.wav",
      "durationInSeconds": 3.142,
      "tempo": 1.1,
      "hash": "8adb71d69799"
    },
    {
      "id": "16",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.25,
      "text": "Các tỉnh Tây Nguyên tách nhập với nhau mãi, chỉ cùng ôm nhau kêu khổ.",
      "voice": "Orus",
      "src": "voiceover/p1-tay-nguyen-co-bien/16.wav",
      "durationInSeconds": 3.187,
      "tempo": 1.1,
      "hash": "8adb71d69799"
    },
    {
      "id": "17",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 0.06,
      "text": "Bên núi có đất rộng, có nông sản.",
      "voice": "Orus",
      "src": "voiceover/p1-tay-nguyen-co-bien/17.wav",
      "durationInSeconds": 2.304,
      "tempo": 1.1,
      "hash": "4babfdb8433a"
    },
    {
      "id": "18",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 0.06,
      "text": "Bên biển có cảng.",
      "voice": "Orus",
      "src": "voiceover/p1-tay-nguyen-co-bien/18.wav",
      "durationInSeconds": 1.104,
      "tempo": 1.1,
      "hash": "4babfdb8433a"
    },
    {
      "id": "19",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 0.25,
      "text": "Như Gia Lai, giờ có cảng Quy Nhơn ngay trong tỉnh.",
      "voice": "Orus",
      "src": "voiceover/p1-tay-nguyen-co-bien/19.wav",
      "durationInSeconds": 2.481,
      "tempo": 1.1,
      "hash": "4babfdb8433a"
    },
    {
      "id": "20",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.06,
      "text": "Nhìn cả nước, trước khi gộp có ba mươi lăm tỉnh không có biển.",
      "voice": "Orus",
      "src": "voiceover/p1-tay-nguyen-co-bien/20.wav",
      "durationInSeconds": 3.718,
      "tempo": 1.1,
      "hash": "98c0c52ed1a2"
    },
    {
      "id": "21",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.25,
      "text": "Giờ chỉ còn mười ba.",
      "voice": "Orus",
      "src": "voiceover/p1-tay-nguyen-co-bien/21.wav",
      "durationInSeconds": 1.654,
      "tempo": 1.1,
      "hash": "98c0c52ed1a2"
    },
    {
      "id": "22",
      "scene": "s7",
      "take": "t07",
      "gapAfter": 0.06,
      "text": "Người ủng hộ nói, tỉnh mới có thêm không gian để lớn.",
      "voice": "Orus",
      "src": "voiceover/p1-tay-nguyen-co-bien/22.wav",
      "durationInSeconds": 2.691,
      "tempo": 1.1,
      "hash": "b8a60f688c97"
    },
    {
      "id": "23",
      "scene": "s7",
      "take": "t07",
      "gapAfter": 0.25,
      "text": "Người lo thì nhắc, tỉnh rộng ra, có xã cách trung tâm tỉnh cả trăm cây số.",
      "voice": "Orus",
      "src": "voiceover/p1-tay-nguyen-co-bien/23.wav",
      "durationInSeconds": 4.111,
      "tempo": 1.1,
      "hash": "b8a60f688c97"
    },
    {
      "id": "24",
      "scene": "s8",
      "take": "t08",
      "gapAfter": 0.06,
      "text": "Lâm Đồng giờ là tỉnh rộng nhất nước, hơn hai mươi bốn nghìn cây số vuông.",
      "voice": "Orus",
      "src": "voiceover/p1-tay-nguyen-co-bien/24.wav",
      "durationInSeconds": 3.85,
      "tempo": 1.1,
      "hash": "82d2c0230eac"
    },
    {
      "id": "25",
      "scene": "s8",
      "take": "t08",
      "gapAfter": 0.06,
      "text": "Đà Lạt với Mũi Né thành người chung tỉnh.",
      "voice": "Orus",
      "src": "voiceover/p1-tay-nguyen-co-bien/25.wav",
      "durationInSeconds": 2.384,
      "tempo": 1.1,
      "hash": "82d2c0230eac"
    },
    {
      "id": "26",
      "scene": "s8",
      "take": "t08",
      "gapAfter": 0.25,
      "text": "Sáng ngắm sương, chiều tắm biển, chưa cần ra khỏi tỉnh.",
      "voice": "Orus",
      "src": "voiceover/p1-tay-nguyen-co-bien/26.wav",
      "durationInSeconds": 3.014,
      "tempo": 1.1,
      "hash": "82d2c0230eac"
    },
    {
      "id": "27",
      "scene": "s9",
      "take": "t09",
      "gapAfter": 0.06,
      "text": "Còn Gia Lai, tỉnh của phố núi Pleiku, giờ đặt trung tâm hành chính ở Quy Nhơn.",
      "voice": "Orus",
      "src": "voiceover/p1-tay-nguyen-co-bien/27.wav",
      "durationInSeconds": 4.299,
      "tempo": 1.1,
      "hash": "bc4dca7fc202"
    },
    {
      "id": "28",
      "scene": "s9",
      "take": "t09",
      "gapAfter": 0.25,
      "text": "Tỉnh mang tên cao nguyên, giờ có thủ phủ bên bờ biển.",
