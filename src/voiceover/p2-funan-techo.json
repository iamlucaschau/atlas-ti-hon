  "totalSeconds": 62.556,
  "lines": [
    {
      "id": "01",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.06,
      "text": "Campuchia đang chi hơn một tỷ đô để đào một con kênh ra biển.",
      "voice": "Orus",
      "src": "voiceover/p2-funan-techo/01.wav",
      "durationInSeconds": 3.146,
      "tempo": 1.1,
      "hash": "192c92e52844"
    },
    {
      "id": "02",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.25,
      "text": "Nước cho con kênh ấy lấy từ một dòng sông mà người miền Tây nào cũng biết.",
      "voice": "Orus",
      "src": "voiceover/p2-funan-techo/02.wav",
      "durationInSeconds": 2.995,
      "tempo": 1.1,
      "hash": "192c92e52844"
    },
    {
      "id": "03",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.15,
      "text": "Vì sao phải đào?",
      "voice": "Orus",
      "src": "voiceover/p2-funan-techo/03.wav",
      "durationInSeconds": 0.882,
      "tempo": 1.1,
      "hash": "2601addb714f"
    },
    {
      "id": "04",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.06,
      "text": "Đường ra biển.",
      "voice": "Orus",
      "src": "voiceover/p2-funan-techo/04.wav",
      "durationInSeconds": 0.907,
      "tempo": 1.1,
      "hash": "2601addb714f"
    },
    {
      "id": "05",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.06,
      "text": "Theo chính phủ Campuchia, khoảng một phần ba hàng hoá của họ phải xuôi Mê Kông qua Việt Nam rồi mới ra biển.",
      "voice": "Orus",
      "src": "voiceover/p2-funan-techo/05.wav",
      "durationInSeconds": 5.268,
      "tempo": 1.1,
      "hash": "2601addb714f"
    },
    {
      "id": "06",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.06,
      "text": "Kênh mới dài một trăm tám mươi cây số, cắt thẳng xuống biển Kep.",
      "voice": "Orus",
      "src": "voiceover/p2-funan-techo/06.wav",
      "durationInSeconds": 3.241,
      "tempo": 1.1,
      "hash": "2601addb714f"
    },
    {
      "id": "07",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.25,
      "text": "Mục tiêu là hạ tỉ lệ ấy còn khoảng một phần mười.",
      "voice": "Orus",
      "src": "voiceover/p2-funan-techo/07.wav",
      "durationInSeconds": 2.585,
      "tempo": 1.1,
      "hash": "2601addb714f"
    },
    {
      "id": "08",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.25,
      "text": "Ngày khởi công, Thủ tướng Hun Manet tuyên bố: kênh sẽ được xây bằng mọi giá.",
      "voice": "Orus",
      "src": "voiceover/p2-funan-techo/08.wav",
      "durationInSeconds": 4.219,
      "tempo": 1.1,
      "hash": "75de3f2c5b06"
    },
    {
      "id": "09",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.06,
      "text": "Kênh bắt đầu từ sông Bassac.",
      "voice": "Orus",
      "src": "voiceover/p2-funan-techo/09.wav",
      "durationInSeconds": 1.848,
      "tempo": 1.1,
      "hash": "5669aea66565"
    },
    {
      "id": "10",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.06,
      "text": "Phía Campuchia nói kênh chỉ lấy nước sông này, và hạ lưu gần như không bị ảnh hưởng.",
      "voice": "Orus",
      "src": "voiceover/p2-funan-techo/10.wav",
      "durationInSeconds": 4.257,
      "tempo": 1.1,
      "hash": "5669aea66565"
    },
    {
      "id": "11",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.2,
      "text": "Còn chảy qua biên giới, sông Bassac đổi tên.",
      "voice": "Orus",
      "src": "voiceover/p2-funan-techo/11.wav",
      "durationInSeconds": 2.021,
      "tempo": 1.1,
      "hash": "5669aea66565"
    },
    {
      "id": "12",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.06,
      "text": "Thành sông Hậu.",
      "voice": "Orus",
      "src": "voiceover/p2-funan-techo/12.wav",
      "durationInSeconds": 1.006,
      "tempo": 1.1,
      "hash": "5669aea66565"
    },
    {
      "id": "13",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.25,
      "text": "Việt Nam vì thế đề nghị chia sẻ thông tin, đánh giá kỹ tác động lên nguồn nước miền Tây.",
      "voice": "Orus",
      "src": "voiceover/p2-funan-techo/13.wav",
      "durationInSeconds": 4.347,
      "tempo": 1.1,
      "hash": "5669aea66565"
    },
    {
      "id": "14",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 0.06,
      "text": "Tháng tư năm nay, đoạn dài nhất bắt đầu thi công.",
      "voice": "Orus",
      "src": "voiceover/p2-funan-techo/14.wav",
      "durationInSeconds": 2.259,
      "tempo": 1.1,
      "hash": "31ecf611b6c1"
    },
    {
      "id": "15",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 0.06,
      "text": "Phía Campuchia nói kênh xong khoảng năm hai nghìn hai mươi tám, hai mươi chín.",
      "voice": "Orus",
      "src": "voiceover/p2-funan-techo/15.wav",
      "durationInSeconds": 3.62,
      "tempo": 1.1,
      "hash": "31ecf611b6c1"
    },
    {
      "id": "16",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 0.25,
      "text": "Còn báo chí độc lập ghi nhận: đầu năm nay, trang tiến độ chính thức vẫn báo số không.",
      "voice": "Orus",
      "src": "voiceover/p2-funan-techo/16.wav",
      "durationInSeconds": 4.359,
      "tempo": 1.1,
      "hash": "31ecf611b6c1"
    },
    {
      "id": "17",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.15,
      "text": "Và cú ngược đời?",
      "voice": "Orus",
      "src": "voiceover/p2-funan-techo/17.wav",
      "durationInSeconds": 1.081,
      "tempo": 1.1,
      "hash": "429296b9a5c6"
    },
    {
      "id": "18",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.2,
      "text": "Độ sâu.",
      "voice": "Orus",
      "src": "voiceover/p2-funan-techo/18.wav",
      "durationInSeconds": 0.618,
      "tempo": 1.1,
      "hash": "429296b9a5c6"
    },
    {
      "id": "19",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.06,
      "text": "Kênh chỉ sâu chừng năm mét rưỡi, vừa cho sà lan và tàu nhỏ.",
      "voice": "Orus",
      "src": "voiceover/p2-funan-techo/19.wav",
      "durationInSeconds": 3.418,
      "tempo": 1.1,
      "hash": "429296b9a5c6"
    },
    {
      "id": "20",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.06,
      "text": "Còn cảng Cái Mép đón được tàu container hai trăm nghìn tấn.",
      "voice": "Orus",
      "src": "voiceover/p2-funan-techo/20.wav",
      "durationInSeconds": 3.197,
      "tempo": 1.1,
      "hash": "429296b9a5c6"
    },
    {
      "id": "21",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.06,
      "text": "Lùa tàu ấy vào kênh thì như lùa voi qua ngõ hẻm.",
      "voice": "Orus",
      "src": "voiceover/p2-funan-techo/21.wav",
      "durationInSeconds": 2.489,
      "tempo": 1.1,
      "hash": "429296b9a5c6"
    },
    {
      "id": "22",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.25,
      "text": "Nên nhiều nhà phân tích cho rằng, kênh mở thêm một cửa ra biển, nhưng chưa thay được cánh cửa cũ.",
      "voice": "Orus",
      "src": "voiceover/p2-funan-techo/22.wav",
      "durationInSeconds": 4.793,
      "tempo": 1.1,
      "hash": "429296b9a5c6"
    }
  ]
}
