  "totalSeconds": 68.967,
  "lines": [
    {
      "id": "01",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.06,
      "text": "Campuchia đang chi hơn một tỷ đô để đào một con kênh ra biển.",
      "voice": "Orus",
      "src": "voiceover/p2-funan-techo/01.wav",
      "durationInSeconds": 3.146,
      "tempo": 1.1,
      "hash": "192c92e52844"
    },
    {
      "id": "02",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.25,
      "text": "Nước cho con kênh ấy lấy từ một dòng sông mà người miền Tây nào cũng biết.",
      "voice": "Orus",
      "src": "voiceover/p2-funan-techo/02.wav",
      "durationInSeconds": 2.995,
      "tempo": 1.1,
      "hash": "192c92e52844"
    },
    {
      "id": "03",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.15,
      "text": "Vì sao phải đào?",
      "voice": "Orus",
      "src": "voiceover/p2-funan-techo/03.wav",
      "durationInSeconds": 0.91,
      "tempo": 1.1,
      "hash": "3670c1618d45"
    },
    {
      "id": "04",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.06,
      "text": "Đường ra biển.",
      "voice": "Orus",
      "src": "voiceover/p2-funan-techo/04.wav",
      "durationInSeconds": 0.725,
      "tempo": 1.1,
      "hash": "3670c1618d45"
    },
    {
      "id": "05",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.06,
      "text": "Theo chính phủ Campuchia, khoảng một phần ba hàng hoá của họ phải xuôi Mê Kông qua Việt Nam.",
      "voice": "Orus",
      "src": "voiceover/p2-funan-techo/05.wav",
      "durationInSeconds": 4.229,
      "tempo": 1.1,
      "hash": "3670c1618d45"
    },
    {
      "id": "06",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.06,
      "text": "Kênh mới dài một trăm tám mươi cây số, cắt thẳng xuống biển Kep.",
      "voice": "Orus",
      "src": "voiceover/p2-funan-techo/06.wav",
      "durationInSeconds": 3.421,
      "tempo": 1.1,
      "hash": "3670c1618d45"
    },
    {
      "id": "07",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.25,
      "text": "Mục tiêu là hạ tỉ lệ ấy còn khoảng một phần mười.",
      "voice": "Orus",
      "src": "voiceover/p2-funan-techo/07.wav",
      "durationInSeconds": 2.651,
      "tempo": 1.1,
      "hash": "3670c1618d45"
    },
    {
      "id": "08",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.25,
      "text": "Ngày khởi công, Thủ tướng Hun Manet tuyên bố: kênh sẽ được xây bằng mọi giá.",
      "voice": "Orus",
      "src": "voiceover/p2-funan-techo/08.wav",
      "durationInSeconds": 4.219,
      "tempo": 1.1,
      "hash": "75de3f2c5b06"
    },
    {
      "id": "09",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.06,
      "text": "Kênh bắt đầu từ sông Bassac.",
      "voice": "Orus",
      "src": "voiceover/p2-funan-techo/09.wav",
      "durationInSeconds": 1.526,
      "tempo": 1.1,
      "hash": "28932861c0cb"
    },
    {
      "id": "10",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.2,
      "text": "Còn chảy qua biên giới, sông Bassac đổi tên.",
      "voice": "Orus",
      "src": "voiceover/p2-funan-techo/10.wav",
      "durationInSeconds": 2.134,
      "tempo": 1.1,
      "hash": "28932861c0cb"
    },
    {
      "id": "11",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.25,
      "text": "Thành sông Hậu.",
      "voice": "Orus",
      "src": "voiceover/p2-funan-techo/11.wav",
      "durationInSeconds": 0.746,
      "tempo": 1.1,
      "hash": "28932861c0cb"
    },
    {
      "id": "12",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 0.15,
      "text": "Vậy kênh lấy bao nhiêu nước?",
      "voice": "Orus",
      "src": "voiceover/p2-funan-techo/12.wav",
      "durationInSeconds": 1.321,
      "tempo": 1.1,
      "hash": "69a7a61b63ad"
    },
    {
      "id": "13",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 0.06,
      "text": "Rất ít.",
      "voice": "Orus",
      "src": "voiceover/p2-funan-techo/13.wav",
      "durationInSeconds": 0.6,
      "tempo": 1.1,
      "hash": "69a7a61b63ad"
    },
    {
      "id": "14",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 0.06,
      "text": "Đúng thông báo, chỉ vài mét khối mỗi giây.",
      "voice": "Orus",
      "src": "voiceover/p2-funan-techo/14.wav",
      "durationInSeconds": 2.082,
      "tempo": 1.1,
      "hash": "69a7a61b63ad"
    },
    {
      "id": "15",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 0.06,
      "text": "Mùa khô, sông Hậu vẫn chảy vài trăm khối mỗi giây.",
      "voice": "Orus",
      "src": "voiceover/p2-funan-techo/15.wav",
      "durationInSeconds": 2.597,
      "tempo": 1.1,
      "hash": "69a7a61b63ad"
    },
    {
      "id": "16",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 0.25,
      "text": "Tức chưa tới hai phần trăm.",
      "voice": "Orus",
      "src": "voiceover/p2-funan-techo/16.wav",
      "durationInSeconds": 1.624,
      "tempo": 1.1,
      "hash": "69a7a61b63ad"
    },
    {
      "id": "17",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.15,
      "text": "Còn nếu vượt thông báo, lấy thêm nước tưới?",
      "voice": "Orus",
      "src": "voiceover/p2-funan-techo/17.wav",
      "durationInSeconds": 2.065,
      "tempo": 1.1,
      "hash": "57b2f52ed432"
    },
    {
      "id": "18",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.06,
      "text": "Khác hẳn.",
      "voice": "Orus",
      "src": "voiceover/p2-funan-techo/18.wav",
      "durationInSeconds": 0.725,
      "tempo": 1.1,
      "hash": "57b2f52ed432"
    },
    {
      "id": "19",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.06,
      "text": "Một chuyên gia Việt Nam tính, sông Hậu mùa khô có thể hụt năm đến mười ba phần trăm.",
      "voice": "Orus",
      "src": "voiceover/p2-funan-techo/19.wav",
      "durationInSeconds": 4.752,
      "tempo": 1.1,
      "hash": "57b2f52ed432"
    },
    {
      "id": "20",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.06,
      "text": "Phía Campuchia nói hạ lưu gần như không bị ảnh hưởng.",
      "voice": "Orus",
      "src": "voiceover/p2-funan-techo/20.wav",
      "durationInSeconds": 2.488,
      "tempo": 1.1,
      "hash": "57b2f52ed432"
    },
    {
      "id": "21",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.25,
      "text": "Phía Việt Nam đề nghị chia sẻ thông tin, đánh giá kỹ tác động.",
      "voice": "Orus",
      "src": "voiceover/p2-funan-techo/21.wav",
      "durationInSeconds": 3.125,
      "tempo": 1.1,
      "hash": "57b2f52ed432"
    },
    {
      "id": "22",
      "scene": "s7",
      "take": "t07",
      "gapAfter": 0.06,
      "text": "Campuchia hẹn kênh xong khoảng năm hai nghìn hai mươi tám, hai mươi chín.",
      "voice": "Orus",
      "src": "voiceover/p2-funan-techo/22.wav",
      "durationInSeconds": 3.368,
      "tempo": 1.1,
      "hash": "77b36a73c579"
    },
    {
      "id": "23",
      "scene": "s7",
      "take": "t07",
      "gapAfter": 0.25,
      "text": "Báo chí độc lập thì ghi: đầu năm nay, trang tiến độ chính thức vẫn báo số không.",
      "voice": "Orus",
      "src": "voiceover/p2-funan-techo/23.wav",
      "durationInSeconds": 4.095,
      "tempo": 1.1,
      "hash": "77b36a73c579"
    },
    {
      "id": "24",
      "scene": "s8",
      "take": "t08",
      "gapAfter": 0.15,
      "text": "Và cú ngược đời?",
      "voice": "Orus",
      "src": "voiceover/p2-funan-techo/24.wav",
      "durationInSeconds": 0.962,
      "tempo": 1.1,
      "hash": "df94613df4e4"
    },
    {
      "id": "25",
      "scene": "s8",
      "take": "t08",
      "gapAfter": 0.2,
      "text": "Độ sâu.",
      "voice": "Orus",
      "src": "voiceover/p2-funan-techo/25.wav",
      "durationInSeconds": 0.602,
      "tempo": 1.1,
      "hash": "df94613df4e4"
    },
    {
      "id": "26",
      "scene": "s8",
      "take": "t08",
      "gapAfter": 0.06,
      "text": "Kênh chỉ sâu chừng năm mét rưỡi, vừa cho sà lan và tàu nhỏ.",
      "voice": "Orus",
      "src": "voiceover/p2-funan-techo/26.wav",
      "durationInSeconds": 2.932,
      "tempo": 1.1,
      "hash": "df94613df4e4"
    },
    {
      "id": "27",
      "scene": "s8",
      "take": "t08",
      "gapAfter": 0.06,
      "text": "Còn cảng Cái Mép đón được tàu container hai trăm nghìn tấn.",
      "voice": "Orus",
      "src": "voiceover/p2-funan-techo/27.wav",
      "durationInSeconds": 2.484,
      "tempo": 1.1,
      "hash": "df94613df4e4"
    },
    {
      "id": "28",
      "scene": "s8",
      "take": "t08",
      "gapAfter": 0.06,
      "text": "Lùa tàu ấy vào kênh thì như lùa voi qua ngõ hẻm.",
      "voice": "Orus",
      "src": "voiceover/p2-funan-techo/28.wav",
      "durationInSeconds": 2.255,
      "tempo": 1.1,
      "hash": "df94613df4e4"
    },
    {
      "id": "29",
      "scene": "s8",
      "take": "t08",
      "gapAfter": 0.25,
      "text": "Nhiều nhà phân tích cho rằng, kênh mở thêm một cửa ra biển, nhưng chưa thay được cánh cửa cũ.",
      "voice": "Orus",
      "src": "voiceover/p2-funan-techo/29.wav",
      "durationInSeconds": 4.188,
      "tempo": 1.1,
      "hash": "df94613df4e4"
    }
  ]
