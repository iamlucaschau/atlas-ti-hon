      "src": "voiceover/p2-met-vuong-bac-ty/14.wav",
      "durationInSeconds": 3.285,
      "tempo": 1.1,
      "hash": "909574f4aa2f"
    },
    {
      "id": "15",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.15,
      "text": "Giá chốt khoảng hai phẩy bốn tỷ đồng mỗi mét vuông.",
      "voice": "Orus",
      "src": "voiceover/p2-met-vuong-bac-ty/15.wav",
      "durationInSeconds": 2.547,
      "tempo": 1.1,
      "hash": "909574f4aa2f"
    },
    {
      "id": "16",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.6,
      "text": "Nhưng đó là đất xây tháp: mỗi mét vuông đất gánh gần chín mét vuông sàn.",
      "voice": "Orus",
      "src": "voiceover/p2-met-vuong-bac-ty/16.wav",
      "durationInSeconds": 3.614,
      "tempo": 1.1,
      "hash": "909574f4aa2f"
    },
    {
      "id": "17",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 0.15,
      "text": "Cơ quan tư pháp kết luận cuộc đấu đúng quy trình.",
