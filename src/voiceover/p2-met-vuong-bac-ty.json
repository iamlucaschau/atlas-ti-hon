      "src": "voiceover/p2-met-vuong-bac-ty/19.wav",
      "durationInSeconds": 3.372,
      "tempo": 1.1,
      "hash": "428bc56570c7"
    },
    {
      "id": "20",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 0.15,
      "text": "Gần sáu trăm tỷ, cho một lần đổi ý.",
