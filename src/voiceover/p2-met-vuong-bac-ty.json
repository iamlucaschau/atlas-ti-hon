    {
      "id": "01",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.15,
      "text": "Trên giấy, mét vuông đắt nhất Hà Nội có ở phố Hàng Ngang: hơn bảy trăm triệu đồng.",
      "voice": "Orus",
      "src": "voiceover/p2-met-vuong-bac-ty/01.wav",
      "durationInSeconds": 4.476,
      "tempo": 1.1,
      "hash": "4a34eb25b138"
    },
    {
      "id": "02",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.15,
      "text": "Còn ở Thủ Thiêm, một mét vuông từng được trả giá gấp hơn ba lần.",
      "voice": "Orus",
      "src": "voiceover/p2-met-vuong-bac-ty/02.wav",
      "durationInSeconds": 3.041,
      "tempo": 1.1,
      "hash": "4a34eb25b138"
    },
    {
      "id": "03",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.15,
      "text": "Giá nào mới thật?",
      "voice": "Orus",
      "src": "voiceover/p2-met-vuong-bac-ty/03.wav",
      "durationInSeconds": 0.877,
      "tempo": 1.1,
      "hash": "4a34eb25b138"
    },
    {
      "id": "04",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.15,
      "text": "Cả hai.",
      "voice": "Orus",
      "src": "voiceover/p2-met-vuong-bac-ty/04.wav",
      "durationInSeconds": 0.571,
      "tempo": 1.1,
      "hash": "4a34eb25b138"
    },
    {
      "id": "05",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.6,
      "text": "Đất nhà bạn cũng có hai cái giá.",
      "voice": "Orus",
      "src": "voiceover/p2-met-vuong-bac-ty/05.wav",
      "durationInSeconds": 1.779,
      "tempo": 1.1,
      "hash": "4a34eb25b138"
    },
    {
      "id": "06",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.15,
      "text": "Giá thứ nhất là bảng giá do thành phố ban hành.",
      "voice": "Orus",
      "src": "voiceover/p2-met-vuong-bac-ty/06.wav",
      "durationInSeconds": 2.407,
      "tempo": 1.1,
      "hash": "29bbbdb62e54"
    },
    {
      "id": "07",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.15,
      "text": "Khi bạn làm sổ, tiền sử dụng đất tính theo giá này.",
      "voice": "Orus",
      "src": "voiceover/p2-met-vuong-bac-ty/07.wav",
      "durationInSeconds": 2.637,
      "tempo": 1.1,
      "hash": "29bbbdb62e54"
    },
    {
      "id": "08",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.6,
      "text": "Chỉ một quyết định, giá ấy ở Hàng Ngang tăng gần gấp bốn.",
      "voice": "Orus",
      "src": "voiceover/p2-met-vuong-bac-ty/08.wav",
      "durationInSeconds": 3.1,
      "tempo": 1.1,
      "hash": "29bbbdb62e54"
    },
    {
      "id": "09",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.15,
      "text": "Cũng trên phố này, có ngôi nhà số bốn mươi tám.",
      "voice": "Orus",
      "src": "voiceover/p2-met-vuong-bac-ty/09.wav",
      "durationInSeconds": 2.729,
      "tempo": 1.1,
      "hash": "5d327eba1c87"
    },
    {
      "id": "10",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.15,
      "text": "Năm một nghìn chín trăm bốn mươi lăm, gia đình ông Trịnh Văn Bô dành tầng hai cho Chủ tịch Hồ Chí Minh.",
      "voice": "Orus",
      "src": "voiceover/p2-met-vuong-bac-ty/10.wav",
      "durationInSeconds": 5.23,
      "tempo": 1.1,
      "hash": "5d327eba1c87"
    },
    {
      "id": "11",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.15,
      "text": "Người viết Tuyên ngôn Độc lập trong một căn phòng nhỏ ở đó.",
      "voice": "Orus",
      "src": "voiceover/p2-met-vuong-bac-ty/11.wav",
      "durationInSeconds": 2.485,
      "tempo": 1.1,
      "hash": "5d327eba1c87"
    },
    {
      "id": "12",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.6,
      "text": "Có những mét vuông, không bảng giá nào đo được.",
