      "durationInSeconds": 2.401,
      "tempo": 1.1,
      "hash": "428bc56570c7"
    },
    {
      "id": "18",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 0.15,
      "text": "Hiệp hội Bất động sản thành phố lại lo mức giá ấy kéo cả vùng lên.",
