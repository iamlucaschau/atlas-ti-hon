      "src": "voiceover/p2-met-vuong-bac-ty/18.wav",
      "durationInSeconds": 3.047,
      "tempo": 1.1,
      "hash": "428bc56570c7"
    },
    {
      "id": "19",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 0.15,
      "text": "Rồi doanh nghiệp trúng xin rút, mất gần sáu trăm tỷ tiền cọc.",
