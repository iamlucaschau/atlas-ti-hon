      "src": "voiceover/p2-met-vuong-bac-ty/12.wav",
      "durationInSeconds": 2.214,
      "tempo": 1.1,
      "hash": "5d327eba1c87"
    },
    {
      "id": "13",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.15,
      "text": "Giá thứ hai nằm bên kia sông Sài Gòn, trên sàn đấu.",
      "voice": "Orus",
      "src": "voiceover/p2-met-vuong-bac-ty/13.wav",
      "durationInSeconds": 2.852,
      "tempo": 1.1,
      "hash": "909574f4aa2f"
    },
    {
      "id": "14",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.15,
      "text": "Năm hai nghìn hai mươi mốt, một khu đất Thủ Thiêm được đấu giá.",
