{
  "name": "p3-dbscl-sut-lun",
  "model": "gemini-3.8-flash-tts",
  "totalSeconds": 64.018,
  "lines": [
    {
      "id": "01",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.06,
      "text": "Ai cũng lo nước biển dâng.",
      "voice": "Orus",
      "src": "voiceover/p3-dbscl-sut-lun/01.wav",
      "durationInSeconds": 1.265,
      "tempo": 1.1,
      "hash": "052edcb7f92d"
    },
    {
      "id": "02",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.25,
      "text": "Nhưng miền Tây đang tự lún xuống, còn nhanh hơn thế.",
      "voice": "Orus",
      "src": "voiceover/p3-dbscl-sut-lun/02.wav",
      "durationInSeconds": 3.216,
      "tempo": 1.1,
      "hash": "052edcb7f92d"
    },
    {
      "id": "03",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.06,
      "text": "Đồng bằng sông Cửu Long là vựa lúa lớn nhất cả nước.",
      "voice": "Orus",
      "src": "voiceover/p3-dbscl-sut-lun/03.wav",
      "durationInSeconds": 2.701,
      "tempo": 1.1,
      "hash": "a6fb1d71d695"
    },
    {
      "id": "04",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.06,
      "text": "Vậy mà trung bình, nó chỉ cao hơn mặt biển khoảng tám mươi phân.",
      "voice": "Orus",
      "src": "voiceover/p3-dbscl-sut-lun/04.wav",
      "durationInSeconds": 3.1,
      "tempo": 1.1,
      "hash": "a6fb1d71d695"
    },
    {
      "id": "05",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.25,
      "text": "Chưa tới ngang hông một người lớn.",
      "voice": "Orus",
      "src": "voiceover/p3-dbscl-sut-lun/05.wav",
      "durationInSeconds": 1.364,
      "tempo": 1.1,
      "hash": "a6fb1d71d695"
    },
    {
      "id": "06",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.06,
      "text": "Con số này có từ năm hai nghìn mười chín, khi nhà nghiên cứu Hà Lan Philip Minderhoud dùng số đo ngoài thực địa để tính lại.",
      "voice": "Orus",
      "src": "voiceover/p3-dbscl-sut-lun/06.wav",
      "durationInSeconds": 5.747,
      "tempo": 1.1,
      "hash": "df6b700dc284"
    },
    {
      "id": "07",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.06,
      "text": "Trước đó, nhiều nghiên cứu còn tưởng nó cao hơn hai mét rưỡi.",
      "voice": "Orus",
      "src": "voiceover/p3-dbscl-sut-lun/07.wav",
      "durationInSeconds": 2.997,
      "tempo": 1.1,
      "hash": "df6b700dc284"
    },
    {
      "id": "08",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.15,
      "text": "Sai ở đâu?",
      "voice": "Orus",
      "src": "voiceover/p3-dbscl-sut-lun/08.wav",
      "durationInSeconds": 0.589,
      "tempo": 1.1,
      "hash": "df6b700dc284"
    },
    {
      "id": "09",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.15,
      "text": "Ở cái thước.",
      "voice": "Orus",
      "src": "voiceover/p3-dbscl-sut-lun/09.wav",
      "durationInSeconds": 0.808,
      "tempo": 1.1,
      "hash": "df6b700dc284"
    },
    {
      "id": "10",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.25,
      "text": "Bản đồ vệ tinh lấy mốc không khớp với mặt biển ở đây.",
      "voice": "Orus",
      "src": "voiceover/p3-dbscl-sut-lun/10.wav",
      "durationInSeconds": 2.223,
      "tempo": 1.1,
      "hash": "df6b700dc284"
    },
    {
      "id": "11",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.06,
      "text": "Giờ so hai tốc độ.",
      "voice": "Orus",
      "src": "voiceover/p3-dbscl-sut-lun/11.wav",
      "durationInSeconds": 1.084,
      "tempo": 1.1,
      "hash": "cc6e7f280a84"
    },
    {
      "id": "12",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.06,
      "text": "Nước biển toàn cầu dâng chưa tới bốn li mỗi năm.",
      "voice": "Orus",
      "src": "voiceover/p3-dbscl-sut-lun/12.wav",
      "durationInSeconds": 2.773,
      "tempo": 1.1,
      "hash": "cc6e7f280a84"
    },
    {
      "id": "13",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.06,
      "text": "Đất miền Tây lún khoảng một phân mỗi năm.",
      "voice": "Orus",
      "src": "voiceover/p3-dbscl-sut-lun/13.wav",
      "durationInSeconds": 2.283,
      "tempo": 1.1,
      "hash": "cc6e7f280a84"
    },
    {
      "id": "14",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.06,
      "text": "Có nơi hơn hai phân rưỡi.",
      "voice": "Orus",
      "src": "voiceover/p3-dbscl-sut-lun/14.wav",
      "durationInSeconds": 1.411,
      "tempo": 1.1,
      "hash": "cc6e7f280a84"
    },
    {
      "id": "15",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.06,
      "text": "Nhanh gấp khoảng ba lần.",
      "voice": "Orus",
      "src": "voiceover/p3-dbscl-sut-lun/15.wav",
      "durationInSeconds": 1.108,
      "tempo": 1.1,
      "hash": "cc6e7f280a84"
    },
    {
      "id": "16",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.25,
      "text": "Nước biển còn chưa kịp tới, đất đã tự xuống đón.",
      "voice": "Orus",
      "src": "voiceover/p3-dbscl-sut-lun/16.wav",
      "durationInSeconds": 2.831,
      "tempo": 1.1,
      "hash": "cc6e7f280a84"
    },
    {
      "id": "17",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 0.06,
      "text": "Thủ phạm số một nằm ngay dưới chân: nước ngầm.",
      "voice": "Orus",
      "src": "voiceover/p3-dbscl-sut-lun/17.wav",
      "durationInSeconds": 2.862,
      "tempo": 1.1,
      "hash": "8371d9f37ecd"
    },
    {
      "id": "18",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 0.06,
      "text": "Bơm nước lên, các lớp đất bên dưới xẹp xuống.",
      "voice": "Orus",
      "src": "voiceover/p3-dbscl-sut-lun/18.wav",
      "durationInSeconds": 2.433,
      "tempo": 1.1,
      "hash": "8371d9f37ecd"
    },
    {
      "id": "19",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 0.25,
      "text": "Riêng chuyện này đã kéo đồng bằng xuống khoảng mười tám phân.",
      "voice": "Orus",
      "src": "voiceover/p3-dbscl-sut-lun/19.wav",
      "durationInSeconds": 3.166,
      "tempo": 1.1,
      "hash": "8371d9f37ecd"
    },
    {
      "id": "20",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.06,
      "text": "Thủ phạm số hai: phù sa.",
      "voice": "Orus",
      "src": "voiceover/p3-dbscl-sut-lun/20.wav",
      "durationInSeconds": 1.623,
      "tempo": 1.1,
      "hash": "4297078c7a87"
    },
    {
      "id": "21",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.06,
      "text": "Đập trên dòng Mekong giữ lại một phần, cát dưới lòng sông thì bị hút đi.",
      "voice": "Orus",
      "src": "voiceover/p3-dbscl-sut-lun/21.wav",
      "durationInSeconds": 3.591,
      "tempo": 1.1,
      "hash": "4297078c7a87"
    },
    {
      "id": "22",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.25,
      "text": "Phù sa về đồng bằng đã giảm khoảng một nửa.",
      "voice": "Orus",
      "src": "voiceover/p3-dbscl-sut-lun/22.wav",
      "durationInSeconds": 2.034,
      "tempo": 1.1,
      "hash": "4297078c7a87"
    },
    {
      "id": "23",
      "scene": "s7",
      "take": "t07",
      "gapAfter": 0.06,
      "text": "Đồng bằng càng thấp, nước mặn càng dễ lấn vào.",
      "voice": "Orus",
      "src": "voiceover/p3-dbscl-sut-lun/23.wav",
      "durationInSeconds": 2.541,
      "tempo": 1.1,
      "hash": "e4f3722b0713"
    },
    {
      "id": "24",
      "scene": "s7",
      "take": "t07",
      "gapAfter": 0.25,
      "text": "Mùa khô năm hai nghìn hai mươi là một đợt hạn mặn lịch sử.",
      "voice": "Orus",
      "src": "voiceover/p3-dbscl-sut-lun/24.wav",
      "durationInSeconds": 3.373,
      "tempo": 1.1,
      "hash": "e4f3722b0713"
    },
    {
      "id": "25",
      "scene": "s8",
      "take": "t08",
      "gapAfter": 0.2,
      "text": "Và cú ngược đời?",
      "voice": "Orus",
      "src": "voiceover/p3-dbscl-sut-lun/25.wav",
      "durationInSeconds": 1.058,
      "tempo": 1.1,
      "hash": "c1a8dcea9d04"
    },
    {
      "id": "26",
      "scene": "s8",
      "take": "t08",
      "gapAfter": 0.25,
      "text": "Thứ kéo đồng bằng xuống nhiều nhất lại là nước ngọt ngay dưới chân, để uống, tưới ruộng, nuôi tôm cá.",
      "voice": "Orus",
      "src": "voiceover/p3-dbscl-sut-lun/26.wav",
      "durationInSeconds": 5.837,
      "tempo": 1.1,
      "hash": "c1a8dcea9d04"
    }
  ]
}
