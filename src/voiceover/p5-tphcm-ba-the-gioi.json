    {
      "id": "01",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.06,
      "text": "Nhiều người nghĩ TP.HCM chỉ có kẹt xe.",
      "voice": "Orus",
      "src": "voiceover/p5-tphcm-ba-the-gioi/01.wav",
      "durationInSeconds": 2.372,
      "tempo": 1.1,
      "hash": "77c874e2991e"
    },
    {
      "id": "02",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.06,
      "text": "Thật ra, giờ nó là ba thế giới.",
      "voice": "Orus",
      "src": "voiceover/p5-tphcm-ba-the-gioi/02.wav",
      "durationInSeconds": 2.559,
      "tempo": 1.1,
      "hash": "77c874e2991e"
    },
    {
      "id": "03",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.25,
      "text": "Từ tháng bảy năm hai nghìn hai mươi lăm, Sài Gòn, Bình Dương và Bà Rịa Vũng Tàu nhập làm một.",
      "voice": "Orus",
      "src": "voiceover/p5-tphcm-ba-the-gioi/03.wav",
      "durationInSeconds": 5.085,
      "tempo": 1.1,
      "hash": "77c874e2991e"
    },
    {
      "id": "04",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.06,
      "text": "Thế giới thứ nhất?",
      "voice": "Orus",
      "src": "voiceover/p5-tphcm-ba-the-gioi/04.wav",
      "durationInSeconds": 0.933,
      "tempo": 1.1,
      "hash": "231a5fcb435c"
    },
    {
      "id": "05",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.06,
      "text": "Sài Gòn.",
      "voice": "Orus",
      "src": "voiceover/p5-tphcm-ba-the-gioi/05.wav",
      "durationInSeconds": 0.762,
      "tempo": 1.1,
      "hash": "231a5fcb435c"
    },
    {
      "id": "06",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.06,
      "text": "Năm một nghìn sáu trăm chín mươi tám, Nguyễn Hữu Cảnh vào Nam lập phủ Gia Định, dựng dinh ở vùng đất này.",
      "voice": "Orus",
      "src": "voiceover/p5-tphcm-ba-the-gioi/06.wav",
      "durationInSeconds": 5.652,
      "tempo": 1.1,
      "hash": "231a5fcb435c"
    },
    {
      "id": "07",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.12,
      "text": "Giờ đây, nơi này là phố xá, cà phê và xe máy.",
      "voice": "Orus",
      "src": "voiceover/p5-tphcm-ba-the-gioi/07.wav",
      "durationInSeconds": 3.679,
      "tempo": 1.1,
      "hash": "231a5fcb435c"
    },
    {
      "id": "08",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.25,
      "who": "saigon",
      "text": "Kẹt xe chút xíu thôi mà, ráng chút là tới à!",
      "voice": "Leda",
      "src": "voiceover/p5-tphcm-ba-the-gioi/08.wav",
      "durationInSeconds": 2.977,
      "tempo": 1.1,
      "hash": "9b1cff46e114"
    },
    {
      "id": "09",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.06,
      "text": "Chạy lên phía bắc, thế giới thứ hai: Bình Dương.",
      "voice": "Orus",
      "src": "voiceover/p5-tphcm-ba-the-gioi/09.wav",
      "durationInSeconds": 2.893,
      "tempo": 1.1,
      "hash": "f43f46ad1ee8"
    },
    {
      "id": "10",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.06,
      "text": "Gần ba mươi khu công nghiệp nối nhau.",
      "voice": "Orus",
      "src": "voiceover/p5-tphcm-ba-the-gioi/10.wav",
      "durationInSeconds": 1.71,
      "tempo": 1.1,
      "hash": "f43f46ad1ee8"
    },
    {
      "id": "11",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.12,
      "text": "Hơn một nửa người dân ở đây từ nơi khác tới.",
      "voice": "Orus",
      "src": "voiceover/p5-tphcm-ba-the-gioi/11.wav",
      "durationInSeconds": 2.352,
      "tempo": 1.1,
      "hash": "f43f46ad1ee8"
    },
    {
      "id": "12",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.25,
      "who": "binhduong",
      "text": "Em quê ngoài Bắc, vào đây làm công nhân, giờ thành người Bình Dương luôn rồi!",
      "voice": "Aoede",
      "src": "voiceover/p5-tphcm-ba-the-gioi/12.wav",
      "durationInSeconds": 4.079,
      "tempo": 1.1,
      "hash": "a482d98b6a08"
    },
    {
      "id": "13",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.06,
      "text": "Xuôi xuống biển, thế giới thứ ba: Bà Rịa Vũng Tàu.",
      "voice": "Orus",
      "src": "voiceover/p5-tphcm-ba-the-gioi/13.wav",
      "durationInSeconds": 3.288,
      "tempo": 1.1,
      "hash": "1dcb0cb4c7d0"
    },
    {
      "id": "14",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.12,
      "text": "Từ năm một nghìn chín trăm tám mươi sáu, dầu được hút lên từ mỏ Bạch Hổ, mỏ dầu lớn nhất nước.",
      "voice": "Orus",
      "src": "voiceover/p5-tphcm-ba-the-gioi/14.wav",
      "durationInSeconds": 5.307,
      "tempo": 1.1,
      "hash": "1dcb0cb4c7d0"
    },
    {
      "id": "15",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.25,
      "who": "vungtau",
      "text": "Mệt thì xuống đây hóng gió, biển mát, hải sản tươi nè!",
      "voice": "Puck",
      "src": "voiceover/p5-tphcm-ba-the-gioi/15.wav",
      "durationInSeconds": 3.228,
      "tempo": 1.1,
      "hash": "f915b42184c6"
    },
    {
      "id": "16",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 0.06,
      "text": "Gộp lại, thành phố mới có hơn mười bốn triệu dân.",
      "voice": "Orus",
      "src": "voiceover/p5-tphcm-ba-the-gioi/16.wav",
      "durationInSeconds": 2.993,
      "tempo": 1.1,
      "hash": "c50db195bfb8"
    },
    {
      "id": "17",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 0.25,
      "text": "Và làm ra gần một phần tư nền kinh tế cả nước.",
      "voice": "Orus",
      "src": "voiceover/p5-tphcm-ba-the-gioi/17.wav",
      "durationInSeconds": 2.494,
      "tempo": 1.1,
      "hash": "c50db195bfb8"
    },
    {
      "id": "18",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.06,
      "text": "Trớ trêu là, thành phố đông dân nhất nước lại có một hòn đảo mới có điện lưới.",
      "voice": "Orus",
      "src": "voiceover/p5-tphcm-ba-the-gioi/18.wav",
      "durationInSeconds": 4.036,
      "tempo": 1.1,
      "hash": "f9206e0e2299"
    },
    {
      "id": "19",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.06,
      "text": "Đặc khu Côn Đảo, cách Vũng Tàu gần hai trăm cây số.",
      "voice": "Orus",
      "src": "voiceover/p5-tphcm-ba-the-gioi/19.wav",
      "durationInSeconds": 2.651,
      "tempo": 1.1,
      "hash": "f9206e0e2299"
    },
    {
      "id": "20",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.06,
      "text": "Phải đến tháng chín năm hai nghìn hai mươi lăm, điện lưới quốc gia mới ra tới đảo.",
      "voice": "Orus",
      "src": "voiceover/p5-tphcm-ba-the-gioi/20.wav",
      "durationInSeconds": 3.784,
      "tempo": 1.1,
      "hash": "f9206e0e2299"
    },
    {
      "id": "21",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.06,
      "text": "Bằng một đường cáp ngầm gần tám mươi cây số dưới biển.",
      "voice": "Orus",
      "src": "voiceover/p5-tphcm-ba-the-gioi/21.wav",
      "durationInSeconds": 2.334,
      "tempo": 1.1,
      "hash": "f9206e0e2299"
    },
    {
      "id": "22",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.25,
      "text": "Ba thế giới trên đất liền, một hòn đảo ngoài khơi, giờ chung một cái tên.",
      "voice": "Orus",
      "src": "voiceover/p5-tphcm-ba-the-gioi/22.wav",
      "durationInSeconds": 3.334,
      "tempo": 1.1,
      "hash": "f9206e0e2299"
    }
  ]
