{
  "name": "p3-bach-ma",
  "model": "gemini-3.8-flash-tts",
  "totalSeconds": 66.628,
  "lines": [
    {
      "id": "01",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.06,
      "text": "Tháng lạnh nhất, Hà Nội trung bình chỉ khoảng mười sáu độ.",
      "voice": "Orus",
      "src": "voiceover/p3-bach-ma/01.wav",
      "durationInSeconds": 3.043,
      "tempo": 1.1,
      "hash": "5757ae556635"
    },
    {
      "id": "02",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.06,
      "text": "Sài Gòn vẫn hơn hai mươi lăm độ.",
      "voice": "Orus",
      "src": "voiceover/p3-bach-ma/02.wav",
      "durationInSeconds": 1.941,
      "tempo": 1.1,
      "hash": "5757ae556635"
    },
    {
      "id": "03",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.06,
      "text": "Thủ phạm là một dãy núi.",
      "voice": "Orus",
      "src": "voiceover/p3-bach-ma/03.wav",
      "durationInSeconds": 1.492,
      "tempo": 1.1,
      "hash": "5757ae556635"
    },
    {
      "id": "04",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.06,
      "text": "Dãy nào?",
      "voice": "Orus",
      "src": "voiceover/p3-bach-ma/04.wav",
      "durationInSeconds": 0.595,
      "tempo": 1.1,
      "hash": "5757ae556635"
    },
    {
      "id": "05",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.25,
      "text": "Bạch Mã.",
      "voice": "Orus",
      "src": "voiceover/p3-bach-ma/05.wav",
      "durationInSeconds": 0.701,
      "tempo": 1.1,
      "hash": "5757ae556635"
    },
    {
      "id": "06",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.06,
      "text": "Bạch Mã là nhánh núi chạy ngang ra sát biển, giữa Huế và Đà Nẵng.",
      "voice": "Orus",
      "src": "voiceover/p3-bach-ma/06.wav",
      "durationInSeconds": 3.535,
      "tempo": 1.1,
      "hash": "134d6dfc74b1"
    },
    {
      "id": "07",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.06,
      "text": "Năm một nghìn tám trăm hai mươi sáu, vua Minh Mạng cho xây một cửa ải trên đỉnh đèo Hải Vân, ngay đầu dãy núi.",
      "voice": "Orus",
      "src": "voiceover/p3-bach-ma/07.wav",
      "durationInSeconds": 5.693,
      "tempo": 1.1,
      "hash": "134d6dfc74b1"
    },
    {
      "id": "08",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.06,
      "text": "Cửa ải canh đường Bắc Nam.",
      "voice": "Orus",
      "src": "voiceover/p3-bach-ma/08.wav",
      "durationInSeconds": 1.541,
      "tempo": 1.1,
      "hash": "134d6dfc74b1"
    },
    {
      "id": "09",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.25,
      "text": "Còn dãy núi thì canh cả gió.",
      "voice": "Orus",
      "src": "voiceover/p3-bach-ma/09.wav",
      "durationInSeconds": 2.166,
      "tempo": 1.1,
      "hash": "134d6dfc74b1"
    },
    {
      "id": "10",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.06,
      "text": "Mùa đông, gió mùa đông bắc từ phương Bắc tràn xuống.",
      "voice": "Orus",
      "src": "voiceover/p3-bach-ma/10.wav",
      "durationInSeconds": 2.742,
      "tempo": 1.1,
      "hash": "1a76a2bd0eb6"
    },
    {
      "id": "11",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.06,
      "text": "Càng đi về phía nam, gió càng yếu và bớt lạnh.",
      "voice": "Orus",
      "src": "voiceover/p3-bach-ma/11.wav",
      "durationInSeconds": 2.783,
      "tempo": 1.1,
      "hash": "1a76a2bd0eb6"
    },
    {
      "id": "12",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.25,
      "text": "Tới Bạch Mã, nó gần như dừng lại.",
      "voice": "Orus",
      "src": "voiceover/p3-bach-ma/12.wav",
      "durationInSeconds": 2.037,
      "tempo": 1.1,
      "hash": "1a76a2bd0eb6"
    },
    {
      "id": "13",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.06,
      "text": "Vì thế phía bắc có mùa đông lạnh hai, ba tháng.",
      "voice": "Orus",
      "src": "voiceover/p3-bach-ma/13.wav",
      "durationInSeconds": 2.474,
      "tempo": 1.1,
      "hash": "4358953bc0fb"
    },
    {
      "id": "14",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.06,
      "text": "Phía nam chỉ có hai mùa: mưa và khô.",
      "voice": "Orus",
      "src": "voiceover/p3-bach-ma/14.wav",
      "durationInSeconds": 2.604,
      "tempo": 1.1,
      "hash": "4358953bc0fb"
    },
    {
      "id": "15",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.25,
      "text": "Người Hà Nội đã lôi áo phao ra, người Sài Gòn vẫn áo thun.",
      "voice": "Orus",
      "src": "voiceover/p3-bach-ma/15.wav",
      "durationInSeconds": 3.62,
      "tempo": 1.1,
      "hash": "4358953bc0fb"
    },
    {
      "id": "16",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 0.06,
      "text": "Nhưng gió mùa đông bắc không chỉ mang rét.",
      "voice": "Orus",
      "src": "voiceover/p3-bach-ma/16.wav",
      "durationInSeconds": 1.717,
      "tempo": 1.1,
      "hash": "fe386bd8a660"
    },
    {
      "id": "17",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 0.06,
      "text": "Gió ẩm từ biển thổi vào, gặp núi sát bờ, cùng với bão và không khí lạnh, mưa trút xuống miền Trung.",
      "voice": "Orus",
      "src": "voiceover/p3-bach-ma/17.wav",
      "durationInSeconds": 5.621,
      "tempo": 1.1,
      "hash": "fe386bd8a660"
    },
    {
      "id": "18",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 0.25,
      "text": "Mùa mưa ở đây đến muộn, từ tháng tám tới tháng mười hai.",
      "voice": "Orus",
      "src": "voiceover/p3-bach-ma/18.wav",
      "durationInSeconds": 3.114,
      "tempo": 1.1,
      "hash": "fe386bd8a660"
    },
    {
      "id": "19",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.06,
      "text": "Riêng tháng mười, Huế mưa gần tám trăm li.",
      "voice": "Orus",
      "src": "voiceover/p3-bach-ma/19.wav",
      "durationInSeconds": 2.851,
      "tempo": 1.1,
      "hash": "9b852ee4f4da"
    },
    {
      "id": "20",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.06,
      "text": "Gần bằng nửa lượng mưa cả năm của Hà Nội.",
      "voice": "Orus",
      "src": "voiceover/p3-bach-ma/20.wav",
      "durationInSeconds": 2.03,
      "tempo": 1.1,
      "hash": "9b852ee4f4da"
    },
    {
      "id": "21",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.06,
      "text": "Ở Huế, áo mưa mới là áo khoác mùa đông.",
      "voice": "Orus",
      "src": "voiceover/p3-bach-ma/21.wav",
      "durationInSeconds": 2.968,
      "tempo": 1.1,
      "hash": "9b852ee4f4da"
    },
    {
      "id": "22",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.25,
      "text": "Cùng lúc ấy, Sài Gòn đã vào mùa khô.",
      "voice": "Orus",
      "src": "voiceover/p3-bach-ma/22.wav",
      "durationInSeconds": 2.186,
      "tempo": 1.1,
      "hash": "9b852ee4f4da"
    },
    {
      "id": "23",
      "scene": "s7",
      "take": "t07",
      "gapAfter": 0.06,
      "text": "Mà nơi được coi là mưa nhiều nhất nước, lại chính là đỉnh Bạch Mã, mỗi năm gần mười nghìn li.",
      "voice": "Orus",
      "src": "voiceover/p3-bach-ma/23.wav",
      "durationInSeconds": 5.565,
      "tempo": 1.1,
      "hash": "6da1f7a3fad6"
    },
    {
      "id": "24",
      "scene": "s7",
      "take": "t07",
      "gapAfter": 0.25,
      "text": "Một bức tường, chặn rét cho miền Nam, và hứng mưa nhiều nhất nước.",
      "voice": "Orus",
      "src": "voiceover/p3-bach-ma/24.wav",
      "durationInSeconds": 3.609,
      "tempo": 1.1,
      "hash": "6da1f7a3fad6"
    }
  ]
}
